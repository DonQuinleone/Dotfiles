#!/usr/bin/env bash

set -euo pipefail

readonly BLOCK_STATUS=2
readonly MAX_SUBJECT_LENGTH=72
readonly STDIN_TARGET=-
readonly UNSIGNED_FLAG=--no-gpg-sign
readonly COMMIT_PATTERN='git[[:space:]]+commit'
readonly FORBIDDEN_TRAILERS='co-authored-by:|generated-by|assisted-by'
readonly STDIN_MESSAGE_PATTERN=\
'commit[^|;&]*(-F|--file[= ])[[:space:]]*-([[:space:]]|$)'
readonly HEREDOC_START_PATTERN=$'<<-?[[:space:]]*[\'"]?([[:alnum:]_]+)'

readonly COMMIT_TYPES=(
  feat fix docs style refactor perf test build ci chore revert
  packaging
)
readonly SUBJECT_SCOPE='(\([a-z0-9./-]+\))?!?'
readonly SUBJECT_BODY=': [^A-Z].+$'

readonly FLAG_BOUNDARY='(^|[[:space:]])'
readonly FLAG_SEPARATOR='[[:space:]]*=?[[:space:]]*'
readonly FLAG_VALUE=$'("([^"]*)"|\'([^\']*)\'|([^[:space:]]+))'
readonly INLINE_MESSAGE_FLAG='(--message|-[[:alpha:]]*m)'
readonly MESSAGE_FILE_FLAG='(--file|-F)'
readonly INLINE_MESSAGE_PATTERN="$FLAG_BOUNDARY$INLINE_MESSAGE_FLAG\
$FLAG_SEPARATOR$FLAG_VALUE"
readonly MESSAGE_FILE_PATTERN="$FLAG_BOUNDARY$MESSAGE_FILE_FLAG\
$FLAG_SEPARATOR$FLAG_VALUE"

subject_pattern() {
  local types
  types=$(IFS='|'; printf '%s' "${COMMIT_TYPES[*]}")
  printf '^(%s)%s%s' "$types" "$SUBJECT_SCOPE" "$SUBJECT_BODY"
}

SUBJECT_PATTERN=$(subject_pattern)
readonly SUBJECT_PATTERN

readonly COMMIT_CHECKS=(
  check_subject_convention
  check_subject_length
  check_forbidden_trailers
)

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly root
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/hook-input.sh
source "$root/lib/hook-input.sh"

reject() {
  printf 'commit-gate: %s\n' "$1" >&2
}

matched_flag_value() {
  printf '%s' \
    "${BASH_REMATCH[4]-}${BASH_REMATCH[5]-}${BASH_REMATCH[6]-}"
}

extract_inline_messages() {
  local text=$1
  local -a messages=()
  while [[ $text =~ $INLINE_MESSAGE_PATTERN ]]; do
    messages+=("$(matched_flag_value)")
    text=${text#*"${BASH_REMATCH[0]}"}
  done
  if (( ${#messages[@]} == 0 )); then
    return 0
  fi
  printf '%s\n' "${messages[@]}"
}

extract_heredoc_body() {
  local -r command=$1
  local line delimiter=""
  while IFS= read -r line; do
    if [[ -z $delimiter ]]; then
      if [[ $line =~ $HEREDOC_START_PATTERN ]]; then
        delimiter=${BASH_REMATCH[1]}
      fi
      continue
    fi
    if [[ $line == "$delimiter" ]]; then
      break
    fi
    printf '%s\n' "$line"
  done <<<"$command"
}

extract_file_message() {
  local -r command=$1
  if [[ ! $command =~ $MESSAGE_FILE_PATTERN ]]; then
    return 0
  fi
  local target
  target=$(matched_flag_value)
  if [[ $target == "$STDIN_TARGET" ]]; then
    extract_heredoc_body "$command"
    return 0
  fi
  if [[ -f $target ]]; then
    cat -- "$target"
  fi
}

extract_message() {
  local -r command=$1
  local message
  message=$(extract_inline_messages "$command")
  if [[ -n $message ]]; then
    printf '%s' "$message"
    return 0
  fi
  message=$(extract_file_message "$command")
  if [[ -n $message ]]; then
    printf '%s' "$message"
    return 0
  fi
  if [[ $command =~ $STDIN_MESSAGE_PATTERN ]]; then
    extract_heredoc_body "$command"
  fi
}

check_subject_convention() {
  local -r subject=$1
  if [[ $subject =~ $SUBJECT_PATTERN ]]; then
    return 0
  fi
  reject "subject is not Conventional Commits: $subject"
  return 1
}

check_subject_length() {
  local -r subject=$1
  if (( ${#subject} <= MAX_SUBJECT_LENGTH )); then
    return 0
  fi
  reject "subject is ${#subject} chars: wrap at $MAX_SUBJECT_LENGTH"
  return 1
}

check_forbidden_trailers() {
  local -r message=$2
  if ! grep -qiE "$FORBIDDEN_TRAILERS" <<<"$message"; then
    return 0
  fi
  reject 'message carries an assistant attribution trailer'
  return 1
}

check_signing() {
  local -r command=$1
  if [[ $command != *"$UNSIGNED_FLAG"* ]]; then
    return 0
  fi
  reject "commits must be signed: drop $UNSIGNED_FLAG"
  return 1
}

run_message_checks() {
  local -r subject=$1 message=$2
  local check failures=0
  for check in "${COMMIT_CHECKS[@]}"; do
    if ! "$check" "$subject" "$message"; then
      failures=$((failures + 1))
    fi
  done
  return "$failures"
}

main() {
  local payload command message subject failures=0
  payload=$(cat)
  command=$(hook_field "$payload" '.tool_input.command')
  if [[ ! $command =~ $COMMIT_PATTERN ]]; then
    exit 0
  fi
  check_signing "$command" || failures=$((failures + 1))
  message=$(extract_message "$command")
  subject=${message%%$'\n'*}
  if [[ -n $message ]]; then
    run_message_checks "$subject" "$message" ||
      failures=$((failures + $?))
  fi
  if (( failures > 0 )); then
    exit "$BLOCK_STATUS"
  fi
}

main
