#!/usr/bin/env bash
# donbox:summary=Print a default application or window class
# donbox:args=<terminal|browser|editor|files|class ROLE>
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly CONFIG_HOME
APPS_FILE="${DONBOX_APPS_FILE:-${CONFIG_HOME}/donbox/apps.lua}"
readonly APPS_FILE

readonly READER='
    local path = os.getenv("DONBOX_APPS_FILE")
    local key = os.getenv("DONBOX_APPS_KEY")
    local role = os.getenv("DONBOX_APPS_ROLE")
    local read, apps = pcall(dofile, path)
    if not read or type(apps) ~= "table" then os.exit(1) end
    local found = apps[key]
    if role ~= "" then found = (apps.classes or {})[role] end
    if type(found) ~= "string" or found == "" then os.exit(1) end
    io.write(found, "\n")
'

die() {
    printf 'donbox app: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'usage: donbox app <terminal|browser|editor|files>\n' >&2
    printf '       donbox app class <role>\n' >&2
}

read_value() {
    local key="$1" role="$2"
    command -v luajit >/dev/null 2>&1 ||
        die "luajit is not installed but is required"
    [[ -r "${APPS_FILE}" ]] || die "cannot read ${APPS_FILE}"
    DONBOX_APPS_FILE="${APPS_FILE}" \
    DONBOX_APPS_KEY="${key}" \
    DONBOX_APPS_ROLE="${role}" \
        luajit -e "${READER}"
}

main() {
    case "${1-}" in
        class)
            [[ $# -eq 2 ]] || { usage; exit 1; }
            read_value "" "$2" ||
                die "no class is named for '$2'"
            ;;
        terminal | browser | editor | files)
            [[ $# -eq 1 ]] || { usage; exit 1; }
            read_value "$1" "" ||
                die "no application is named for '$1'"
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

main "$@"
