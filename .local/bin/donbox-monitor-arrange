#!/usr/bin/env bash
# donbox:summary=Drag the monitors into place and keep the layout
# donbox:args=[profile]
set -euo pipefail

BIN_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly BIN_DIR
readonly ARRANGER=nwg-displays
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/hypr"
readonly STATE_DIR
readonly ARRANGING_FLAG="${STATE_DIR}/arranging"
readonly OUTPUTS_FILE="${STATE_DIR}/nwg-monitors.conf"
readonly WORKSPACES_FILE="${STATE_DIR}/nwg-workspaces.conf"

die() {
    printf 'donbox monitor arrange: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'usage: donbox monitor arrange [profile]\n' >&2
    exit 1
}

ask_for_name() {
    local name
    profile list >&2
    read -r -p "Save the layout as which profile? " name
    printf '%s' "${name}"
}

profile() {
    "${BIN_DIR}/donbox-monitor-profile" "$@"
}

release() {
    rm -f "${ARRANGING_FLAG}"
}

main() {
    (($# <= 1)) || usage
    command -v "${ARRANGER}" >/dev/null 2>&1 ||
        die "${ARRANGER} is not installed"

    local name="${1-}"
    [[ -n "${name}" || -t 0 ]] ||
        die "no profile name given, and nothing to ask on"

    mkdir -p "${STATE_DIR}"

    # Applying a layout reloads the compositor, and the reload
    # would lay the saved profile straight back over it.
    : >"${ARRANGING_FLAG}"
    trap release EXIT

    # Both paths are given: either default is a file written
    # into ~/.config/hypr, which stow folded into the repo.
    "${ARRANGER}" --monitors_path "${OUTPUTS_FILE}" \
        --workspaces_path "${WORKSPACES_FILE}"

    release
    trap - EXIT

    [[ -n "${name}" ]] || name=$(ask_for_name)
    [[ -n "${name}" ]] || die "no profile name given"

    profile save "${name}"
    profile detect
}

main "$@"
