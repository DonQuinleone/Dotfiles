#!/usr/bin/env bash
set -euo pipefail

CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
THEME=$CONFIG/hypr/scripts/theme
THEMES=$CONFIG/quickshell/themes
SETTLE_SECONDS=1

# A session restart runs autostart again while the previous
# daemons are still alive, so the lock keeps one of each.
exec 9>"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/theme-daemon.lock"
flock -n 9 || exit 0

die() {
    printf 'theme-daemon: %s\n' "$1" >&2
    exit 1
}

[ -x "$THEME" ] || die "$THEME is not executable"
command -v inotifywait >/dev/null 2>&1 ||
    die "inotify-tools is not installed"

reapply() {
    local slug
    slug=$("$THEME" current 2>/dev/null) || return 0
    [ -n "$slug" ] || return 0
    "$THEME" set "$slug" >/dev/null 2>&1 || true
}

# Everything generated from a palette (terminal, GTK, Qt, the
# browsers) can drift while the session is away, so the theme is
# laid down once at login before anything is watched.
reapply

# current.json is written by the theme run itself, so watching it
# would loop.
inotifywait --quiet --monitor --event close_write,moved_to \
    --format '%f' "$THEMES" |
    while read -r changed; do
        case "$changed" in
        current.json | *.swp | *~) continue ;;
        *.json) ;;
        *) continue ;;
        esac
        sleep "$SETTLE_SECONDS"
        reapply
    done
