[include]
	path = private.inc
[commit]
	gpgSign = true
[tag]
	gpgSign = true
[gpg]
	program = gpg
[core]
	editor = nvim
[init]
	defaultBranch = master
[push]
	autoSetupRemote = true

[includeIf "gitdir:~/.dotfiles/"]
	path = personal.inc
[includeIf "gitdir:~/.dotfiles-priv/"]
	path = personal.inc
[includeIf "gitdir:~/repos/personal/"]
	path = personal.inc
[alias]
	gone = !git branch -vv | awk \"/: gone]/{print \\$1}\" | xargs git branch -d
