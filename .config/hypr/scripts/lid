#!/usr/bin/env bash
set -euo pipefail

ACTION=${1:-}
PANEL=eDP-1
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/hypr"
INHIBITOR_PID_FILE="${STATE_DIR}/lid-inhibitor.pid"
INHIBITOR_WHO="hypr-lid"
INHIBITOR_WHY="external display connected"

die() {
    printf 'lid: %s\n' "$1" >&2
    exit 1
}

command -v hyprctl >/dev/null 2>&1 || die "hyprctl is not installed"

enabled_outputs() {
    hyprctl -j monitors | python3 -c 'import json, sys
print(len(json.load(sys.stdin)))'
}

external_connected() {
    hyprctl -j monitors | python3 -c 'import json, sys
panel = sys.argv[1]
monitors = json.load(sys.stdin)
sys.exit(0 if any(m["name"] != panel for m in monitors) else 1)
' "${PANEL}"
}

# logind suspends on lid close by default regardless of an
# external display, since it only skips that for its own idea
# of "docked" (an ACPI dock station, which a USB-C hub is not).
# Holding this inhibitor while docked hands lid handling to us
# instead, via the switch:on:Lid Switch bind below; dropping it
# when undocked restores logind's normal suspend-on-close.
inhibitor_pid() {
    [[ -r "${INHIBITOR_PID_FILE}" ]] || return 1
    local pid
    pid=$(cat "${INHIBITOR_PID_FILE}")
    [[ -n "${pid}" ]] || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    grep -q systemd-inhibit "/proc/${pid}/cmdline" \
        2>/dev/null || return 1
    printf '%s' "${pid}"
}

start_inhibitor() {
    mkdir -p "${STATE_DIR}"
    setsid systemd-inhibit \
        --what=handle-lid-switch \
        --who="${INHIBITOR_WHO}" \
        --why="${INHIBITOR_WHY}" \
        --mode=block \
        sleep infinity \
        >/dev/null 2>&1 &
    disown
    echo "$!" >"${INHIBITOR_PID_FILE}"
}

cmd_sync() {
    local pid
    if external_connected; then
        pid=$(inhibitor_pid) || start_inhibitor
        return 0
    fi
    pid=$(inhibitor_pid) || return 0
    kill "${pid}" 2>/dev/null || true
    rm -f "${INHIBITOR_PID_FILE}"
}

case "$ACTION" in
close)
    # Blanking the only display would leave the session with
    # nowhere to draw, so the panel stays lit unless another
    # monitor is already carrying the desktop.
    [ "$(enabled_outputs)" -gt 1 ] || exit 0
    hyprctl eval \
        "hl.monitor({ output = \"$PANEL\", disabled = true })"
    ;;
open)
    hyprctl eval "hl.monitor({ output = \"$PANEL\",
        mode = \"preferred\", position = \"auto\",
        scale = 1.0 })"
    ;;
sync)
    cmd_sync
    ;;
*)
    die "usage: lid close|open|sync"
    ;;
esac
