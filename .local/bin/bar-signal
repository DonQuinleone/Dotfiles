#!/usr/bin/env bash
set -euo pipefail

readonly UNIT='waybar.service'

declare -rA OFFSETS=(
    [record]=1
    [dnd]=2
    [caffeine]=3
)

usage() {
    printf 'usage: %s %s\n' "${0##*/}" "${!OFFSETS[*]}" >&2
    exit 2
}

indicator="${1:-}"
[ -n "$indicator" ] || usage

offset="${OFFSETS[$indicator]:-}"
[ -n "$offset" ] || usage

systemctl --user kill -s "SIGRTMIN+${offset}" "$UNIT" 2>/dev/null \
    || true
