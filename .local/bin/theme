#!/usr/bin/env python3
"""Render every themed file from one palette and reload what is live."""

import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tomllib

HOME = pathlib.Path.home()
CONFIG = pathlib.Path(
    os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE = pathlib.Path(
    os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))

THEMES = CONFIG / "theme/themes"
TEMPLATES = CONFIG / "theme/templates"
RENDERED = STATE / "theme"
CURRENT = RENDERED / "current"

WALLPAPERS = HOME / "Pictures/walls"

FONT_UI = "IBM Plex Sans"
FONT_MONO = "JetBrainsMono Nerd Font"
SIZE_UI = 17
SIZE_MONO = 17
SIZE_BAR = 16
WEIGHT_BODY = 400
WEIGHT_BOLD = 700

TERMINAL_DARK_OPACITY = "0.8"
TERMINAL_LIGHT_OPACITY = "0.97"
LIGHT_MODE_SUM = 382

MOTION = {
    "motion_quick": "150",
    "motion_normal": "175",
    "motion_slow": "200",
    "motion_standard": "OutCubic",
    "motion_enter": "OutBack",
    "motion_exit": "OutCubic",
    "motion_reduce": "false",
}

LINKS = (
    ("btop.theme", "btop/themes/current.theme"),
    ("lsd-colours.yaml", "lsd/colors.yaml"),
    ("qt6ct.conf", "qt6ct/colors/current.conf"),
    ("gtk3.css", "gtk-3.0/gtk.css"),
    ("gtk3-settings.ini", "gtk-3.0/settings.ini"),
    ("gtk4.css", "gtk-4.0/gtk.css"),
    ("gtk4-settings.ini", "gtk-4.0/settings.ini"),
    ("yazi-theme.toml", "yazi/theme.toml"),
    ("imv.conf", "imv/config"),
    ("rofi.rasi", "rofi/theme.rasi"),
    ("mako.conf", "mako/config"),
    ("hyprlock.conf", "hypr/hyprlock-colours.conf"),
    ("waybar.css", "waybar/style.css"),
)

BRAVE_POLICY = pathlib.Path(
    "/etc/brave/policies/managed/theme-colour.json")
BRAVE_BINARY = "brave-origin"

FIREFOX_ROOT = CONFIG / "mozilla/firefox"
FIREFOX_LINKS = (
    ("firefox-chrome.css", "theme.css", "userChrome.css"),
    ("firefox-content.css", "theme-content.css", "userContent.css"),
)
FIREFOX_PREF = ("toolkit.legacyUserProfileCustomizations"
                ".stylesheets")

RELOADS = (
    ("makoctl", ("makoctl", "reload")),
    ("hyprctl", ("hyprctl", "reload")),
    ("kitty", ("pkill", "-SIGUSR1", "kitty")),
    ("waybar", ("pkill", "-SIGUSR2", "waybar")),
)

MIX_TOKEN = re.compile(
    r"\{\{\s*(mix|mix_strip)\s+(\w+)\s+(\w+)\s+"
    r"([0-9.]+)%?\s*\}\}")
NAME_TOKEN = re.compile(r"\{\{\s*(\w+)\s*\}\}")


def die(message):
    sys.exit("theme: " + message)


def channels(colour):
    bare = colour.lstrip("#")
    return tuple(int(bare[at:at + 2], 16) for at in (0, 2, 4))


def mix(start, end, amount):
    fraction = max(0.0, min(1.0, float(amount) / 100.0))
    blended = (
        int(one * (1 - fraction) + other * fraction + 0.5)
        for one, other in zip(channels(start), channels(end)))
    return "#" + "".join("%02x" % value for value in blended)


def slugs():
    return sorted(path.stem for path in THEMES.glob("*.toml"))


def palette_of(slug):
    path = THEMES / (slug + ".toml")
    if not path.is_file():
        die("no theme called '%s' (have: %s)"
            % (slug, ", ".join(slugs())))
    return tomllib.load(open(path, "rb"))


def tokens_for(slug):
    palette = palette_of(slug)
    tokens = {key: str(value) for key, value in palette.items()}

    mode = tokens.get("mode")
    if mode is None:
        mode = ("light" if sum(channels(tokens["background"]))
                > LIGHT_MODE_SUM else "dark")
        tokens["mode"] = mode

    tokens.setdefault("cursor", tokens["bright_foreground"])
    tokens.setdefault("selection_background", tokens["selection"])
    tokens.setdefault("selection_foreground",
                      tokens["bright_foreground"])
    tokens["prefers_dark"] = "true" if mode == "dark" else "false"
    tokens["terminal_opacity"] = (
        TERMINAL_DARK_OPACITY if mode == "dark"
        else TERMINAL_LIGHT_OPACITY)

    tokens["theme_slug"] = slug
    tokens["theme_name"] = tokens.get("name", slug)
    tokens["theme_font_ui"] = FONT_UI
    tokens["theme_font_mono"] = FONT_MONO
    tokens["theme_size_ui"] = str(SIZE_UI)
    tokens["theme_size_mono"] = str(SIZE_MONO)
    tokens["theme_size_bar"] = str(SIZE_BAR)
    tokens["theme_weight_body"] = str(WEIGHT_BODY)
    tokens["theme_weight_bold"] = str(WEIGHT_BOLD)
    tokens.update(MOTION)

    for key, value in list(tokens.items()):
        if value.startswith("#"):
            tokens[key + "_strip"] = value.lstrip("#")
    return tokens


def render(text, tokens):
    def blend(match):
        verb, start, end, amount = match.groups()
        if start not in tokens or end not in tokens:
            return match.group(0)
        value = mix(tokens[start], tokens[end], amount)
        return value.lstrip("#") if verb == "mix_strip" else value

    def name(match):
        return tokens.get(match.group(1), match.group(0))

    return NAME_TOKEN.sub(name, MIX_TOKEN.sub(blend, text))


def link(rendered_name, relative):
    target = RENDERED / rendered_name
    if not target.is_file():
        return
    path = CONFIG / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink() and path.readlink() == target:
        return
    if path.exists() or path.is_symlink():
        path.unlink()
    path.symlink_to(target)


def follow_wallpaper():
    chooser = shutil.which("wallpaper")
    if chooser is None:
        return
    subprocess.run((chooser, "theme"), check=False,
                   stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)


def link_file(target, path):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink() and path.readlink() == target:
        return
    if path.exists() or path.is_symlink():
        path.unlink()
    path.symlink_to(target)


# Chromium reads its theme from managed policy, which is a
# directory only root may write; the install step hands this
# account ownership of it, and a switch is a no-op without that.
def apply_brave(tokens):
    if not os.access(BRAVE_POLICY.parent, os.W_OK):
        return
    scheme = "Dark" if tokens.get("mode") == "dark" else "Light"
    colour = mix(tokens["background"], tokens["accent"], 30)
    BRAVE_POLICY.write_text(json.dumps({
        "BrowserThemeColor": colour,
        "BrowserColorScheme": scheme,
    }, indent=2) + "\n")
    if shutil.which(BRAVE_BINARY) is None:
        return
    subprocess.run(
        (BRAVE_BINARY, "--refresh-platform-policy",
         "--no-startup-window"),
        check=False, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL)


def apply_firefox():
    if not FIREFOX_ROOT.is_dir():
        return
    for profile in sorted(FIREFOX_ROOT.iterdir()):
        marker = ((profile / "prefs.js").is_file()
                  or (profile / "times.json").is_file())
        if not marker:
            continue
        chrome = profile / "chrome"
        for rendered, name, importer in FIREFOX_LINKS:
            source = RENDERED / rendered
            if not source.is_file():
                continue
            link_file(source, chrome / name)
            sheet = chrome / importer
            line = '@import url("%s");' % name
            if not sheet.is_file() or line not in sheet.read_text():
                sheet.write_text(line + "\n")
        user_js = profile / "user.js"
        pref = 'user_pref("%s", true);' % FIREFOX_PREF
        existing = user_js.read_text() if user_js.is_file() else ""
        if FIREFOX_PREF not in existing:
            user_js.write_text(existing.rstrip("\n") + "\n"
                               + pref + "\n" if existing else
                               pref + "\n")


def reload_live():
    for binary, command in RELOADS:
        if shutil.which(binary) is None:
            continue
        subprocess.run(command, check=False,
                       stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)


def current():
    if CURRENT.is_file():
        return CURRENT.read_text().strip()
    return None


def set_theme(slug):
    tokens = tokens_for(slug)
    RENDERED.mkdir(parents=True, exist_ok=True)

    written = 0
    for template in sorted(TEMPLATES.glob("*.tpl")):
        text = template.read_text(errors="surrogateescape")
        (RENDERED / template.stem).write_text(
            render(text, tokens), errors="surrogateescape")
        written += 1

    for rendered_name, relative in LINKS:
        link(rendered_name, relative)

    apply_brave(tokens)
    apply_firefox()

    CURRENT.write_text(slug + "\n")
    follow_wallpaper()
    reload_live()
    print("theme: %s (%d files)" % (slug, written))


def pick():
    choice = subprocess.run(
        ("rofi", "-dmenu", "-i", "-p", "Theme"),
        input="\n".join(slugs()), capture_output=True, text=True)
    chosen = choice.stdout.strip()
    if chosen:
        set_theme(chosen)


def main(argv):
    if not argv or argv[0] == "list":
        print("\n".join(slugs()))
        return
    verb = argv[0]
    if verb == "current":
        print(current() or "none")
        return
    if verb == "pick":
        pick()
        return
    if verb == "set":
        if len(argv) < 2:
            die("set needs a theme name")
        set_theme(argv[1])
        return
    die("unknown command '%s' (list, current, set, pick)" % verb)


if __name__ == "__main__":
    main(sys.argv[1:])
