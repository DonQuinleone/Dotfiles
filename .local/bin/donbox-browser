#!/usr/bin/env bash
# donbox:summary=Open a page as a window with no browser around it
# donbox:args=<name> <url>
set -euo pipefail

readonly CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly PROFILE_ROOT="${CONFIG_HOME}/mozilla/firefox"
readonly PROFILE_INDEX="profiles.ini"
readonly PROFILE_PREFIX=donbox-
readonly BROWSER=firefox

BIN_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly BIN_DIR
ADDON_DIR=$(dirname "${BIN_DIR}")/share/donbox/addons
readonly ADDON_DIR
readonly LINKOUT_ID="linkout@donbox.invalid"
readonly LINKOUT_PROFILE="${PROFILE_PREFIX}mail"

readonly CHROME_DIR=chrome
readonly CHROME_SHEET=userChrome.css
readonly BARE_SHEET=donbox-bare.css
readonly USER_PREFS=user.js

die() {
    printf 'donbox browser: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
usage: donbox browser <name> <url>

Opens the URL in a window of its own with no browser chrome,
under a profile named after <name>. The profile is made on first
use and the window reports donbox-<name> as its application id,
which is what a window rule can be written against.
EOF
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        die "$1 is not installed but is required"
}

profile_named() {
    grep -qx "Name=$1" "${PROFILE_ROOT}/${PROFILE_INDEX}" \
        2>/dev/null
}

# Firefox writes the profile into its own index, so it is asked
# to make one rather than the index being edited here.
create_profile() {
    local profile="$1"
    "${BROWSER}" -CreateProfile \
        "${profile} ${PROFILE_ROOT}/${profile}" >/dev/null 2>&1 ||
        die "could not create the ${profile} profile"
}

# A fresh profile opens its privacy notice and its what's-new
# page ahead of anything asked for, and both have to be turned
# off by name.
write_prefs() {
    cat >"$1/${USER_PREFS}" <<'EOF'
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("datareporting.policy.firstRunURL", "");
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("network.protocol-handler.expose.donbox", false);
user_pref("network.protocol-handler.external.donbox", true);
user_pref("network.protocol-handler.warn-external.donbox", false);
EOF
}

# Firefox has no application mode, so the chrome is taken away
# with a stylesheet instead. It goes in a sheet of its own and is
# imported, because the theme writes to userChrome.css too.
#
# The toolbar is flattened rather than collapsed. Firefox hangs
# its prompts off the address bar, the one asking for a security
# key among them, and a collapsed toolbar has no position to hang
# them from: the prompt never appears, and a sign-in waiting on
# it can only fail. At no height it still has somewhere to be,
# and the prompt opens against the top of the window.
write_bare_sheet() {
    local chrome="$1/${CHROME_DIR}"
    mkdir -p "${chrome}"
    cat >"${chrome}/${BARE_SHEET}" <<'EOF'
#navigator-toolbox {
    height: 0 !important;
    min-height: 0 !important;
    max-height: 0 !important;
    overflow: hidden !important;
}

/* The address bar lifts itself out of the toolbar to draw, so
   collapsing the toolbar leaves it floating over the page. It is
   made invisible where it stands rather than removed, since it is
   the thing prompts are hung from. */
#urlbar,
#urlbar-container {
    opacity: 0 !important;
    pointer-events: none !important;
}
EOF
    prepend_import "${chrome}/${CHROME_SHEET}"
}

prepend_import() {
    local sheet="$1" line temporary
    line="@import url(\"${BARE_SHEET}\");"
    temporary=$(mktemp "${sheet}.XXXXXX")
    printf '%s\n' "${line}" >"${temporary}"
    if [[ -f "${sheet}" ]]; then
        grep -vxF "${line}" "${sheet}" >>"${temporary}" || true
    fi
    mv "${temporary}" "${sheet}"
}

# Safe to run again: an existing profile keeps whatever is signed
# in to it and only has its own settings rewritten.
# The mail profile alone: the add-on carries the hosts that pad
# is signed in to, and any other profile would have its links
# sent somewhere they do not belong. Firefox will not load one it
# cannot verify, so what ships here is the signed package rather
# than the source beside it.
install_linkout() {
    local directory="$1"
    local source="${ADDON_DIR}/${LINKOUT_ID}.xpi"
    local target="${directory}/extensions/${LINKOUT_ID}.xpi"
    [[ -f "${source}" ]] || return 0
    if cmp -s "${source}" "${target}"; then
        return 0
    fi
    mkdir -p "${directory}/extensions"
    install -m 0644 "${source}" "${target}"
}

ensure_profile() {
    local profile="$1" directory="${PROFILE_ROOT}/$1"
    profile_named "${profile}" || create_profile "${profile}"
    [[ -d "${directory}" ]] ||
        die "no profile directory at ${directory}"
    write_prefs "${directory}"
    write_bare_sheet "${directory}"
    if [[ "${profile}" == "${LINKOUT_PROFILE}" ]]; then
        install_linkout "${directory}"
    fi
}

# The remoting name is both the application id Firefox reports to
# Wayland and the instance other launches look for, so the first
# call starts the browser and the second opens a second window in
# it rather than colliding over a locked profile.
main() {
    (($# == 2)) || usage
    require_command "${BROWSER}"

    local profile="${PROFILE_PREFIX}$1" url="$2"
    [[ "${url}" == *://* ]] || die "not a URL: ${url}"

    ensure_profile "${profile}"
    exec env MOZ_APP_REMOTINGNAME="${profile}" \
        "${BROWSER}" -P "${profile}" --new-window "${url}"
}

main "$@"
