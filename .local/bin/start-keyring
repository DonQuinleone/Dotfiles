#!/usr/bin/env bash
set -euo pipefail

readonly COMPONENTS=secrets,ssh,pkcs11

publish() {
    # shellcheck disable=SC2163
    export "$1"
    systemctl --user set-environment "$1"
    dbus-update-activation-environment --systemd "${1%%=*}"
}

main() {
    local printed line
    printed=$(gnome-keyring-daemon --start --components="${COMPONENTS}")
    while IFS= read -r line; do
        [[ "${line}" == *=* ]] || continue
        publish "${line}"
    done <<<"${printed}"
}

main "$@"
