#!/usr/bin/env bash
# donbox:summary=Send a link to the browser that should hold it
# donbox:args=<url>
set -euo pipefail

readonly PAD=mail
readonly BROWSER=firefox
readonly PAD_BROWSER=donbox-browser

# The pad's own windows cannot hand a link to another browser
# directly, so the extension in that profile wraps it in a scheme
# of ours, which the browser passes out to whatever claims it.
readonly WRAPPER=donbox:

# The pad keeps the only profile signed in to these, so a link to
# one of them has to land there rather than in a browser that
# would ask for the sign-in again.
readonly PAD_HOSTS=(
    mail.google.com
    calendar.google.com
    accounts.google.com
    accounts.youtube.com
)

die() {
    printf 'donbox open: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
usage: donbox open <url>

Opens the URL in the browser that should hold it: the mail pad
for the sites it is signed in to, and Firefox for everything
else. Meant to be reached through the desktop entry that claims
http and https rather than run by hand.
EOF
    exit 1
}

host_of() {
    local rest="${1#*://}"
    rest="${rest%%/*}"
    rest="${rest%%\?*}"
    rest="${rest##*@}"
    printf '%s\n' "${rest%%:*}"
}

belongs_to_pad() {
    local host="$1" candidate
    for candidate in "${PAD_HOSTS[@]}"; do
        [[ "${host}" == "${candidate}" ]] && return 0
    done
    return 1
}

main() {
    (($# == 1)) || usage
    local url="${1#"${WRAPPER}"}"
    [[ "${url}" == *://* ]] || die "not a URL: $1"

    if belongs_to_pad "$(host_of "${url}")"; then
        exec "${PAD_BROWSER}" "${PAD}" "${url}"
    fi
    command -v "${BROWSER}" >/dev/null 2>&1 ||
        die "${BROWSER} is not installed"
    exec "${BROWSER}" "${url}"
}

main "$@"
