#!/usr/bin/env bash
# Render every themed file from one palette and reload what is
# live.
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

CONFIG=${XDG_CONFIG_HOME:-${HOME}/.config}
STATE=${XDG_STATE_HOME:-${HOME}/.local/state}
DATA=${XDG_DATA_HOME:-${HOME}/.local/share}
readonly CONFIG STATE DATA

readonly THEMES=${CONFIG}/theme/themes
readonly TEMPLATES=${CONFIG}/theme/templates
readonly RENDERED=${STATE}/theme
readonly CURRENT=${RENDERED}/current

LIB=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
LIB=${LIB}/../share/theme/lib
readonly LIB

die() {
    printf 'theme: %s\n' "$1" >&2
    exit 1
}

# shellcheck source=../share/theme/lib/colour.sh
source "${LIB}/colour.sh"
# shellcheck source=../share/theme/lib/palette.sh
source "${LIB}/palette.sh"
# shellcheck source=../share/theme/lib/render.sh
source "${LIB}/render.sh"
# shellcheck source=../share/theme/lib/browsers.sh
source "${LIB}/browsers.sh"
# shellcheck source=../share/theme/lib/icons.sh
source "${LIB}/icons.sh"
# shellcheck source=../share/theme/lib/session.sh
source "${LIB}/session.sh"

current() {
    [[ -f $CURRENT ]] || { printf 'none\n'; return; }
    printf '%s\n' "$(<"${CURRENT}")"
}

set_theme() {
    local slug=$1 written
    tokens_for "${slug}"
    mkdir -p "${RENDERED}"
    written=$(render_templates)
    link_rendered

    apply_brave
    apply_firefox
    apply_teamspeak
    apply_icons

    printf '%s\n' "${slug}" >"${CURRENT}"
    follow_wallpaper
    apply_greeter
    reload_live
    printf 'theme: %s (%d files)\n' "${slug}" "${written}"
}

pick() {
    local chosen
    chosen=$(slugs | rofi -dmenu -i -p Theme) || return 0
    [[ -n $chosen ]] || return 0
    set_theme "${chosen}"
}

main() {
    case ${1:-list} in
        list) slugs ;;
        current) current ;;
        pick) pick ;;
        set)
            [[ $# -ge 2 ]] || die "set needs a theme name"
            set_theme "$2"
            ;;
        *) die "unknown command '$1' (list, current, set, pick)" ;;
    esac
}

main "$@"
