#!/usr/bin/env bash
set -euo pipefail

DIG_TIMEOUT_SECONDS=2
DIG_TRIES=1
RDAP_TIMEOUT_SECONDS=8
CYMRU_ORIGIN_V4_ZONE=origin.asn.cymru.com
CYMRU_ORIGIN_V6_ZONE=origin6.asn.cymru.com
CYMRU_ASN_ZONE=asn.cymru.com
ABUSIX_CONTACT_ZONE=abuse-contacts.abusix.zone
RDAP_BOOTSTRAP_URL=https://rdap.org
IPV6_GROUP_COUNT=8

RBL_ZONES=(
    zen.spamhaus.org
    bl.spamcop.net
    b.barracudacentral.org
    psbl.surriel.com
    dnsbl.dronebl.org
    dnsbl-1.uceprotect.net
    spam.spamrats.com
)

if [[ -t 1 ]]; then
    BOLD=$(tput bold)
    RESET=$(tput sgr0)
else
    BOLD=
    RESET=
fi

usage() {
    cat <<'EOF'
Usage: hostinfo <hostname|url|address>

Reports the target's IP addresses, reverse DNS, ASN and prefix,
abuse contact, DNS blacklist listings, the authoritative DNS
zone (NS, SOA, MX, SPF, DMARC, CAA) and domain registration.
EOF
}

die() {
    printf 'hostinfo: %s\n' "$*" >&2
    exit 1
}

heading() {
    printf '%s%s%s\n' "$BOLD" "$1" "$RESET"
}

field() {
    printf '  %-10s %s\n' "$1" "$2"
}

join_lines() {
    local lines=$1 separator=$2
    printf '%s' "${lines//$'\n'/$separator}"
}

dns_records() {
    local name=$1 type=$2
    dig +noall +answer +time="$DIG_TIMEOUT_SECONDS" \
        +tries="$DIG_TRIES" "$name" "$type" 2>/dev/null |
        awk -v type="$type" '$4 == type {
            out = $5
            for (i = 6; i <= NF; i++) out = out " " $i
            print out
        }' || true
}

ptr_records() {
    dig +noall +answer +time="$DIG_TIMEOUT_SECONDS" \
        +tries="$DIG_TRIES" -x "$1" 2>/dev/null |
        awk '$4 == "PTR" {print $5}' || true
}

host_addresses() {
    dns_records "$1" A
    dns_records "$1" AAAA
}

normalise_target() {
    local target=${1,,}
    target=${target#*://}
    target=${target%%[/?#]*}
    target=${target##*@}
    if [[ $target == \[*\]* ]]; then
        target=${target#\[}
        target=${target%%\]*}
    elif [[ $target == *:* && $target != *:*:* ]]; then
        target=${target%:*}
    fi
    target=${target%%\%*}
    printf '%s' "${target%.}"
}

is_ipv4() {
    [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

is_ipv6() {
    [[ $1 =~ ^[0-9a-f:]+$ && $1 == *:* ]]
}

reverse_ipv4() {
    local -a octets
    IFS=. read -ra octets <<<"$1"
    printf '%s.%s.%s.%s' \
        "${octets[3]}" "${octets[2]}" "${octets[1]}" "${octets[0]}"
}

ipv6_nibbles() {
    local address=$1 left right=
    left=$address
    if [[ $address == *::* ]]; then
        left=${address%%::*}
        right=${address#*::}
    fi
    local -a groups=() left_groups=() right_groups=()
    IFS=: read -ra left_groups <<<"$left"
    IFS=: read -ra right_groups <<<"$right"
    local pad
    pad=$((IPV6_GROUP_COUNT - ${#left_groups[@]} - ${#right_groups[@]}))
    groups=("${left_groups[@]}")
    while ((pad > 0)); do
        groups+=(0)
        pad=$((pad - 1))
    done
    groups+=("${right_groups[@]}")
    local hex='' group
    for group in "${groups[@]}"; do
        hex+=$(printf '%04x' "$((16#${group:-0}))")
    done
    local nibbles='' position
    for ((position = ${#hex} - 1; position >= 0; position--)); do
        nibbles+="${hex:position:1}."
    done
    printf '%s' "${nibbles%.}"
}

reversed_for() {
    if is_ipv4 "$1"; then
        reverse_ipv4 "$1"
    else
        ipv6_nibbles "$1"
    fi
}

cymru_origin() {
    local address=$1
    if is_ipv4 "$address"; then
        dns_records \
            "$(reverse_ipv4 "$address").$CYMRU_ORIGIN_V4_ZONE" TXT
    else
        dns_records \
            "$(ipv6_nibbles "$address").$CYMRU_ORIGIN_V6_ZONE" TXT
    fi
}

asn_name() {
    dns_records "AS$1.$CYMRU_ASN_ZONE" TXT |
        head -1 | tr -d '"' | awk -F' \\| ' '{print $5}'
}

report_rdns() {
    local address=$1
    local -a pointers=()
    mapfile -t pointers < <(ptr_records "$address")
    if ((${#pointers[@]} == 0)); then
        field rDNS none
        return
    fi
    local pointer name
    for pointer in "${pointers[@]}"; do
        name=${pointer%.}
        if host_addresses "$name" | grep -qixF "$address"; then
            field rDNS "$name (forward-confirmed)"
        else
            field rDNS "$name (no forward confirmation)"
        fi
    done
}

report_asn() {
    local address=$1 origin
    origin=$(cymru_origin "$address" | head -1 | tr -d '"')
    if [[ -z $origin ]]; then
        field ASN unknown
        return
    fi
    local asn prefix country registry allocated
    IFS='|' read -r asn prefix country registry allocated \
        <<<"${origin// | /|}"
    asn=${asn%% *}
    local name
    name=$(asn_name "$asn")
    field ASN "AS$asn${name:+  $name}"
    field Prefix "$prefix ($country, $registry, allocated $allocated)"
}

report_abuse() {
    local address=$1 contact
    contact=$(dns_records \
        "$(reversed_for "$address").$ABUSIX_CONTACT_ZONE" TXT |
        head -1 | tr -d '"')
    field Abuse "${contact:-unknown}"
}

report_rbls() {
    local address=$1 reversed zone answer reason
    reversed=$(reverse_ipv4 "$address")
    local -a listed=() refused=()
    for zone in "${RBL_ZONES[@]}"; do
        answer=$(dns_records "$reversed.$zone" A | head -1)
        if [[ -z $answer ]]; then
            continue
        fi
        # Spamhaus answers 127.255.255.x when the query arrived
        # via a public resolver; it is not a listing.
        if [[ $answer == 127.255.255.* ]]; then
            refused+=("$zone")
            continue
        fi
        if [[ $answer != 127.* ]]; then
            continue
        fi
        reason=$(dns_records "$reversed.$zone" TXT | head -1 |
            tr -d '"')
        listed+=("$zone $answer${reason:+  $reason}")
    done
    if ((${#listed[@]} == 0)); then
        field RBLs "clean (${#RBL_ZONES[@]} checked)"
    else
        field RBLs "listed on ${#listed[@]} of ${#RBL_ZONES[@]} checked"
        local entry
        for entry in "${listed[@]}"; do
            printf '    %s\n' "$entry"
        done
    fi
    if ((${#refused[@]} > 0)); then
        field '' "(${refused[*]}: refused, needs a direct resolver)"
    fi
}

report_address() {
    local address=$1
    heading "Address $address"
    report_rdns "$address"
    report_asn "$address"
    report_abuse "$address"
    if is_ipv4 "$address"; then
        report_rbls "$address"
    fi
}

find_zone() {
    local name=$1
    while [[ $name == *.* ]]; do
        if [[ -n $(dns_records "$name" NS) ]]; then
            printf '%s' "$name"
            return
        fi
        name=${name#*.}
    done
}

report_zone() {
    local zone=$1
    heading "Zone $zone"
    local -a servers=()
    mapfile -t servers < <(dns_records "$zone" NS | sort)
    local server addresses
    for server in "${servers[@]}"; do
        server=${server%.}
        addresses=$(join_lines "$(host_addresses "$server")" ' ')
        field NS "$server${addresses:+ ($addresses)}"
    done
    local soa
    soa=$(dns_records "$zone" SOA | head -1)
    if [[ -n $soa ]]; then
        local primary hostmaster serial
        read -r primary hostmaster serial _ <<<"$soa"
        field SOA \
            "${primary%.}, contact ${hostmaster%.}, serial $serial"
    fi
    local mx
    mx=$(join_lines "$(dns_records "$zone" MX | sort -n)" ', ')
    field MX "${mx:-none}"
    local spf
    spf=$(dns_records "$zone" TXT | tr -d '"' |
        grep -i '^v=spf1' | head -1 || true)
    field SPF "${spf:-none}"
    local dmarc
    dmarc=$(dns_records "_dmarc.$zone" TXT | tr -d '"' |
        grep -i '^v=dmarc1' | head -1 || true)
    field DMARC "${dmarc:-none}"
    local caa
    caa=$(join_lines "$(dns_records "$zone" CAA)" ', ')
    field CAA "${caa:-none}"
}

report_registration() {
    local candidate=$1 json=
    while [[ $candidate == *.* ]]; do
        if json=$(curl -fsSL --max-time "$RDAP_TIMEOUT_SECONDS" \
            "$RDAP_BOOTSTRAP_URL/domain/$candidate" 2>/dev/null); then
            break
        fi
        json=
        candidate=${candidate#*.}
    done
    if [[ -z $json ]]; then
        return 0
    fi
    heading "Registration $candidate"
    local registrar
    registrar=$(jq -r '[.entities[]?
        | select(.roles[]? == "registrar")
        | .vcardArray[1][]? | select(.[0] == "fn") | .[3]][0]
        // empty' <<<"$json")
    field Registrar "${registrar:-unknown}"
    local expiry
    expiry=$(jq -r '[.events[]?
        | select(.eventAction == "expiration")
        | .eventDate][0] // empty' <<<"$json")
    field Expires "${expiry:-unknown}"
    local status
    status=$(jq -r '.status // [] | join(", ")' <<<"$json")
    field Status "${status:-unknown}"
}

resolve_addresses() {
    local target=$1
    local -a answers=()
    mapfile -t answers < <(host_addresses "$target")
    local answer
    for answer in "${answers[@]}"; do
        if is_ipv4 "$answer" || is_ipv6 "$answer"; then
            printf '%s\n' "$answer"
        fi
    done
}

main() {
    if [[ ${1:-} == -h || ${1:-} == --help ]]; then
        usage
        exit 0
    fi
    if (($# != 1)); then
        usage >&2
        exit 64
    fi
    local tool
    for tool in dig curl jq; do
        command -v "$tool" >/dev/null || die "$tool not found"
    done

    local target
    target=$(normalise_target "$1")
    if [[ -z $target ]]; then
        die "could not parse a host from '$1'"
    fi

    local -a addresses=()
    heading "Target $target"
    if is_ipv4 "$target" || is_ipv6 "$target"; then
        addresses=("$target")
    else
        mapfile -t addresses < <(resolve_addresses "$target")
        if ((${#addresses[@]} == 0)); then
            die "$target does not resolve"
        fi
        local canonical
        canonical=$(dns_records "$target" CNAME | head -1)
        if [[ -n $canonical ]]; then
            field CNAME "${canonical%.}"
        fi
    fi

    local address
    for address in "${addresses[@]}"; do
        echo
        report_address "$address"
    done

    if is_ipv4 "$target" || is_ipv6 "$target"; then
        return
    fi
    local zone
    zone=$(find_zone "$target")
    if [[ -n $zone ]]; then
        echo
        report_zone "$zone"
        echo
        report_registration "$zone"
    fi
}

main "$@"
