#!/usr/bin/env bash
set -euo pipefail

HERE=$(dirname "$(readlink -f "$0")")
readonly HERE

declare -rA SIGNALS=(
    [record]=1
    [dnd]=2
    [caffeine]=3
)

usage() {
    printf 'usage: %s toggle [<role>]\n' "${0##*/}" >&2
    printf '       %s show|hide <role>\n' "${0##*/}" >&2
    printf '       %s all\n' "${0##*/}" >&2
    printf '       %s signal %s\n' \
        "${0##*/}" "${!SIGNALS[*]}" >&2
    exit 2
}

readonly RUNTIME=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/waybar

unit() {
    printf 'waybar@%s.service' "$1"
}

# Whichever waybar starts first owns the StatusNotifierWatcher,
# and tray apps only register once, so stopping that process
# empties every tray until they are restarted. Hiding is left to
# waybar's own SIGUSR1, which keeps the process alive, and the
# flag file remembers the state that signal does not report.
hidden_flag() {
    printf '%s/%s.hidden' "$RUNTIME" "$1"
}

running() {
    systemctl --user --quiet is-active "$(unit "$1")"
}

flip() {
    systemctl --user kill -s SIGUSR1 "$(unit "$1")"
}

roles() {
    "${HERE}/monitor-run" roles
}

valid() {
    "${HERE}/monitor-run" description "$1" >/dev/null
}

showing() {
    running "$1" || return 1
    [ ! -e "$(hidden_flag "$1")" ]
}

show() {
    if ! running "$1"; then
        systemctl --user start "$(unit "$1")"
        return
    fi
    if showing "$1"; then
        return
    fi
    flip "$1"
    rm -f "$(hidden_flag "$1")"
}

hide() {
    if ! showing "$1"; then
        return
    fi
    flip "$1"
    mkdir -p "$RUNTIME"
    : >"$(hidden_flag "$1")"
}

toggle() {
    if showing "$1"; then
        hide "$1"
        return
    fi
    show "$1"
}

any_showing() {
    local role
    while read -r role; do
        if showing "$role"; then
            return 0
        fi
    done < <(roles)
    return 1
}

each() {
    local action=$1 role
    while read -r role; do
        "$action" "$role"
    done < <(roles)
}

toggle_all() {
    if any_showing; then
        each hide
        return
    fi
    each show
}

signal() {
    local offset=${SIGNALS[$1]:-} role
    [ -n "$offset" ] || usage
    while read -r role; do
        systemctl --user kill -s "SIGRTMIN+${offset}" \
            "$(unit "$role")" 2>/dev/null || true
    done < <(roles)
}

command=${1:-}

case $command in
    toggle)
        [ $# -le 2 ] || usage
        role=${2:-$("${HERE}/monitor-run" focused)}
        valid "$role"
        toggle "$role"
        ;;
    show | hide)
        [ $# -eq 2 ] || usage
        valid "$2"
        "$command" "$2"
        ;;
    all)
        [ $# -eq 1 ] || usage
        toggle_all
        ;;
    signal)
        [ $# -eq 2 ] || usage
        signal "$2"
        ;;
    *)
        usage
        ;;
esac
