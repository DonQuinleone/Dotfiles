#!/usr/bin/env bash
# donbox:summary=Open the terminal, however this one spells its flags
# donbox:args=[--role NAME|--class NAME] [--font-size N] [-- command...]
set -euo pipefail

BIN_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
readonly BIN_DIR
readonly APP="${BIN_DIR}/donbox-app"

die() {
    printf 'donbox term: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'usage: donbox term [--role NAME|--class NAME]' >&2
    printf ' [--font-size N] [--] [command...]\n' >&2
}

compose() {
    local terminal="$1" class="$2" points="$3"
    shift 3
    ARGV=("${terminal}")
    case "${terminal}" in
        kitty)
            [[ -z "${class}" ]] || ARGV+=(--class "${class}")
            [[ -z "${points}" ]] ||
                ARGV+=(--override "font_size=${points}")
            [[ $# -eq 0 ]] || ARGV+=("$@")
            ;;
        ghostty)
            # A folded-in window keeps the running instance's
            # class rather than the one asked for.
            [[ -z "${class}" ]] ||
                ARGV+=("--class=${class}" --gtk-single-instance=false)
            [[ -z "${points}" ]] || ARGV+=("--font-size=${points}")
            [[ $# -eq 0 ]] || ARGV+=(-e "$@")
            ;;
        *)
            [[ -z "${class}" ]] || ARGV+=(--class "${class}")
            [[ $# -eq 0 ]] || ARGV+=(-e "$@")
            ;;
    esac
}

main() {
    local class="" role="" points=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --role)
                [[ $# -ge 2 ]] || die "--role needs a name"
                role="$2"
                shift 2
                ;;
            --class)
                [[ $# -ge 2 ]] || die "--class needs a name"
                class="$2"
                shift 2
                ;;
            --font-size)
                [[ $# -ge 2 ]] || die "--font-size needs a number"
                points="$2"
                shift 2
                ;;
            --)
                shift
                break
                ;;
            -*)
                die "unknown option '$1'"
                ;;
            *)
                break
                ;;
        esac
    done

    [[ -z "${role}" ]] || class="$("${APP}" class "${role}")" ||
        die "no class is named for '${role}'"

    local terminal="${DONBOX_TERMINAL:-}"
    [[ -n "${terminal}" ]] ||
        terminal="$("${APP}" terminal)" ||
        die "no terminal is named"
    command -v "${terminal}" >/dev/null 2>&1 ||
        die "${terminal} is not installed"

    local -a ARGV
    compose "${terminal}" "${class}" "${points}" "$@"
    exec "${ARGV[@]}"
}

main "$@"
