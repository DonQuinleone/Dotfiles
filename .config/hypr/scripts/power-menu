#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly SCRIPT_DIR
readonly PICK="${SCRIPT_DIR}/pick"
readonly LOCK="${SCRIPT_DIR}/idle-lock"
readonly MENU_PROMPT="Power"
readonly CONFIRM_VALUE=confirm
readonly CANCEL_VALUE=cancel
readonly LABEL_FIELD=1
readonly GUARD_FIELD=4
readonly GUARDED=yes

readonly ROW_SEPARATOR='|'

readonly MENU_ROWS=(
    "run_lock|Lock|system-lock-screen|Blank and lock the screen|no"
    "run_logout|Log out|system-log-out|End the Hyprland session|no"
    "run_suspend|Suspend|system-suspend|Sleep until a key press|no"
    "run_reboot|Reboot|system-reboot|Restart the machine now|yes"
    "run_poweroff|Shut down|system-shutdown|Power the machine off|yes"
)

die() {
    printf 'power-menu: %s\n' "$*" >&2
    exit 1
}

run_lock() {
    "${LOCK}"
}

run_logout() {
    hyprctl dispatch 'hl.dsp.exit()'
}

run_suspend() {
    systemctl suspend
}

run_reboot() {
    systemctl reboot
}

run_poweroff() {
    systemctl poweroff
}

menu_items() {
    local row fields
    for row in "${MENU_ROWS[@]}"; do
        IFS="${ROW_SEPARATOR}" read -r -a fields <<<"${row}"
        printf '%s\t%s\t%s\t%s\n' \
            "${fields[0]}" "${fields[1]}" \
            "${fields[2]}" "${fields[3]}"
    done
}

field_of() {
    local row fields
    for row in "${MENU_ROWS[@]}"; do
        IFS="${ROW_SEPARATOR}" read -r -a fields <<<"${row}"
        [[ "${fields[0]}" == "$1" ]] || continue
        printf '%s\n' "${fields[$2]}"
        return
    done
    die "no such entry: $1"
}

confirmed() {
    local label="$1" answer
    answer=$(printf '%s\t%s\n' \
        "${CANCEL_VALUE}" "Go back" \
        "${CONFIRM_VALUE}" "Yes, ${label,}" |
        "${PICK}" --prompt "${label}?") || return 1
    [[ "${answer}" == "${CONFIRM_VALUE}" ]]
}

main() {
    (($# == 0)) || die "takes no arguments"
    [[ -x "${PICK}" ]] || die "${PICK} is missing"

    local handler label guard
    handler=$(menu_items |
        "${PICK}" --prompt "${MENU_PROMPT}") || exit 0
    label=$(field_of "${handler}" "${LABEL_FIELD}")
    guard=$(field_of "${handler}" "${GUARD_FIELD}")

    if [[ "${guard}" == "${GUARDED}" ]]; then
        confirmed "${label}" || exit 0
    fi
    "${handler}"
}

main "$@"
