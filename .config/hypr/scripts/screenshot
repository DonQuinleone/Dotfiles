#!/usr/bin/env bash
set -euo pipefail

MODE=${1:-output}
TARGET=${2:-clipboard}
SHOTS=${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots

die() {
    printf 'screenshot: %s\n' "$1" >&2
    exit 1
}

for tool in grim slurp wl-copy hyprctl; do
    command -v "$tool" >/dev/null 2>&1 ||
        die "$tool is not installed"
done

focused_output() {
    hyprctl -j monitors |
        python3 -c 'import json, sys
for monitor in json.load(sys.stdin):
    if monitor["focused"]:
        print(monitor["name"])
        break'
}

case "$MODE" in
output)
    capture=(-o "$(focused_output)")
    ;;
region)
    region=$(slurp) || exit 0
    capture=(-g "$region")
    ;;
*)
    die "unknown mode: $MODE"
    ;;
esac

if [ "$TARGET" = "save" ]; then
    mkdir -p "$SHOTS"
    shot=$SHOTS/$(date +%Y-%m-%d-%H%M%S).png
    grim "${capture[@]}" "$shot"
    wl-copy < "$shot"
    printf '%s\n' "$shot"
else
    grim "${capture[@]}" - | wl-copy
fi
