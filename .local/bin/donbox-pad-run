#!/usr/bin/env bash
# donbox:summary=Start a pad's program unless it is already there
# donbox:args=<class> -- <command...>
# donbox:hidden=true
set -euo pipefail

die() {
    printf 'donbox pad-run: %s\n' "$*" >&2
    exit 1
}

[[ $# -ge 3 ]] || die "usage: donbox pad-run <class> -- <command...>"

readonly WINDOW_CLASS="$1"
shift
[[ "$1" == "--" ]] || die "the command must follow --"
shift

window_present() {
    hyprctl -j clients | python3 -c 'import json, sys
wanted = sys.argv[1]
windows = json.load(sys.stdin)
sys.exit(0 if any(w["class"] == wanted for w in windows) else 1)' \
        "${WINDOW_CLASS}"
}

# The whole command, less any env prefix: "flatpak" alone would
# answer for every flatpak on the machine, and the program a
# command starts often runs under a name of its own.
program_pattern() {
    local word pattern=""
    for word in "$@"; do
        [[ -z "${pattern}" && "${word}" == "env" ]] && continue
        [[ -z "${pattern}" && "${word}" == *=* ]] && continue
        pattern+="${pattern:+ }${word}"
    done
    [[ -n "${pattern}" ]] || return 1
    printf '%s\n' "${pattern}"
}

# This script carries the program's name on its own command
# line, as do the shells that led here and every subshell it
# opens, all of which a search would otherwise take for the
# program already running.
# By name rather than by path: this is reached through a
# symlink, and a command line says the name it was called by
# rather than the file it landed on.
readonly SELF="${BASH_SOURCE[0]##*/}"

line_of() {
    cat "/proc/$1/cmdline" 2>/dev/null | tr '\0' ' '
}

led_here() {
    local pid="$1" walk=$$
    while [[ "${walk}" -gt 1 ]]; do
        [[ "${walk}" == "${pid}" ]] && return 0
        walk=$(ps -o ppid= -p "${walk}" 2>/dev/null | tr -d ' ')
        [[ -n "${walk}" ]] || break
    done
    return 1
}

program_present() {
    local name pid line
    name=$(program_pattern "$@") || return 1
    while read -r pid; do
        [[ -n "${pid}" ]] || continue
        line=$(line_of "${pid}")
        [[ -n "${line}" ]] || continue
        [[ "${line}" == *"${SELF}"* ]] && continue
        led_here "${pid}" && continue
        return 0
    done < <(pgrep -f -- "${name}" 2>/dev/null || true)
    return 1
}

window_present && exit 0
program_present "$@" && exit 0

exec "$@"
