#!/usr/bin/env bash
# donbox:summary=Apply the layout for what is plugged in
# donbox:hidden=true
set -euo pipefail

BIN_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly BIN_DIR
readonly PANEL_OUTPUT="eDP-1"
PROFILES_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}"
PROFILES_DIR="${PROFILES_DIR}/hypr/monitor-profiles"
readonly PROFILES_DIR

die() {
    printf 'donbox monitor profile: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
usage: donbox monitor profile save <name>
       donbox monitor profile apply <name> [--dry-run]
       donbox monitor profile list
       donbox monitor profile detect [--dry-run]
       donbox monitor profile reflow [--dry-run]
EOF
    exit 1
}

command -v hyprctl >/dev/null 2>&1 || die "hyprctl not found"
command -v python3 >/dev/null 2>&1 || die "python3 not found"

# A Lua config makes hyprctl eval the only way in, and it answers
# "ok" before reporting a Lua error on the next line, so the exit
# status alone would call a broken call a success.
eval_lua() {
    local call="$1" what="$2" dry_run="$3" output
    if [[ "${dry_run}" == "true" ]]; then
        printf '[dry-run] hyprctl eval %q\n' "${call}"
        return 0
    fi
    output=$(hyprctl eval "${call}" 2>&1) ||
        die "${what}: hyprctl eval could not be reached"
    case "${output}" in
    *error:*) die "${what}: ${output}" ;;
    esac
}

move_workspace() {
    local workspace_id="$1" connector="$2" dry_run="$3" call
    call="hl.dispatch(hl.dsp.workspace.move({"
    call+=" workspace = \"${workspace_id}\","
    call+=" monitor = \"${connector}\" }))"
    eval_lua "${call}" \
        "moving workspace ${workspace_id} to ${connector}" \
        "${dry_run}"
}

# A RETURN trap set inside a function stays armed after that
# function returns, so per-function traps would fire again
# (against variables no longer in scope) once an outer caller
# returns too. One EXIT trap over a shared list sidesteps that.
TMP_FILES=()
cleanup_tmp_files() {
    [[ ${#TMP_FILES[@]} -eq 0 ]] || rm -f "${TMP_FILES[@]}"
}
trap cleanup_tmp_files EXIT

new_tmp_file() {
    local file
    file=$(mktemp)
    TMP_FILES+=("${file}")
    printf '%s' "${file}"
}

valid_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die \
        "profile name must match [A-Za-z0-9][A-Za-z0-9_-]*:" \
        "'$1'"
}

profile_path() {
    printf '%s/%s.json' "${PROFILES_DIR}" "$1"
}

# Overridable so the matching and apply-plan logic can be
# exercised against fabricated multi-monitor layouts without
# a real dock: see the verification notes in the commit body.
current_monitors_json() {
    if [[ -n "${MONITOR_PROFILE_TEST_MONITORS_JSON:-}" ]]; then
        cat "${MONITOR_PROFILE_TEST_MONITORS_JSON}"
        return
    fi
    hyprctl -j monitors
}

current_workspaces_json() {
    if [[ -n "${MONITOR_PROFILE_TEST_WORKSPACES_JSON:-}" ]]
    then
        cat "${MONITOR_PROFILE_TEST_WORKSPACES_JSON}"
        return
    fi
    hyprctl -j workspaces
}

# Pairs each saved output (matched by description, never by
# connector name) with a currently connected connector, and
# prints one tab-separated plan row per output. Fails, with a
# reason on stderr, unless every saved output and every
# connected output are accounted for exactly once: a partial
# match is exactly the "guess where the extra monitor goes"
# situation this script exists to avoid.
resolve_plan() {
    local profile_json="$1" monitors_json="$2"
    python3 - "${profile_json}" "${monitors_json}" <<'PY'
import json
import sys

DEFAULT_BITDEPTH = 8

profile = json.load(open(sys.argv[1]))
monitors = json.load(open(sys.argv[2]))

available = {}
for monitor in monitors:
    available.setdefault(
        monitor["description"], []
    ).append(monitor["name"])

plan = []
for output in profile["outputs"]:
    description = output["description"]
    queue = available.get(description)
    if not queue:
        print(
            f'no connected output matches "{description}"',
            file=sys.stderr,
        )
        sys.exit(1)
    connector = queue.pop(0)
    mode = (
        f'{output["resolution"]}@{output["refresh_rate"]:.2f}'
    )
    workspaces = ",".join(
        str(w) for w in output["workspaces"]
    )
    plan.append((
        connector,
        mode,
        output["position"],
        str(output["scale"]),
        str(output["transform"]),
        str(output.get("bitdepth", DEFAULT_BITDEPTH)),
        workspaces,
    ))

leftover = [c for cs in available.values() for c in cs]
if leftover:
    print(
        "connected outputs not covered by this profile: "
        + ", ".join(leftover),
        file=sys.stderr,
    )
    sys.exit(1)

for row in plan:
    print("\t".join(row))
PY
}

# Re-applying a mode an output already holds still takes it
# down and brings it back, which blanks every screen for a
# second on any reload that ends up here.
already_configured() {
    local connector="$1" mode="$2" position="$3" scale="$4"
    local transform="$5"
    current_monitors_json 2>/dev/null | python3 -c 'import json, sys
connector, mode, position, scale, transform = sys.argv[1:6]
wanted_size, _, wanted_refresh = mode.partition("@")
REFRESH_TOLERANCE = 0.5
SCALE_TOLERANCE = 0.001
for live in json.load(sys.stdin):
    if live["name"] != connector:
        continue
    size = str(live["width"]) + "x" + str(live["height"])
    at = str(live["x"]) + "x" + str(live["y"])
    same = (
        size == wanted_size
        and at == position
        and abs(float(live["scale"]) - float(scale))
            < SCALE_TOLERANCE
        and int(live["transform"]) == int(transform)
    )
    if same and wanted_refresh:
        same = (abs(live["refreshRate"] - float(wanted_refresh))
            < REFRESH_TOLERANCE)
    sys.exit(0 if same else 1)
sys.exit(1)' \
        "${connector}" "${mode}" "${position}" "${scale}" \
        "${transform}" 2>/dev/null
}

apply_plan() {
    local plan="$1" dry_run="$2" only_changed="${3:-false}"
    local connector mode position scale transform bitdepth
    local workspaces
    while IFS=$'\t' read -r connector mode position scale \
        transform bitdepth workspaces; do
        [[ -n "${connector}" ]] || continue
        local monitor_call
        monitor_call="hl.monitor({ output = \"${connector}\""
        monitor_call+=", mode = \"${mode}\""
        monitor_call+=", position = \"${position}\""
        monitor_call+=", scale = ${scale}"
        monitor_call+=", transform = ${transform}"
        monitor_call+=", bitdepth = ${bitdepth} })"

        if [[ "${only_changed}" != "true" ]] \
            || ! already_configured "${connector}" "${mode}" \
                "${position}" "${scale}" "${transform}"; then
            eval_lua "${monitor_call}" \
                "configuring ${connector}" "${dry_run}"
        fi

        local ws_ids=() workspace_id
        IFS=',' read -ra ws_ids <<<"${workspaces}"
        for workspace_id in "${ws_ids[@]}"; do
            [[ -n "${workspace_id}" ]] || continue
            move_workspace "${workspace_id}" "${connector}" \
                "${dry_run}"
        done
    done <<<"${plan}"
}

cmd_save() {
    local name="$1"
    valid_name "${name}"
    mkdir -p "${PROFILES_DIR}"

    local monitors_json workspaces_json draft
    monitors_json=$(new_tmp_file)
    workspaces_json=$(new_tmp_file)
    draft=$(new_tmp_file)

    current_monitors_json >"${monitors_json}"
    current_workspaces_json >"${workspaces_json}"

    python3 - "${monitors_json}" "${workspaces_json}" \
        >"${draft}" <<'PY'
import json
import sys

DEFAULT_BITDEPTH = 8

# Hyprland reports the depth it settled on as a buffer format
# rather than the number the monitor rule asks for.
BITDEPTH_BY_FORMAT = {
    "XRGB2101010": 10,
    "ARGB2101010": 10,
    "XBGR2101010": 10,
    "ABGR2101010": 10,
}

monitors = json.load(open(sys.argv[1]))
workspaces = json.load(open(sys.argv[2]))

outputs = []
for monitor in monitors:
    description = monitor["description"]
    if not description:
        sys.exit(
            "output " + monitor["name"] + " reports no "
            "description; refusing to save a profile that "
            "could never be matched back to it"
        )
    workspace_ids = sorted(
        w["id"] for w in workspaces
        if w["monitor"] == monitor["name"] and w["id"] > 0
    )
    outputs.append({
        "description": description,
        "resolution": (
            f'{monitor["width"]}x{monitor["height"]}'
        ),
        "refresh_rate": monitor["refreshRate"],
        "position": f'{monitor["x"]}x{monitor["y"]}',
        "scale": monitor["scale"],
        "transform": monitor["transform"],
        "bitdepth": BITDEPTH_BY_FORMAT.get(
            monitor["currentFormat"], DEFAULT_BITDEPTH
        ),
        "workspaces": workspace_ids,
    })

json.dump({"outputs": outputs}, sys.stdout, indent=2)
print()
PY

    mv "${draft}" "$(profile_path "${name}")"
    echo "monitor-profile: saved '${name}' to" \
        "$(profile_path "${name}")"
}

cmd_list() {
    mkdir -p "${PROFILES_DIR}"
    local monitors_json
    monitors_json=$(new_tmp_file)
    current_monitors_json >"${monitors_json}"

    printf '%-24s %-8s %s\n' NAME OUTPUTS STATUS
    local profile found=0 name outputs status
    for profile in "${PROFILES_DIR}"/*.json; do
        [[ -e "${profile}" ]] || break
        found=1
        name=$(basename "${profile}" .json)
        outputs=$(python3 -c '
import json, sys
print(len(json.load(open(sys.argv[1]))["outputs"]))
' "${profile}")
        if resolve_plan "${profile}" "${monitors_json}" \
            >/dev/null 2>&1; then
            status="connected"
        else
            status="-"
        fi
        printf '%-24s %-8s %s\n' "${name}" "${outputs}" \
            "${status}"
    done

    [[ "${found}" -eq 1 ]] || echo \
        "no saved profiles yet (monitor-profile save <name>)"
}

cmd_apply() {
    local name="$1" dry_run="$2"
    local profile
    profile=$(profile_path "${name}")
    [[ -r "${profile}" ]] || die \
        "no saved profile named '${name}'" \
        "(looked in ${PROFILES_DIR})"

    local monitors_json plan
    monitors_json=$(new_tmp_file)
    current_monitors_json >"${monitors_json}"

    if ! plan=$(resolve_plan "${profile}" "${monitors_json}")
    then
        die "profile '${name}' does not match the outputs" \
            "currently connected (see reason above)"
    fi
    apply_plan "${plan}" "${dry_run}"
}

cmd_detect() {
    local dry_run="$1"
    mkdir -p "${PROFILES_DIR}"
    local monitors_json
    monitors_json=$(new_tmp_file)
    current_monitors_json >"${monitors_json}"

    local profile name plan
    for profile in "${PROFILES_DIR}"/*.json; do
        [[ -e "${profile}" ]] || break
        if plan=$(resolve_plan "${profile}" \
            "${monitors_json}" 2>/dev/null); then
            name=$(basename "${profile}" .json)
            echo "monitor-profile: applying '${name}'"
            apply_plan "${plan}" "${dry_run}" true
            return 0
        fi
    done

    echo "monitor-profile: no saved profile matches the" \
        "currently connected outputs" >&2
}

cmd_reflow() {
    local dry_run="$1"
    local monitors_json
    monitors_json=$(new_tmp_file)
    current_monitors_json >"${monitors_json}"

    if ! python3 -c '
import json, sys
monitors = json.load(open(sys.argv[1]))
sys.exit(0 if any(not m["disabled"] for m in monitors) else 1)
' "${monitors_json}"; then
        if [[ "${dry_run}" == "true" ]]; then
            echo "[dry-run] ${BIN_DIR}/donbox-lid open"
        else
            "${BIN_DIR}/donbox-lid" open
        fi
        current_monitors_json >"${monitors_json}"
    fi

    local workspaces_json
    workspaces_json=$(new_tmp_file)
    current_workspaces_json >"${workspaces_json}"

    local strays
    strays=$(python3 - "${monitors_json}" \
        "${workspaces_json}" <<'PY'
import json
import sys

monitors = json.load(open(sys.argv[1]))
workspaces = json.load(open(sys.argv[2]))

live = {m["name"] for m in monitors if not m["disabled"]}
for workspace in workspaces:
    if workspace["id"] > 0 and workspace["monitor"] not in live:
        print(workspace["id"])
PY
    )

    [[ -n "${strays}" ]] || return 0

    local workspace_id
    while IFS= read -r workspace_id; do
        [[ -n "${workspace_id}" ]] || continue
        move_workspace "${workspace_id}" "${PANEL_OUTPUT}" \
            "${dry_run}"
    done <<<"${strays}"

    echo "monitor-profile: rehomed stray workspace(s) to" \
        "${PANEL_OUTPUT}: $(tr '\n' ' ' <<<"${strays}")"
}

parse_dry_run() {
    case "${1:-}" in
        --dry-run) echo "true" ;;
        "") echo "false" ;;
        *) usage ;;
    esac
}

main() {
    local action="${1:-}"
    [[ -n "${action}" ]] || usage
    shift

    case "${action}" in
        save)
            [[ $# -eq 1 ]] || usage
            cmd_save "$1"
            ;;
        apply)
            [[ $# -ge 1 && $# -le 2 ]] || usage
            cmd_apply "$1" "$(parse_dry_run "${2:-}")"
            ;;
        list)
            [[ $# -eq 0 ]] || usage
            cmd_list
            ;;
        detect)
            [[ $# -le 1 ]] || usage
            cmd_detect "$(parse_dry_run "${1:-}")"
            ;;
        reflow)
            [[ $# -le 1 ]] || usage
            cmd_reflow "$(parse_dry_run "${1:-}")"
            ;;
        *)
            usage
            ;;
    esac
}

main "$@"
