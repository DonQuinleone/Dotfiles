#!/usr/bin/env bash
set -euo pipefail

# A terminal opened from inside a tmux pane inherits TMUX, and
# tmux then refuses to nest, although the new window is its own
# terminal and no nesting is involved.
unset TMUX

# Closing the window only detaches the client; the session is
# the window's, so it goes with it.
exec tmux new-session -- "$@" \; set-option destroy-unattached on
