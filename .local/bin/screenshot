#!/usr/bin/env bash
set -euo pipefail

readonly SAVE_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots"
readonly ACTION=${1:-copy-region}

copy_region() {
    flameshot gui --clipboard
}

copy_screen() {
    flameshot full --clipboard
}

save_region() {
    flameshot gui --path "$SAVE_DIR"
}

save_screen() {
    flameshot full --path "$SAVE_DIR"
}

annotate() {
    flameshot gui --path "$SAVE_DIR" --clipboard
}

read_text() {
    local shot region
    region=$(slurp) || exit 0
    shot=$(mktemp --suffix=.png)
    trap 'rm -f "$shot"' EXIT
    grim -g "$region" "$shot"
    tesseract "$shot" - 2>/dev/null | wl-copy
    notify-send -a screenshot -t 2000 "Text copied"
}

declare -rA ACTIONS=(
    [copy-region]=copy_region
    [copy-screen]=copy_screen
    [save-region]=save_region
    [save-screen]=save_screen
    [annotate]=annotate
    [text]=read_text
)

handler=${ACTIONS[$ACTION]:-}

[ -n "$handler" ] || {
    printf 'usage: %s %s\n' "${0##*/}" \
        "copy-region|copy-screen|save-region|save-screen|annotate|text" >&2
    exit 2
}

mkdir -p "$SAVE_DIR"

"$handler"
