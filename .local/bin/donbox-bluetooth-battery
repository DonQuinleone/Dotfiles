#!/usr/bin/env bash
# donbox:summary=Report a device's battery levels
# donbox:args=<address>
# donbox:hidden=true
set -euo pipefail

# BlueZ's Battery1 interface carries one percentage per device,
# so a split keyboard reporting each half separately has nowhere
# to put the second reading. Both halves are there in GATT
# though, as repeated Battery Level characteristics under the
# Battery Service, which is what this reads. Battery1 is the
# fallback for everything that reports a single cell.

readonly SERVICE_UUID=0000180f-0000-1000-8000-00805f9b34fb
readonly LEVEL_UUID=00002a19-0000-1000-8000-00805f9b34fb
readonly LABEL_UUID=00002901-0000-1000-8000-00805f9b34fb

readonly BLUEZ=org.bluez
readonly DEVICE_IFACE=org.bluez.Device1
readonly BATTERY_IFACE=org.bluez.Battery1
readonly SERVICE_IFACE=org.bluez.GattService1
readonly CHAR_IFACE=org.bluez.GattCharacteristic1
readonly DESC_IFACE=org.bluez.GattDescriptor1

die() {
    printf 'donbox bluetooth battery: %s\n' "$1" >&2
    exit 1
}

command -v busctl >/dev/null 2>&1 || die "busctl not found"

tree_paths() {
    busctl tree "$BLUEZ" 2>/dev/null |
        grep -oE '/org/bluez/[a-zA-Z0-9_/]+' || true
}

# busctl prints a property as its signature then its value, so
# the type letter and the surrounding quotes come off here.
property() {
    local path=$1 iface=$2 name=$3 raw
    raw=$(busctl get-property "$BLUEZ" "$path" "$iface" "$name" \
        2>/dev/null) || return 1
    printf '%s\n' "${raw#* }" | tr -d '"'
}

# ReadValue answers "ay N b1 b2 ...", so the count is dropped and
# the bytes are left one per line for the caller to interpret.
read_value() {
    local path=$1 iface=$2 raw
    raw=$(busctl call "$BLUEZ" "$path" "$iface" ReadValue 'a{sv}' 0 \
        2>/dev/null) || return 1
    printf '%s\n' "$raw" | tr ' ' '\n' | tail -n +3
}

first_byte() {
    local path=$1 bytes
    bytes=$(read_value "$path" "$CHAR_IFACE") || return 1
    printf '%s\n' "$bytes" | head -1 | grep -E '^[0-9]+$' || return 1
}

# A descriptor holding the name of a cell is optional, and a
# device that omits it leaves the label empty for the caller to
# fill in by position.
label_of() {
    local char=$1 desc uuid bytes text
    for desc in $(tree_paths | grep -E "^${char}/desc[0-9a-f]+$"); do
        uuid=$(property "$desc" "$DESC_IFACE" UUID) || continue
        [ "$uuid" = "$LABEL_UUID" ] || continue
        bytes=$(read_value "$desc" "$DESC_IFACE") || continue
        text=$(printf '%s\n' "$bytes" | while read -r byte; do
            [ -n "$byte" ] && printf '\\x%02x' "$byte"
        done)
        printf '%b' "$text" | tr -cd '[:print:]' | tr -d '"'\\\\
        return 0
    done
    printf ''
}

cells_of_device() {
    local device=$1 service uuid char level label found=0
    for service in $(tree_paths |
        grep -E "^${device}/service[0-9a-f]+$"); do
        uuid=$(property "$service" "$SERVICE_IFACE" UUID) || continue
        [ "$uuid" = "$SERVICE_UUID" ] || continue
        for char in $(tree_paths |
            grep -E "^${service}/char[0-9a-f]+$"); do
            uuid=$(property "$char" "$CHAR_IFACE" UUID) || continue
            [ "$uuid" = "$LEVEL_UUID" ] || continue
            level=$(first_byte "$char") || continue
            label=$(label_of "$char")
            [ "$found" -gt 0 ] && printf ','
            printf '{"label":"%s","percent":%s}' "$label" "$level"
            found=1
        done
    done
    [ "$found" -gt 0 ] && return 0
    level=$(property "$device" "$BATTERY_IFACE" Percentage) || return 1
    printf '{"label":"","percent":%s}' "$level"
}

main() {
    local device address cells first=1
    printf '{"devices":['
    for device in $(tree_paths |
        grep -E '^/org/bluez/[a-z0-9]+/dev(_[0-9A-Fa-f]{2}){6}$'); do
        [ "$(property "$device" "$DEVICE_IFACE" Connected)" = true ] ||
            continue
        cells=$(cells_of_device "$device") || continue
        address=$(property "$device" "$DEVICE_IFACE" Address) ||
            continue
        [ "$first" -eq 0 ] && printf ','
        printf '{"address":"%s","cells":[%s]}' "$address" "$cells"
        first=0
    done
    printf ']}\n'
}

main "$@"
