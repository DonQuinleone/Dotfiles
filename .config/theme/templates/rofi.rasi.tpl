* {
    background:     {{ background }};
    background-alt: {{ lighter_background }};
    foreground:     {{ foreground }};
    foreground-dim: {{ dark_foreground }};
    muted:          {{ muted }};
    accent:         {{ accent }};
    urgent:         {{ red }};
    selection:      {{ selection }};
    font:           "{{ theme_font_ui }} {{ theme_size_ui }}";
}
