#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly SCRIPT_DIR
readonly MODULE_DIR="${SCRIPT_DIR}/theme.d"
TEMPLATE_DIR=$(dirname "${SCRIPT_DIR}")/themes
readonly TEMPLATE_DIR

# shellcheck source=theme.d/common.sh
source "${MODULE_DIR}/common.sh"
# shellcheck source=theme.d/contrast.sh
source "${MODULE_DIR}/contrast.sh"
# shellcheck source=theme.d/accents.sh
source "${MODULE_DIR}/accents.sh"
# shellcheck source=theme.d/quickshell.sh
source "${MODULE_DIR}/quickshell.sh"
# shellcheck source=theme.d/hyprland.sh
source "${MODULE_DIR}/hyprland.sh"
# shellcheck source=theme.d/ghostty.sh
source "${MODULE_DIR}/ghostty.sh"
# shellcheck source=theme.d/icons.sh
source "${MODULE_DIR}/icons.sh"
# shellcheck source=theme.d/gtk.sh
source "${MODULE_DIR}/gtk.sh"
# shellcheck source=theme.d/qt.sh
source "${MODULE_DIR}/qt.sh"
# shellcheck source=theme.d/teamspeak.sh
source "${MODULE_DIR}/teamspeak.sh"
# shellcheck source=theme.d/mozilla.sh
source "${MODULE_DIR}/mozilla.sh"
# shellcheck source=theme.d/firefox.sh
source "${MODULE_DIR}/firefox.sh"
# shellcheck source=theme.d/thunderbird.sh
source "${MODULE_DIR}/thunderbird.sh"
# shellcheck source=theme.d/nvim.sh
source "${MODULE_DIR}/nvim.sh"
# shellcheck source=theme.d/fastfetch.sh
source "${MODULE_DIR}/fastfetch.sh"
# shellcheck source=theme.d/shell.sh
source "${MODULE_DIR}/shell.sh"

readonly SLUG_COLUMN_WIDTH=20

readonly LIVE_APPLIERS=(
    apply_quickshell
    apply_hyprland
)

readonly DEFERRED_APPLIERS=(
    apply_ghostty
    apply_icons
    apply_gtk
    apply_qt
    apply_teamspeak
    apply_firefox
    apply_thunderbird
    apply_nvim
    apply_fastfetch
    apply_shell
)

declare -rA COMMANDS=(
    [list]=cmd_list
    [current]=cmd_current
    [set]=cmd_set
    [accent]=cmd_accent
    [preview]=cmd_preview
    [preview-accent]=cmd_preview_accent
    [wallpaper]=cmd_wallpaper
)

usage() {
    cat >&2 <<'EOF'
usage: theme list
       theme current
       theme set <name>
       theme accent [name]
       theme preview <name>
       theme preview-accent <name>
       theme wallpaper [path]
EOF
    exit 1
}

run_appliers() {
    local applier
    for applier in "$@"; do
        "${applier}"
    done
}

apply_live_surfaces() {
    mkdir -p "${STATE_DIR}" "${WALLPAPER_STATE_DIR}"
    run_appliers "${LIVE_APPLIERS[@]}"
}

apply_every_surface() {
    apply_live_surfaces
    run_appliers "${DEFERRED_APPLIERS[@]}"
}

cmd_list() {
    (($# == 0)) || usage
    local active slug marker name slugs=()
    active=$(active_slug)
    mapfile -t slugs < <(theme_slugs)
    ((${#slugs[@]} > 0)) ||
        die "no theme files in ${THEME_JSON_DIR}"
    for slug in "${slugs[@]}"; do
        marker=" "
        [[ "${slug}" == "${active}" ]] && marker="*"
        name=$(jq -r '.name // ""' \
            "${THEME_JSON_DIR}/${slug}.json")
        printf "%s %-${SLUG_COLUMN_WIDTH}s %s\n" \
            "${marker}" "${slug}" "${name}"
    done
}

cmd_current() {
    (($# == 0)) || usage
    active_slug
}

cmd_set() {
    (($# == 1)) || usage
    select_theme "$1"
    warn_unreadable_accent
    apply_every_surface
    printf '%s\n' "${THEME_SLUG}" >"${ACTIVE_NAME_FILE}"
}

cmd_accent() {
    (($# <= 1)) || usage
    local slug
    slug=$(active_slug)
    if (($# == 0)); then
        select_theme "${slug}"
        list_accents
        return
    fi
    ACCENT_REQUEST="$1"
    select_theme "${slug}"
    [[ "${ACCENT_NAME}" == "$1" ]] ||
        die "no '$1' accent in ${slug}; try: theme accent"
    require_readable_accent
    store_accent "${slug}" "${ACCENT_NAME}"
    apply_every_surface
}

cmd_preview() {
    (($# == 1)) || usage
    select_theme "$1"
    apply_live_surfaces
}

cmd_preview_accent() {
    (($# == 1)) || usage
    ACCENT_REQUEST="$1"
    select_theme "$(active_slug)"
    apply_live_surfaces
}

random_wallpaper() {
    local directory="${WALLPAPER_ROOT}/$1" choice
    [[ -d "${directory}" ]] ||
        die "no wallpaper directory ${directory}"
    choice=$(find "${directory}" -maxdepth 1 -type f -print0 |
        shuf -z -n 1 | tr -d '\0')
    [[ -n "${choice}" ]] ||
        die "no wallpapers in ${directory}"
    printf '%s\n' "${choice}"
}

cmd_wallpaper() {
    (($# <= 1)) || usage
    local slug chosen
    slug=$(active_slug)
    chosen="${1:-$(random_wallpaper "${slug}")}"
    [[ -f "${chosen}" ]] ||
        die "no such wallpaper: ${chosen}"
    mkdir -p "${WALLPAPER_STATE_DIR}"
    printf '%s\n' "${chosen}" \
        >"$(wallpaper_override_file "${slug}")"
    select_theme "${slug}"
    apply_quickshell
}

main() {
    require_command jq
    (($# >= 1)) || usage
    local command="$1" handler
    shift
    handler="${COMMANDS[${command}]:-}"
    [[ -n "${handler}" ]] || usage
    "${handler}" "$@"
}

main "$@"
