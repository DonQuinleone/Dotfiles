#!/usr/bin/env bash
set -euo pipefail

readonly SECRET_SERVICE=donbox-agent
readonly SHARED_ENTRY=shared
readonly SECRETS_BUS=org.freedesktop.secrets
readonly LOGIN_COLLECTION=/org/freedesktop/secrets/collection/login
readonly COLLECTION_INTERFACE=org.freedesktop.Secret.Collection
readonly UNLOCKED_PROPERTY='b false'

die() {
    printf 'unlock-keys: %s\n' "$1" >&2
    exit 1
}

say() {
    printf 'unlock-keys: %s\n' "$1"
}

require() {
    command -v "$1" >/dev/null 2>&1 || die "$1 is not installed"
}

require gpgconf
require gpg-connect-agent
require secret-tool
require busctl

PRESET="$(gpgconf --list-dirs libexecdir)/gpg-preset-passphrase"
KEY_DIR="$(gpgconf --list-dirs homedir)/private-keys-v1.d"
readonly PRESET KEY_DIR

[[ -x "${PRESET}" ]] ||
    die "${PRESET} is missing; install gnupg2-gpg-agent"

keygrips() {
    local key
    for key in "${KEY_DIR}"/*.key; do
        [[ -e "${key}" ]] || return 0
        key="${key##*/}"
        printf '%s\n' "${key%.key}"
    done
}

agent_answers() {
    gpg-connect-agent /bye >/dev/null 2>&1
}

# A locked collection would make secret-tool raise an unlock
# dialogue of its own, which is the prompt this exists to avoid.
keyring_unlocked() {
    local state
    state="$(busctl --user get-property "${SECRETS_BUS}" \
        "${LOGIN_COLLECTION}" "${COLLECTION_INTERFACE}" Locked \
        2>/dev/null)" || return 1
    [[ "${state}" == "${UNLOCKED_PROPERTY}" ]]
}

lookup_secret() {
    secret-tool lookup service "${SECRET_SERVICE}" keygrip "$1" \
        2>/dev/null || true
}

passphrase_for() {
    local secret
    secret="$(lookup_secret "$1")"
    if [[ -z "${secret}" ]]; then
        secret="$(lookup_secret "${SHARED_ENTRY}")"
    fi
    printf '%s' "${secret}"
}

apply() {
    agent_answers || die "gpg-agent is not answering"
    keyring_unlocked ||
        die "the login keyring is locked; sign in with your \
password rather than your fingerprint"

    local keygrip secret unlocked=0
    while read -r keygrip; do
        secret="$(passphrase_for "${keygrip}")"
        [[ -n "${secret}" ]] || continue
        printf '%s\n' "${secret}" |
            "${PRESET}" --preset "${keygrip}" ||
            die "gpg-agent refused a preset, so it predates \
allow-preset-passphrase; run gpgconf --kill gpg-agent"
        unlocked=$((unlocked + 1))
    done < <(keygrips)

    [[ "${unlocked}" -gt 0 ]] ||
        die "no stored passphrase matches a key in ${KEY_DIR}"
    say "unlocked ${unlocked} key(s) for this session"
}

# gpg-preset-passphrase --forget answers "No inquire callback in
# IPC" on GnuPG 2.4.9, so the cache is cleared over the protocol.
forget() {
    agent_answers || return 0
    local keygrip
    while read -r keygrip; do
        gpg-connect-agent \
            "CLEAR_PASSPHRASE --mode=normal ${keygrip}" /bye \
            >/dev/null 2>&1 || true
    done < <(keygrips)
    say "cleared the presets"
}

store() {
    local keygrip="${1:-${SHARED_ENTRY}}"
    secret-tool store --label="donbox agent passphrase" \
        service "${SECRET_SERVICE}" keygrip "${keygrip}"
    say "stored a passphrase for ${keygrip}"
}

case "${1:-apply}" in
    apply) apply ;;
    forget) forget ;;
    store) store "${2:-}" ;;
    list) keygrips ;;
    *) die "usage: unlock-keys [apply|forget|store [keygrip]|list]" ;;
esac
