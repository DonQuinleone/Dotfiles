set -g status-style \
    "bg={{ dark_background }},fg={{ dark_foreground }}"
set -g status-left-style \
    "bg={{ accent }},fg={{ background }},bold"
set -g status-right-style \
    "bg={{ dark_background }},fg={{ dark_foreground }}"
set -g window-status-current-style \
    "bg={{ lighter_background }},fg={{ foreground }},bold"
set -g window-status-style \
    "bg={{ dark_background }},fg={{ dark_foreground }}"
set -g window-status-activity-style "fg={{ yellow }}"
set -g window-status-bell-style "fg={{ red }}"
set -g pane-border-style "fg={{ muted }}"
set -g pane-active-border-style "fg={{ accent }}"
set -g message-style \
    "bg={{ lighter_background }},fg={{ foreground }}"
set -g message-command-style \
    "bg={{ lighter_background }},fg={{ foreground }}"
set -g mode-style "bg={{ accent }},fg={{ background }}"
set -g copy-mode-match-style "bg={{ yellow }},fg={{ background }}"
set -g copy-mode-current-match-style \
    "bg={{ accent }},fg={{ background }}"
set -g clock-mode-colour "{{ accent }}"
