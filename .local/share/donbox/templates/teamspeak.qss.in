QWidget {
	background-color: @bg@;
	color: @fg@;
	selection-background-color: @accent@;
	selection-color: @onAccent@;
}

QMainWindow, QDialog, QFrame {
	background-color: @bg@;
}

QWidget:disabled {
	color: @fgFaint@;
}

QMenuBar {
	background-color: @bg@;
	border-bottom: 1px solid @border@;
}

QMenuBar::item {
	background: transparent;
	padding: 4px 10px;
}

QMenuBar::item:selected {
	background-color: @surface@;
	color: @fg@;
}

QMenuBar::item:pressed {
	background-color: @accent@;
	color: @onAccent@;
}

QMenu {
	background-color: @bgAlt@;
	border: 1px solid @border@;
	padding: 4px;
}

QMenu::item {
	padding: 5px 24px 5px 24px;
	background: transparent;
}

QMenu::item:selected {
	background-color: @accent@;
	color: @onAccent@;
}

QMenu::item:disabled {
	color: @fgFaint@;
}

QMenu::separator {
	height: 1px;
	background-color: @border@;
	margin: 4px 8px;
}

QToolBar {
	background-color: @bg@;
	border: none;
	spacing: 2px;
	padding: 2px;
}

QToolBar::separator {
	width: 1px;
	background-color: @border@;
	margin: 4px 4px;
}

QToolButton {
	background: transparent;
	border: 1px solid transparent;
	border-radius: 4px;
	padding: 3px;
}

QToolButton:hover {
	background-color: @surface@;
	border: 1px solid @borderStrong@;
}

QToolButton:pressed, QToolButton:checked {
	background-color: @accent@;
	border: 1px solid @accent@;
}

QPushButton {
	background-color: @surface@;
	border: 1px solid @borderStrong@;
	border-radius: 4px;
	padding: 5px 14px;
	min-height: 16px;
}

QPushButton:hover {
	background-color: @borderStrong@;
	border-color: @fgFaint@;
}

QPushButton:pressed {
	background-color: @fgFaint@;
}

QPushButton:default {
	background-color: @accent@;
	border-color: @accent@;
	color: @onAccent@;
	font-weight: bold;
}

QPushButton:default:hover {
	background-color: @accentDim@;
	border-color: @accentDim@;
}

QPushButton:default:pressed {
	background-color: @accentDark@;
}

QPushButton:disabled {
	background-color: @surface@;
	border-color: @border@;
	color: @fgFaint@;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
	background-color: @bgAlt@;
	border: 1px solid @border@;
	border-radius: 4px;
	padding: 4px;
	color: @fg@;
	selection-background-color: @accent@;
	selection-color: @onAccent@;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
	border: 1px solid @accent@;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
	background-color: @bgAlt@;
	color: @fgFaint@;
}

QComboBox {
	background-color: @surface@;
	border: 1px solid @borderStrong@;
	border-radius: 4px;
	padding: 4px 8px;
	min-height: 18px;
}

QComboBox:hover {
	background-color: @borderStrong@;
}

QComboBox:focus {
	border: 1px solid @accent@;
}

QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: center right;
	width: 18px;
	border-left: 1px solid @borderStrong@;
}

QComboBox QAbstractItemView {
	background-color: @bgAlt@;
	border: 1px solid @border@;
	selection-background-color: @accent@;
	selection-color: @onAccent@;
	outline: none;
}

QTreeView, QTableView, QListView, QListWidget, QTreeWidget,
QTableWidget {
	background-color: @bg@;
	alternate-background-color: @bgAlt@;
	border: 1px solid @border@;
	outline: none;
}

QTreeView::item, QTableView::item, QListView::item {
	padding: 2px;
	border: none;
}

QTreeView::item:hover, QTableView::item:hover,
QListView::item:hover {
	background-color: @surface@;
}

QTreeView::item:selected, QTableView::item:selected,
QListView::item:selected {
	background-color: @accent@;
	color: @onAccent@;
}

QTreeView#ServerTreeView {
	background-color: @bg@;
	alternate-background-color: transparent;
	border: none;
}

QHeaderView::section {
	background-color: @bgAlt@;
	color: @fg@;
	border: none;
	border-right: 1px solid @border@;
	border-bottom: 1px solid @border@;
	padding: 4px 6px;
}

QHeaderView::section:hover {
	background-color: @surface@;
}

QTabWidget::pane {
	border: 1px solid @border@;
	background-color: @bg@;
	top: -1px;
}

QTabBar::tab, ImprovedTabBar::tab {
	background-color: @bgAlt@;
	color: @fgDim@;
	border: 1px solid @border@;
	border-bottom: none;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	padding: 6px 12px;
	margin-right: 2px;
}

QTabBar::tab:hover, ImprovedTabBar::tab:hover {
	background-color: @surface@;
	color: @fg@;
}

QTabBar::tab:selected, ImprovedTabBar::tab:selected {
	background-color: @bg@;
	color: @accent@;
	border-bottom: 2px solid @accent@;
}

QScrollBar:vertical {
	background-color: @bg@;
	width: 12px;
	margin: 0px;
	border: none;
}

QScrollBar::handle:vertical {
	background-color: @border@;
	border-radius: 5px;
	min-height: 24px;
	margin: 2px;
}

QScrollBar::handle:vertical:hover {
	background-color: @borderStrong@;
}

QScrollBar:horizontal {
	background-color: @bg@;
	height: 12px;
	margin: 0px;
	border: none;
}

QScrollBar::handle:horizontal {
	background-color: @border@;
	border-radius: 5px;
	min-width: 24px;
	margin: 2px;
}

QScrollBar::handle:horizontal:hover {
	background-color: @borderStrong@;
}

QScrollBar::add-line, QScrollBar::sub-line {
	height: 0px;
	width: 0px;
	border: none;
	background: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
	background: none;
}

QGroupBox {
	border: 1px solid @border@;
	border-radius: 4px;
	margin-top: 10px;
	padding-top: 8px;
	font-weight: bold;
}

QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 10px;
	padding: 0px 4px;
	color: @accent@;
}

QCheckBox, QRadioButton {
	spacing: 6px;
	background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
	width: 15px;
	height: 15px;
	border: 1px solid @fgFaint@;
	background-color: @bgAlt@;
}

QCheckBox::indicator {
	border-radius: 3px;
}

QRadioButton::indicator {
	border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
	border-color: @accent@;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
	background-color: @accent@;
	border-color: @accent@;
}

QStatusBar {
	background-color: @bg@;
	border-top: 1px solid @border@;
	color: @fgDim@;
}

QStatusBar QLabel {
	padding: 0px 3px;
	border: 0px;
	background: transparent;
}

QToolTip {
	background-color: @bgAlt@;
	color: @fg@;
	border: 1px solid @accent@;
	padding: 4px;
}

QProgressBar {
	background-color: @bgAlt@;
	border: 1px solid @border@;
	border-radius: 4px;
	text-align: center;
	color: @fg@;
}

QProgressBar::chunk {
	background-color: @accent@;
	border-radius: 3px;
}

QSlider::groove:horizontal {
	background-color: @surface@;
	height: 4px;
	border-radius: 2px;
}

QSlider::sub-page:horizontal {
	background-color: @accent@;
	border-radius: 2px;
}

QSlider::handle:horizontal {
	background-color: @fg@;
	width: 14px;
	height: 14px;
	margin: -6px 0px;
	border-radius: 7px;
}

QSlider::handle:horizontal:hover {
	background-color: @accent@;
}

QSplitter::handle {
	background-color: @border@;
}

QSplitter::handle:hover {
	background-color: @accent@;
}

QTextEdit#InfoFrame, QTextEdit#ChatTab {
	background-color: @bg@;
	background-image: none;
	border: 1px solid @border@;
}

QTextEdit#ChatLineEdit[helpTextVisible="true"] {
	color: @fgDim@;
}

QLabel#OptionsHeadlineTitleLabel {
	font: 18px 'TeamSpeak 2020';
	color: @accent@;
	background: transparent;
}

QLabel#OptionsHeadlineDescriptionLabel {
	color: @fgDim@;
	background: transparent;
}

QLabel#appNameLabel {
	color: @accent@;
	text-transform: lowercase;
	font: 32px 'TeamSpeak 2020';
	font-weight: bold;
	background: transparent;
}

QWidget#HeadlineLabel {
	background-color: @bgAlt@;
	border-bottom: 1px solid @border@;
}

QLabel#bookmarksBanner, QLabel#identitiesBanner,
QLabel#accountLoginBanner, QLabel#accountCreateBanner {
	background: @bgAlt@;
	border-left: 3px solid @accent@;
	color: @fg@;
	padding-left: 6px;
	font-weight: bold;
	qproperty-minimumSize: 0px 32px;
}

QListWidget#localIconsListWidget::item:selected,
QListWidget#remoteIconsListWidget::item:selected {
	border: 1px solid @accent@;
}

com--teamspeak--ui--ServerIntegrationsWidget
QWidget#ExistingServerIntegration,
com--teamspeak--ui--ServerIntegrationsWidget
QWidget#AvailableServerIntegration {
	background: @bgAlt@;
}

com--teamspeak--ui--ServerIntegrationsWidget
com--teamspeak--ui--IntegrationResponseWidget {
	background: @bg@;
	border: 1px solid @border@;
	border-radius: 2px;
}

com--teamspeak--ui--ServerIntegrationsWidget
com--teamspeak--ui--IntegrationBubble {
	background: @bgAlt@;
	border: 1px solid @border@;
	border-radius: 2px;
}

com--teamspeak--ui--IntegrationBubbleEditable
QComboBox#IntegrationBubbleEditableComboBox {
	border: 2px groove @accent@;
	background: @bgAlt@;
	padding: 0px 9px 1px 9px;
}
