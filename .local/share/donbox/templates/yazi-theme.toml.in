[mgr]
cwd = { fg = "@accent@" }
find_keyword = { fg = "@warn@", bold = true }
find_position = { fg = "@fgDim@" }
symlink_target = { fg = "@fgDim@", italic = true }
marker_copied = { fg = "@good@", bg = "@good@" }
marker_cut = { fg = "@bad@", bg = "@bad@" }
marker_marked = { fg = "@accent@", bg = "@accent@" }
marker_selected = { fg = "@accent@", bg = "@accent@" }
count_copied = { fg = "@onGood@", bg = "@good@" }
count_cut = { fg = "@onBad@", bg = "@bad@" }
count_selected = { fg = "@onAccent@", bg = "@accent@" }
border_style = { fg = "@border@" }

[mode]
normal_main = { fg = "@onAccent@", bg = "@accent@", bold = true }
normal_alt = { fg = "@accent@", bg = "@surface@" }
select_main = { fg = "@onGood@", bg = "@good@", bold = true }
select_alt = { fg = "@good@", bg = "@surface@" }
unset_main = { fg = "@onWarn@", bg = "@warn@", bold = true }
unset_alt = { fg = "@warn@", bg = "@surface@" }

[status]
overall = { fg = "@fg@", bg = "@surface@" }
progress_label = { fg = "@fg@", bold = true }
progress_normal = { fg = "@accent@", bg = "@surface@" }
progress_error = { fg = "@bad@", bg = "@surface@" }

[tabs]
active = { fg = "@onAccent@", bg = "@accent@", bold = true }
inactive = { fg = "@fgDim@", bg = "@surface@" }

[input]
border = { fg = "@accent@" }
title = { fg = "@fg@" }
value = { fg = "@fg@" }
selected = { fg = "@onAccent@", bg = "@accent@" }

[cmp]
border = { fg = "@accent@" }
active = { fg = "@onAccent@", bg = "@accent@" }
inactive = { fg = "@fg@" }

[tasks]
border = { fg = "@accent@" }
title = { fg = "@fg@" }
hovered = { fg = "@onAccent@", bg = "@accent@" }

[help]
on = { fg = "@accent@" }
run = { fg = "@good@" }
desc = { fg = "@fg@" }
hovered = { fg = "@onAccent@", bg = "@accent@", bold = true }
footer = { fg = "@fg@", bg = "@surface@" }
