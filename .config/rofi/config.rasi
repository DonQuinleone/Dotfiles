configuration {
    modes: "drun,run,window";
    show-icons: true;
    icon-theme: "Adwaita";
    drun-display-format: "{name}";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
}

@theme "~/.config/rofi/theme.rasi"
