#!/usr/bin/env bash
set -euo pipefail

readonly PREFIX=donbox
readonly HEADER_LIMIT=40
readonly ROUTE_COLUMN=28
readonly UNKNOWN_ROUTE_STATUS=127
readonly RESERVED_COMMAND=commands

BIN_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly BIN_DIR

die() {
    printf '%s: %s\n' "${PREFIX}" "$*" >&2
    exit "${UNKNOWN_ROUTE_STATUS}"
}

join_hyphens() {
    local IFS=-
    printf '%s' "$*"
}

command_paths() {
    local path
    for path in "${BIN_DIR}/${PREFIX}-"*; do
        [[ -f "${path}" && -x "${path}" ]] || continue
        printf '%s\n' "${path}"
    done
}

route_of() {
    local stem="${1##*/}"
    printf '%s\n' "${stem#"${PREFIX}"-}" | tr '-' ' '
}

header_of() {
    sed -n "1,${HEADER_LIMIT}{/^\(#.*\)\?\$/!q;p;}" "$1"
}

metadata() {
    header_of "$2" |
        sed -n "s/^# ${PREFIX}:$1=//p" |
        head -n 1
}

is_hidden() {
    [[ "$(metadata hidden "$1")" == true ]]
}

resolve() {
    local -a words=("$@")
    local count=${#words[@]} candidate

    while ((count > 0)); do
        candidate="${BIN_DIR}/${PREFIX}-"
        candidate+=$(join_hyphens "${words[@]:0:count}")
        if [[ -f "${candidate}" && -x "${candidate}" ]]; then
            printf '%s\t%s\n' "${candidate}" "${count}"
            return 0
        fi
        ((count--))
    done
    return 1
}

# A flag after -- belongs to the command, so the scan stops
# there rather than treating a forwarded --help as ours.
wants_help() {
    local word
    for word in "$@"; do
        case "${word}" in
        --) return 1 ;;
        -h | --help) return 0 ;;
        esac
    done
    return 1
}

print_row() {
    printf "  %-${ROUTE_COLUMN}s %s\n" "$1" "$2"
}

list_commands() {
    local path route summary
    while read -r path; do
        is_hidden "${path}" && [[ "$1" != all ]] && continue
        route=$(route_of "${path}")
        summary=$(metadata summary "${path}")
        print_row "${PREFIX} ${route}" "${summary}"
    done < <(command_paths)
}

command_help() {
    local path="$1" route summary args
    route=$(route_of "${path}")
    summary=$(metadata summary "${path}")
    args=$(metadata args "${path}")
    printf 'usage: %s %s%s\n' \
        "${PREFIX}" "${route}" "${args:+ ${args}}"
    [[ -z "${summary}" ]] || printf '\n%s\n' "${summary}"
    printf '\nbinary: %s\n' "${path}"
}

usage() {
    printf 'usage: %s <command> [arguments]\n\n' "${PREFIX}"
    list_commands visible
    printf '\n%s %s --check lints the command headers.\n' \
        "${PREFIX}" "${RESERVED_COMMAND}"
}

# Every command earns its listing entry, so a missing summary
# is a lint failure rather than a silently generated line.
check_commands() {
    local path status=0 route

    if [[ -e "${BIN_DIR}/${PREFIX}-${RESERVED_COMMAND}" ]]; then
        printf '%s-%s shadows the router\n' \
            "${PREFIX}" "${RESERVED_COMMAND}" >&2
        status=1
    fi

    while read -r path; do
        [[ -n "$(metadata summary "${path}")" ]] && continue
        route=$(route_of "${path}")
        printf '%s %s has no %s:summary header\n' \
            "${PREFIX}" "${route}" "${PREFIX}" >&2
        status=1
    done < <(command_paths)

    return "${status}"
}

run_reserved() {
    case "${1:-}" in
    --check) check_commands ;;
    --all) list_commands all ;;
    "") list_commands visible ;;
    *) die "usage: ${PREFIX} ${RESERVED_COMMAND} [--all|--check]" ;;
    esac
}

suggestion_for() {
    local path route
    while read -r path; do
        is_hidden "${path}" && continue
        route=$(route_of "${path}")
        case "${route}" in
        "$1"*) printf '%s\n' "${route}" ;;
        esac
    done < <(command_paths)
}

unknown_route() {
    local -a hints
    local hint
    mapfile -t hints < <(suggestion_for "$1")
    if ((${#hints[@]} == 0)); then
        die "unknown command '$1'; try: ${PREFIX} ${RESERVED_COMMAND}"
    fi
    printf '%s: unknown command. Did you mean:\n' "${PREFIX}" >&2
    for hint in "${hints[@]}"; do
        printf '  %s %s\n' "${PREFIX}" "${hint}" >&2
    done
    exit "${UNKNOWN_ROUTE_STATUS}"
}

main() {
    if (($# == 0)); then
        usage
        return 0
    fi

    case "$1" in
    -h | --help)
        usage
        return 0
        ;;
    "${RESERVED_COMMAND}")
        shift
        run_reserved "$@"
        return
        ;;
    esac

    local path count
    IFS=$'\t' read -r path count < <(resolve "$@") ||
        unknown_route "$1"
    shift "${count}"

    if wants_help "$@"; then
        command_help "${path}"
        return 0
    fi

    # GTK reads this instead of the palette written for it, and a
    # session that set it once keeps handing it to everything it
    # starts until it is restarted.
    unset GTK_THEME

    exec "${path}" "$@"
}

main "$@"
