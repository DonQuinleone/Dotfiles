#!/usr/bin/env bash
set -euo pipefail

# Hook point for the milestone 9 Quickshell lava-lamp
# screensaver. Fill start/stop in here once it exists;
# hypridle.conf need not change again.
case "${1:-}" in
    start | stop) ;;
    *)
        echo "usage: idle-screensaver {start|stop}" >&2
        exit 1
        ;;
esac
