#!/usr/bin/env bash
# donbox:summary=Read and set the desktop's motion scheme
# donbox:args=<get|set|reduced> [argument]
set -euo pipefail

BIN_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
readonly BIN_DIR
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/hypr"
readonly STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/hypr"
readonly STATE_FILE="${STATE_DIR}/motion"
readonly LUA_DIR="${CONFIG_DIR}/lua"
readonly NOTIFY="${BIN_DIR}/donbox-notify"
readonly NOTIFY_MS=1500
readonly DEFAULT_SCALE="1.00"
readonly DEFAULT_DRIFT="on"
readonly REDUCED_SCALE="0.20"
readonly MINIMUM_SCALE="0.10"
readonly MAXIMUM_SCALE="2.00"

usage() {
    cat >&2 <<'EOF'
usage: donbox motion <command>

  get                  print scale, drift and reduced as key=value
  set scale <factor>   speed multiplier, 0.10 to 2.00
  set drift on|off     rotation of the focused window's border
  reduced on|off       collapse to near-instant, or restore
  reduced toggle       flip the reduced state
  apply                re-apply the stored state to the compositor
EOF
    exit 1
}

die() {
    echo "motion: $1" >&2
    exit 1
}

state_value() {
    local key="$1" line
    [[ -r "${STATE_FILE}" ]] || return 1
    while IFS= read -r line; do
        [[ "${line}" == "${key}="* ]] || continue
        printf '%s\n' "${line#*=}"
        return 0
    done <"${STATE_FILE}"
    return 1
}

current_scale() {
    local scale
    scale=$(state_value scale) || scale="${DEFAULT_SCALE}"
    is_factor "${scale}" || scale="${DEFAULT_SCALE}"
    clamp "${scale}"
}

current_drift() {
    local drift
    drift=$(state_value drift) || drift="${DEFAULT_DRIFT}"
    [[ "${drift}" == "off" ]] && printf 'off\n' || printf 'on\n'
}

is_factor() {
    [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]]
}

clamp() {
    awk -v value="$1" -v low="${MINIMUM_SCALE}" \
        -v high="${MAXIMUM_SCALE}" \
        'BEGIN {
            if (value < low) value = low
            if (value > high) value = high
            printf "%.2f\n", value
        }'
}

at_most() {
    awk -v value="$1" -v limit="$2" \
        'BEGIN { exit !(value <= limit) }'
}

reduced_state() {
    local scale="$1" drift="$2"
    [[ "${drift}" == "off" ]] || { printf 'no\n'; return; }
    at_most "${scale}" "${REDUCED_SCALE}" &&
        printf 'yes\n' || printf 'no\n'
}

label() {
    local scale="$1" drift="$2"
    if [[ "$(reduced_state "${scale}" "${drift}")" == "yes" ]]; then
        printf 'reduced\n'
        return
    fi
    awk -v value="${scale}" 'BEGIN { printf "%d%%\n", value * 100 }'
}

announce() {
    [[ -x "${NOTIFY}" ]] || return 0
    "${NOTIFY}" --transient -a Hyprland -u low -t "${NOTIFY_MS}" \
        -- "Motion: $1" || true
}

write_state() {
    mkdir -p "${STATE_DIR}"
    printf 'scale=%s\ndrift=%s\n' "$1" "$2" >"${STATE_FILE}"
}

require_session() {
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] ||
        die "no running Hyprland session"
}

apply() {
    local lua
    require_session

    lua="package.path = '${LUA_DIR}/?.lua;' .. package.path"
    lua="${lua}; local m = require('motion')"
    lua="${lua}; m.apply(m.stored())"
    hyprctl eval "${lua}" >/dev/null ||
        die "the compositor rejected the motion scheme"
}

commit() {
    local scale="$1" drift="$2"
    require_session
    write_state "${scale}" "${drift}"
    apply
    announce "$(label "${scale}" "${drift}")"
}

show() {
    local scale drift
    scale=$(current_scale)
    drift=$(current_drift)
    printf 'scale=%s\ndrift=%s\nreduced=%s\n' \
        "${scale}" "${drift}" \
        "$(reduced_state "${scale}" "${drift}")"
}

set_option() {
    local key="${1:-}" value="${2:-}"
    case "${key}" in
        scale)
            is_factor "${value}" ||
                die "scale takes a number, not '${value}'"
            commit "$(clamp "${value}")" "$(current_drift)"
            ;;
        drift)
            [[ "${value}" == "on" || "${value}" == "off" ]] ||
                die "drift takes on or off, not '${value}'"
            commit "$(current_scale)" "${value}"
            ;;
        *) usage ;;
    esac
}

reduced() {
    case "${1:-}" in
        on) commit "${REDUCED_SCALE}" off ;;
        off) commit "${DEFAULT_SCALE}" "${DEFAULT_DRIFT}" ;;
        toggle) reduced "$(toggled_state)" ;;
        *) usage ;;
    esac
}

toggled_state() {
    [[ "$(reduced_state "$(current_scale)" "$(current_drift)")" \
        == "yes" ]] && printf 'off\n' || printf 'on\n'
}

main() {
    case "${1:-}" in
        get) [[ $# -eq 1 ]] || usage; show ;;
        set) [[ $# -eq 3 ]] || usage; set_option "$2" "$3" ;;
        reduced) [[ $# -eq 2 ]] || usage; reduced "$2" ;;
        apply) [[ $# -eq 1 ]] || usage; apply ;;
        *) usage ;;
    esac
}

main "$@"
