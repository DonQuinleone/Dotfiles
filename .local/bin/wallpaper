#!/usr/bin/env bash
set -euo pipefail

readonly STATE="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
readonly WALLS="${XDG_PICTURES_DIR:-$HOME/pictures}/walls"
readonly CHOSEN="${STATE}/wallpaper"
readonly THUMBNAIL_THEME='
listview { lines: 3; columns: 4; spacing: 10px; }
element { orientation: vertical; padding: 8px; }
element-icon { size: 190px; }
element-text { horizontal-align: 0.5; }
window { width: 1100px; }
'

readonly PER_THEME="${STATE}/wallpapers"

theme_slug() {
    [ -r "${STATE}/current" ] && cat "${STATE}/current" || echo ember
}

theme_dir() {
    local dir
    dir="${WALLS}/$(theme_slug)"
    [ -d "$dir" ] && printf '%s\n' "$dir" || printf '%s\n' "$WALLS"
}

available() {
    find "$(theme_dir)" -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) \
        | sort
}

apply() {
    local image=$1
    [ -r "$image" ] || {
        printf 'wallpaper: cannot read %s\n' "$image" >&2
        exit 1
    }
    mkdir -p "$STATE" "$PER_THEME"
    printf '%s\n' "$image" > "$CHOSEN"
    printf '%s\n' "$image" > "${PER_THEME}/$(theme_slug)"
    systemctl --user restart wallpaper.service
}

remembered() {
    local saved
    saved="${PER_THEME}/$(theme_slug)"
    [ -r "$saved" ] || return 1
    local image
    image=$(cat "$saved")
    [ -r "$image" ] || return 1
    printf '%s\n' "$image"
}

case "${1:-current}" in
    set)
        [ -n "${2:-}" ] || {
            printf 'wallpaper: set needs a path\n' >&2
            exit 2
        }
        apply "$2"
        ;;
    pick)
        choice=$(
            while IFS= read -r image; do
                printf '%s\0icon\x1f%s\n' \
                    "$(basename "${image%.*}")" "$image"
            done < <(available) \
            | rofi -dmenu -i -p Wallpaper -no-custom -show-icons \
                -theme-str "${THUMBNAIL_THEME}"
        ) || exit 0
        [ -n "$choice" ] || exit 0
        apply "$(available | grep -m1 -F "/${choice}.")"
        ;;
    random)
        apply "$(available | shuf -n 1)"
        ;;
    theme)
        image=$(remembered || available | head -1)
        [ -n "$image" ] && apply "$image"
        ;;
    current)
        [ -r "$CHOSEN" ] && cat "$CHOSEN" || echo none
        ;;
    list)
        available
        ;;
    *)
        printf 'usage: %s set|pick|random|theme|current|list\n' \
            "${0##*/}" >&2
        exit 2
        ;;
esac
