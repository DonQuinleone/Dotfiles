#!/usr/bin/env bash
set -euo pipefail

readonly shells=" bash sh zsh fish dash ksh "

caller_name() {
    local -a words=()
    local word program candidate

    [[ -r "/proc/$PPID/cmdline" ]] || return 0
    while IFS= read -r -d '' word; do
        words+=("$word")
    done <"/proc/$PPID/cmdline"
    (( ${#words[@]} )) || return 0

    program="$(basename -- "${words[0]}")"
    if [[ "$shells" != *" $program "* ]]; then
        printf '%s' "$program"
        return 0
    fi

    for candidate in "${words[@]:1}"; do
        [[ "$candidate" == -* ]] && continue
        basename -- "$candidate"
        return 0
    done

    printf '%s' "$program"
}

names_itself() {
    local argument
    for argument in "$@"; do
        case "$argument" in
            -a|--app-name|--app-name=*) return 0 ;;
        esac
    done
    return 1
}

if [[ $# -eq 0 ]]; then
    echo "usage: notify [notify-send option]... SUMMARY [BODY]" >&2
    exit 1
fi

if ! command -v notify-send >/dev/null 2>&1; then
    echo "notify: notify-send not found on PATH" >&2
    exit 1
fi

if names_itself "$@"; then
    exec notify-send "$@"
fi

sender="$(caller_name)"
sender="${sender%$'\n'}"
[[ -n "$sender" ]] || sender="notify"

exec notify-send --app-name "$sender" "$@"
