{
  "items": {
    "root": {
      "label": "donbox"
    },
    "style": {
      "label": "Style",
      "icon": "preferences-desktop-theme"
    },
    "style.theme": {
      "label": "Theme",
      "icon": "preferences-desktop-theme",
      "provider": "donbox theme rows themes",
      "current": "donbox theme current",
      "pickArgs": "--theme-preview",
      "actionFor": "donbox theme set {}"
    },
    "style.accent": {
      "label": "Accent",
      "icon": "color-select",
      "provider": "donbox theme rows accents",
      "current": "donbox theme accent-name",
      "pickArgs": "--preview-cmd 'donbox theme preview-accent'",
      "actionFor": "donbox theme accent {}",
      "cancelFor": "donbox theme preview-accent {}"
    },
    "style.wallpaper": {
      "label": "Wallpaper",
      "icon": "preferences-desktop-wallpaper",
      "provider": "donbox theme rows wallpapers",
      "pickArgs": "--grid",
      "actionFor": "donbox theme wallpaper {}"
    },
    "insert": {
      "label": "Insert",
      "icon": "insert-text"
    },
    "insert.emoji": {
      "label": "Emoji",
      "icon": "face-smile",
      "action": "donbox menu emoji"
    },
    "insert.clipboard": {
      "label": "Clipboard",
      "icon": "edit-paste",
      "action": "donbox menu clipboard"
    },
    "session": {
      "label": "Session",
      "icon": "preferences-system"
    },
    "session.settings": {
      "label": "Settings",
      "icon": "preferences-system"
    },
    "session.settings.shortcuts": {
      "label": "Shortcuts",
      "icon": "input-keyboard",
      "description": "hypr/lua/binds.lua",
      "action": "donbox settings edit hypr/lua/binds.lua --reload 'hyprctl reload'"
    },
    "session.settings.input": {
      "label": "Input and gestures",
      "icon": "input-touchpad",
      "description": "hypr/lua/input.lua",
      "action": "donbox settings edit hypr/lua/input.lua --reload 'hyprctl reload'"
    },
    "session.settings.magnifier": {
      "label": "Magnifier and cursor",
      "icon": "zoom-in",
      "description": "quickshell/settings.json",
      "action": "donbox settings edit quickshell/settings.json"
    },
    "session.settings.look": {
      "label": "Layout and decoration",
      "icon": "preferences-desktop",
      "description": "hypr/lua/look.lua",
      "action": "donbox settings edit hypr/lua/look.lua --reload 'hyprctl reload'"
    },
    "session.settings.motion": {
      "label": "Motion",
      "icon": "media-playback-start",
      "description": "hypr/lua/motion.lua",
      "action": "donbox settings edit hypr/lua/motion.lua --reload 'hyprctl reload'"
    },
    "session.settings.rules": {
      "label": "Window rules",
      "icon": "window-new",
      "description": "hypr/lua/rules.lua",
      "action": "donbox settings edit hypr/lua/rules.lua --reload 'hyprctl reload'"
    },
    "session.settings.monitors": {
      "label": "Monitors",
      "icon": "video-display",
      "description": "hypr/lua/monitors.lua",
      "action": "donbox settings edit hypr/lua/monitors.lua --reload 'hyprctl reload'"
    },
    "session.settings.workspaces": {
      "label": "Workspaces",
      "icon": "view-grid-symbolic",
      "description": "hypr/lua/workspaces.lua",
      "action": "donbox settings edit hypr/lua/workspaces.lua --reload 'hyprctl reload'"
    },
    "session.settings.notifications": {
      "label": "Notifications",
      "icon": "dialog-information",
      "description": "quickshell/notifications.json",
      "action": "donbox settings edit quickshell/notifications.json"
    },
    "session.settings.nightshift": {
      "label": "Night shift",
      "icon": "night-light-symbolic",
      "description": "donbox/nightshift.conf",
      "action": "donbox settings edit donbox/nightshift.conf --prepare 'donbox nightshift defaults' --reload 'donbox nightshift apply'"
    },
    "session.settings.autostart": {
      "label": "Session startup",
      "icon": "system-run",
      "description": "hypr/lua/autostart.lua",
      "action": "donbox settings edit hypr/lua/autostart.lua --reload 'hyprctl reload'"
    },
    "session.settings.network": {
      "label": "Network connections",
      "icon": "network-wired",
      "action": "donbox term --role settings -- nmtui"
    },
    "session.settings.audio": {
      "label": "Audio routing",
      "icon": "audio-volume-high",
      "action": "donbox term --role settings -- wiremix"
    },
    "session.caffeine": {
      "label": "Stay awake",
      "icon": "my-caffeine-on-symbolic",
      "description": "Hold the session awake",
      "checked": "[ \"$(donbox caffeine status)\" = on ]",
      "action": "donbox caffeine toggle"
    },
    "session.nightshift": {
      "label": "Night shift",
      "icon": "night-light-symbolic",
      "checked": "donbox nightshift status | grep -q ' on$'",
      "action": "donbox nightshift toggle"
    },
    "session.update": {
      "label": "Update",
      "icon": "system-software-update",
      "action": "donbox update"
    },
    "power": {
      "label": "Power",
      "icon": "system-shutdown"
    },
    "power.lock": {
      "label": "Lock",
      "icon": "system-lock-screen",
      "action": "donbox idle lock"
    },
    "power.suspend": {
      "label": "Suspend",
      "icon": "system-suspend",
      "confirm": true,
      "action": "systemctl suspend"
    },
    "power.logout": {
      "label": "Log out",
      "icon": "system-log-out",
      "confirm": true,
      "action": "hyprctl dispatch 'hl.dsp.exit()'"
    },
    "power.reboot": {
      "label": "Restart",
      "icon": "system-reboot",
      "confirm": true,
      "action": "systemctl reboot"
    },
    "power.shutdown": {
      "label": "Shut down",
      "icon": "system-shutdown",
      "confirm": true,
      "action": "systemctl poweroff"
    },
    "webapp": {
      "label": "Web apps",
      "icon": "applications-internet"
    },
    "webapp.install": {
      "label": "Install",
      "icon": "list-add",
      "action": "donbox term --role settings -- donbox webapp install"
    },
    "webapp.remove": {
      "label": "Remove",
      "icon": "list-remove",
      "when": "[ -n \"$(donbox webapp list)\" ]",
      "action": "donbox webapp remove"
    },
    "packages": {
      "label": "Packages",
      "icon": "package-x-generic"
    },
    "packages.search": {
      "label": "Install",
      "icon": "list-add",
      "action": "donbox pkg search"
    },
    "packages.remove": {
      "label": "Remove",
      "icon": "list-remove",
      "action": "donbox pkg remove"
    }
  }
}
