#!/usr/bin/env python3
# donbox:summary=Print today's sunrise and sunset
# donbox:hidden=true
"""Sunrise and sunset times from the NOAA solar position algorithm.

Prints three Unix timestamps for the local calendar date containing
the reference time: yesterday's sunset, today's sunrise, and
today's sunset. That is enough for a caller to work out which side
of dawn or dusk "now" falls on, including across a midnight
rollover, without a network call.
"""

import datetime
import sys
from math import acos, asin, cos, degrees, radians, sin, tan

SUN_APPARENT_RADIUS_DEGREES = 32.0 / (60.0 * 2.0)
SUNRISE_SUNSET_ZENITH = 90.0 + SUN_APPARENT_RADIUS_DEGREES
MINUTES_PER_DAY = 1440.0
J2000_EPOCH_JULIAN_DAY = 2451545.0
JULIAN_CENTURY_DAYS = 36525.0
TRANSIT_REFINEMENT_PASSES = 2


def julian_day(date):
    year, month, day = date.year, date.month, date.day
    if month <= 2:
        year -= 1
        month += 12
    century = year // 100
    gregorian_adjustment = 2 - century + century // 4
    return (
        int(365.25 * (year + 4716))
        + int(30.6001 * (month + 1))
        + day
        + gregorian_adjustment
        - 1524.5
    )


def julian_century(jd):
    return (jd - J2000_EPOCH_JULIAN_DAY) / JULIAN_CENTURY_DAYS


def geom_mean_long_sun(jc):
    return (280.46646 + jc * (36000.76983 + 0.0003032 * jc)) % 360.0


def geom_mean_anomaly_sun(jc):
    return 357.52911 + jc * (35999.05029 - 0.0001537 * jc)


def eccentricity_earth_orbit(jc):
    return 0.016708634 - jc * (0.000042037 + 0.0000001267 * jc)


def sun_eq_of_center(jc):
    m = radians(geom_mean_anomaly_sun(jc))
    return (
        sin(m) * (1.914602 - jc * (0.004817 + 0.000014 * jc))
        + sin(2 * m) * (0.019993 - 0.000101 * jc)
        + sin(3 * m) * 0.000289
    )


def sun_apparent_long(jc):
    true_long = geom_mean_long_sun(jc) + sun_eq_of_center(jc)
    omega = radians(125.04 - 1934.136 * jc)
    return true_long - 0.00569 - 0.00478 * sin(omega)


def mean_obliquity_of_ecliptic(jc):
    seconds = 21.448 - jc * (46.815 + jc * (0.00059 - jc * 0.001813))
    return 23.0 + (26.0 + seconds / 60.0) / 60.0


def obliquity_correction(jc):
    omega = radians(125.04 - 1934.136 * jc)
    return mean_obliquity_of_ecliptic(jc) + 0.00256 * cos(omega)


def sun_declination(jc):
    e = radians(obliquity_correction(jc))
    lam = radians(sun_apparent_long(jc))
    return degrees(asin(sin(e) * sin(lam)))


def equation_of_time_minutes(jc):
    epsilon = radians(obliquity_correction(jc))
    y = tan(epsilon / 2.0) ** 2
    l0 = radians(geom_mean_long_sun(jc))
    e = eccentricity_earth_orbit(jc)
    m = radians(geom_mean_anomaly_sun(jc))
    result = (
        y * sin(2 * l0)
        - 2 * e * sin(m)
        + 4 * e * y * sin(m) * cos(2 * l0)
        - 0.5 * y * y * sin(4 * l0)
        - 1.25 * e * e * sin(2 * m)
    )
    return degrees(result) * 4.0


def refraction_at_zenith_degrees(zenith):
    elevation = 90.0 - zenith
    if elevation >= 85.0:
        return 0.0
    te = tan(radians(elevation))
    if elevation > 5.0:
        correction = 58.1 / te - 0.07 / te**3 + 0.000086 / te**5
    elif elevation > -0.575:
        step1 = -12.79 + elevation * 0.711
        step2 = 103.4 + elevation * step1
        step3 = -518.2 + elevation * step2
        correction = 1735.0 + elevation * step3
    else:
        correction = -20.774 / te
    return correction / 3600.0


def hour_angle(latitude, declination, zenith, rising):
    lat = radians(latitude)
    dec = radians(declination)
    zen = radians(zenith)
    cos_h = (cos(zen) - sin(lat) * sin(dec)) / (cos(lat) * cos(dec))
    angle = acos(cos_h)
    return angle if rising else -angle


def time_of_transit_utc(latitude, longitude, date, rising):
    zenith = SUNRISE_SUNSET_ZENITH + refraction_at_zenith_degrees(
        SUNRISE_SUNSET_ZENITH
    )
    jd = julian_day(date)
    minutes_from_midnight = 0.0
    adjustment_days = 0.0
    for _ in range(TRANSIT_REFINEMENT_PASSES):
        jc = julian_century(jd + adjustment_days)
        declination = sun_declination(jc)
        angle = hour_angle(latitude, declination, zenith, rising)
        delta = -longitude - degrees(angle)
        offset = delta * 4.0 - equation_of_time_minutes(jc)
        if offset < -720.0:
            offset += MINUTES_PER_DAY
        minutes_from_midnight = 720.0 + offset
        adjustment_days = minutes_from_midnight / MINUTES_PER_DAY
    midnight_utc = datetime.datetime(
        date.year, date.month, date.day, tzinfo=datetime.timezone.utc
    )
    return midnight_utc + datetime.timedelta(
        minutes=minutes_from_midnight
    )


def transit_on_local_date(
    latitude, longitude, local_date, tzinfo, rising
):
    candidate = time_of_transit_utc(
        latitude, longitude, local_date, rising
    ).astimezone(tzinfo)
    if candidate.date() == local_date:
        return candidate
    shifted = local_date + datetime.timedelta(
        days=-1 if candidate.date() < local_date else 1
    )
    candidate = time_of_transit_utc(
        latitude, longitude, shifted, rising
    ).astimezone(tzinfo)
    if candidate.date() != local_date:
        raise ValueError(
            "no transit falls on the requested local date"
        )
    return candidate


def main():
    if len(sys.argv) != 3:
        print(
            "usage: donbox nightshift sun LATITUDE LONGITUDE",
            file=sys.stderr,
        )
        return 1
    latitude = float(sys.argv[1])
    longitude = float(sys.argv[2])

    now = datetime.datetime.now().astimezone()
    tzinfo = now.tzinfo
    today = now.date()
    yesterday = today - datetime.timedelta(days=1)

    try:
        yesterday_sunset = transit_on_local_date(
            latitude, longitude, yesterday, tzinfo, rising=False
        )
        today_sunrise = transit_on_local_date(
            latitude, longitude, today, tzinfo, rising=True
        )
        today_sunset = transit_on_local_date(
            latitude, longitude, today, tzinfo, rising=False
        )
    except ValueError as error:
        print(f"nightshift-sun: {error}", file=sys.stderr)
        return 1

    print(
        int(yesterday_sunset.timestamp()),
        int(today_sunrise.timestamp()),
        int(today_sunset.timestamp()),
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
