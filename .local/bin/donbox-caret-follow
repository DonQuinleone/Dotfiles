#!/usr/bin/env python3
# donbox:summary=Steer the pointer from the text caret
# donbox:hidden=true

import json
import os
import socket
import time

import gi

gi.require_version("Atspi", "2.0")

from gi.repository import Atspi, GLib

RUNTIME_DIR = os.environ.get(
    "XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
STATE_DIR = os.path.join(
    os.environ.get(
        "XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "hypr")
ENABLED_PATH = os.path.join(STATE_DIR, "caret-follow.on")
REPORT_PATH = os.path.join(RUNTIME_DIR, "caret-follow.sock")

MIN_ZOOM_FACTOR = 1.05
CARET_WIDTH_CAP = 40
DEADZONE_RATIO = 0.14
GLIDE_MS = 130
FRAME_MS = 8
MONITOR_TTL_SECONDS = 5
READ_SIZE = 8192
BACKLOG = 4


class Hyprland:
    def __init__(self):
        signature = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
        self.path = "%s/hypr/%s/.socket.sock" % (
            RUNTIME_DIR, signature)

    def request(self, payload):
        with socket.socket(socket.AF_UNIX,
                           socket.SOCK_STREAM) as client:
            client.connect(self.path)
            client.sendall(payload.encode())
            chunks = []
            while True:
                chunk = client.recv(READ_SIZE)
                if not chunk:
                    break
                chunks.append(chunk)
        return b"".join(chunks).decode()

    def zoom_factor(self):
        reply = json.loads(
            self.request("j/getoption cursor.zoom_factor"))
        return float(reply.get("float", 1.0))

    def active_window(self):
        reply = json.loads(self.request("j/activewindow"))
        if not reply.get("at") or not reply.get("size"):
            return None
        return reply

    def focused_monitor(self):
        for monitor in json.loads(self.request("j/monitors")):
            if monitor.get("focused"):
                return monitor
        return None

    def cursor_position(self):
        x, y = self.request("cursorpos").strip().split(",")
        return int(x), int(y)

    def warp(self, x, y):
        self.request(
            "dispatch hl.dsp.cursor.move({ x = %d, y = %d })"
            % (round(x), round(y)))


def enabled():
    return os.path.exists(ENABLED_PATH)


class Glide:
    def __init__(self, hyprland):
        self.hyprland = hyprland
        self.source = None
        self.origin = (0, 0)
        self.target = (0, 0)
        self.frame = 0
        self.frames = max(1, round(GLIDE_MS / FRAME_MS))

    def to(self, x, y):
        try:
            self.origin = self.hyprland.cursor_position()
        except (OSError, ValueError):
            return
        self.target = (x, y)
        self.frame = 0
        if self.source is None:
            self.source = GLib.timeout_add(FRAME_MS, self.step)

    def step(self):
        self.frame += 1
        progress = min(1.0, self.frame / self.frames)
        eased = 1 - (1 - progress) ** 3
        origin_x, origin_y = self.origin
        target_x, target_y = self.target
        try:
            self.hyprland.warp(
                origin_x + (target_x - origin_x) * eased,
                origin_y + (target_y - origin_y) * eased)
        except OSError:
            self.source = None
            return False
        if progress >= 1.0:
            self.source = None
            return False
        return True


class CaretFollower:
    def __init__(self, hyprland):
        self.hyprland = hyprland
        self.glide = Glide(hyprland)
        self.monitor = None
        self.monitor_read = 0.0

    def cached_monitor(self):
        now = time.monotonic()
        if now - self.monitor_read > MONITOR_TTL_SECONDS:
            try:
                self.monitor = self.hyprland.focused_monitor()
            except (OSError, ValueError):
                self.monitor = None
            self.monitor_read = now
        return self.monitor

    # Re-centring on every keystroke reads as jitter, so the
    # view only chases the caret once it strays out of the
    # middle of the magnified viewport.
    def strayed(self, x, y, zoom):
        monitor = self.cached_monitor()
        if monitor is None:
            return True
        scale = monitor.get("scale", 1.0) or 1.0
        view_width = monitor["width"] / scale / zoom
        view_height = monitor["height"] / scale / zoom
        try:
            cursor_x, cursor_y = self.hyprland.cursor_position()
        except (OSError, ValueError):
            return True
        return (abs(x - cursor_x) > view_width * DEADZONE_RATIO
                or abs(y - cursor_y) > view_height * DEADZONE_RATIO)

    def aim(self, window, x, y):
        left, top = window["at"]
        width, height = window["size"]
        if not (0 <= x <= width and 0 <= y <= height):
            return
        try:
            zoom = self.hyprland.zoom_factor()
        except (OSError, ValueError, KeyError):
            return
        if zoom < MIN_ZOOM_FACTOR:
            return
        target_x, target_y = left + x, top + y
        if not self.strayed(target_x, target_y, zoom):
            return
        self.glide.to(target_x, target_y)

    def on_caret(self, event):
        if not enabled():
            return
        window = self.hyprland.active_window()
        if window is None:
            return
        extents = character_extents(event)
        if extents is None:
            return
        x, y, width, height = extents
        self.aim(window, x + width / 2, y + height / 2)

    # Terminals draw their own text, so nothing reaches AT-SPI;
    # editors report a grid cell instead and the cell size is
    # derived from the window Hyprland already measures.
    def on_report(self, report):
        if not enabled():
            return
        window = self.hyprland.active_window()
        if window is None:
            return
        width, height = window["size"]
        columns = max(1, int(report["columns"]))
        rows = max(1, int(report["lines"]))
        x = (int(report["col"]) - 0.5) * width / columns
        y = (int(report["row"]) - 0.5) * height / rows
        self.aim(window, x, y)


def widget_extents(event):
    try:
        component = event.source.get_component_iface()
        if component is None:
            return None
        return component.get_extents(Atspi.CoordType.WINDOW)
    except Exception:
        return None


def encloses(frame, x, y):
    return (frame.x <= x <= frame.x + frame.width
            and frame.y <= y <= frame.y + frame.height)


# Firefox reports caret rectangles relative to the widget while
# GTK reports them relative to the window, and both call it
# WINDOW, so the widget's own rectangle decides which it is.
def character_extents(event):
    try:
        text = event.source.get_text_iface()
        if text is None:
            return None
        extents = text.get_character_extents(
            event.detail1, Atspi.CoordType.WINDOW)
    except Exception:
        return None
    if extents.height <= 0:
        return None
    x, y = extents.x, extents.y
    frame = widget_extents(event)
    if frame is not None and frame.height > 0 \
            and not encloses(frame, x, y):
        x += frame.x
        y += frame.y
    width = min(extents.width, CARET_WIDTH_CAP)
    return x, y, width, extents.height


class ReportServer:
    def __init__(self, follower):
        self.follower = follower
        if os.path.exists(REPORT_PATH):
            os.unlink(REPORT_PATH)
        self.server = socket.socket(socket.AF_UNIX,
                                    socket.SOCK_STREAM)
        self.server.bind(REPORT_PATH)
        self.server.listen(BACKLOG)
        self.server.setblocking(False)
        GLib.io_add_watch(self.server.fileno(),
                          GLib.PRIORITY_DEFAULT, GLib.IO_IN,
                          self.on_connect)

    def on_connect(self, _fd, _condition):
        client, _ = self.server.accept()
        client.setblocking(False)
        GLib.io_add_watch(client.fileno(), GLib.PRIORITY_DEFAULT,
                          GLib.IO_IN | GLib.IO_HUP,
                          lambda fd, condition: self.on_data(
                              client, condition))
        return True

    def on_data(self, client, condition):
        if condition & GLib.IO_HUP:
            client.close()
            return False
        try:
            payload = client.recv(READ_SIZE)
        except OSError:
            client.close()
            return False
        if not payload:
            client.close()
            return False
        for line in payload.decode().splitlines():
            self.dispatch(line)
        return True

    def dispatch(self, line):
        try:
            report = json.loads(line)
        except ValueError:
            return
        try:
            self.follower.on_report(report)
        except (OSError, KeyError, ValueError, ZeroDivisionError):
            return


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    follower = CaretFollower(Hyprland())
    ReportServer(follower)
    Atspi.init()
    listener = Atspi.EventListener.new(follower.on_caret)
    listener.register("object:text-caret-moved")
    Atspi.event_main()


if __name__ == "__main__":
    main()
