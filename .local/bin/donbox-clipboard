#!/usr/bin/env bash
# donbox:summary=Record what is copied, and hold it after its source
# donbox:args=keep
set -euo pipefail

readonly RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
readonly HELD_FILE="${RUNTIME_DIR}/donbox-clipboard-held"
readonly OWNER_FILE="${RUNTIME_DIR}/donbox-clipboard-owner"

die() {
    printf 'donbox clipboard: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
usage: donbox clipboard keep

Reads the clipboard on standard input. Meant to be handed to
wl-paste --watch rather than run by hand.
EOF
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        die "$1 is not installed but is required"
}

# Wayland keeps the clipboard in the application that filled it,
# so closing that application empties it and there is no event
# to answer: wl-paste --watch stays silent on a selection being
# cleared. The only way to survive the source is to take the
# selection at the moment of the copy and serve it from here.
take_ownership() {
    local buffer="$1" owner
    cp -- "${buffer}" "${HELD_FILE}"
    setsid wl-copy --foreground <"${buffer}" >/dev/null 2>&1 &
    owner=$!
    printf '%s\n' "${owner}" >"${OWNER_FILE}"
}

# Re-offering fires the watch again with what was just offered,
# which would take the selection for a second time and never
# stop. The copy this process is still serving is what tells the
# echo of our own offer apart from someone else copying the same
# words.
is_our_own_echo() {
    local buffer="$1" owner
    [[ -f "${HELD_FILE}" && -f "${OWNER_FILE}" ]] || return 1
    owner=$(<"${OWNER_FILE}")
    [[ -n "${owner}" ]] || return 1
    kill -0 "${owner}" 2>/dev/null || return 1
    cmp -s -- "${HELD_FILE}" "${buffer}"
}

# wl-copy serves one flavour of a selection and a browser offers
# several, so anything richer than plain text is left with the
# application that owns it rather than flattened on its way
# through here.
is_plain_text() {
    ! wl-paste --list-types 2>/dev/null |
        grep -qiE '^(text/html|image/|text/rtf)'
}

cmd_keep() {
    (($# == 0)) || usage
    require_command cliphist
    require_command wl-copy

    local buffer
    buffer=$(mktemp "${RUNTIME_DIR}/donbox-clipboard.XXXXXX")
    # shellcheck disable=SC2064 # the path is wanted as it is now
    trap "rm -f -- '${buffer}'" EXIT
    cat >"${buffer}"

    [[ -s "${buffer}" ]] || return 0
    # Our own offer coming back is already in the history from
    # the pass that made it, so it is dropped before storing
    # rather than stored again and deduplicated afterwards.
    is_our_own_echo "${buffer}" && return 0

    cliphist store <"${buffer}"
    is_plain_text || return 0
    take_ownership "${buffer}"
}

main() {
    (($# >= 1)) || usage
    [[ "$1" == keep ]] || usage
    shift
    cmd_keep "$@"
}

main "$@"
