#!/usr/bin/env bash
# donbox:summary=Install and remove software, and keep the manifest true
# donbox:args=<search|add|remove|list|drift> [name...]
# shellcheck source-path=SCRIPTDIR/../share/donbox/lib
set -euo pipefail

SCRIPT=$(readlink -f "${BASH_SOURCE[0]}")
readonly SCRIPT
BIN_DIR=$(dirname "${SCRIPT}")
readonly BIN_DIR
REPO=$(cd -- "${BIN_DIR}/../.." && pwd)
readonly REPO
readonly MANIFEST="${DONBOX_MANIFEST:-${REPO}/packages.json}"

readonly TERMINAL="${DONBOX_TERMINAL:-ghostty}"
# Ghostty drops a class that is not a valid GTK application ID,
# and folds into a running instance unless told not to; either
# leaves the window without the rule that sizes it.
readonly WINDOW_CLASS="com.donquinleone.packages"
readonly FONT_POINTS=14
readonly CLOSE_PROMPT="Press any key to close this window."

readonly SEARCH_PROMPT="Install"
readonly REMOVE_PROMPT="Remove"
readonly CHOOSER_HEADER="Tab marks, Enter confirms, Escape leaves"
readonly PREVIEW_WINDOW="right,55%,wrap,border-left"
readonly MARK_KEYS="tab:toggle+down,shift-tab:toggle+up"

die() {
    printf 'donbox pkg: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
usage: donbox pkg search [term]
       donbox pkg add <dnf|flatpak> <name>...
       donbox pkg remove [term]
       donbox pkg list [dnf|flatpak|coprs]
       donbox pkg drift
EOF
    exit 1
}

# shellcheck source=packages.sh
source "$(dirname "${BIN_DIR}")/share/donbox/lib/packages.sh"
# shellcheck source=catalogue.sh
source "$(dirname "${BIN_DIR}")/share/donbox/lib/catalogue.sh"

window_is_ours() {
    [[ -n "${DONBOX_PKG_WINDOW:-}" ]]
}

on_a_terminal() {
    window_is_ours || [[ -t 0 && -t 1 ]]
}

# A window opened for one command dies with it, taking the reason
# with it, which is how an empty search or a refusal read as the
# terminal closing by itself. A shell the caller already had is
# theirs to keep, so only our own window is held.
hold_window_open() {
    local status=$?
    ((status == 0)) || wait_for_key
    exit "${status}"
}

# The chooser wants a terminal and so does sudo, and the menu has
# neither, so a window is opened for it and the command re-run
# inside.
reopen_in_terminal() {
    command -v "${TERMINAL}" >/dev/null 2>&1 ||
        die "${TERMINAL} is not installed"
    exec "${TERMINAL}" --class="${WINDOW_CLASS}" \
        --font-size="${FONT_POINTS}" \
        --gtk-single-instance=false \
        -e env DONBOX_PKG_WINDOW=1 "${SCRIPT}" "$@"
}

wait_for_key() {
    [[ -t 0 ]] || return 0
    printf '\n%s' "${CLOSE_PROMPT}"
    read -r -n 1 -s
    printf '\n'
}

# Committed on its own path, so whatever else is in flight in the
# working tree stays where it is.
record() {
    local verb="$1" name="$2"
    git -C "${REPO}" diff --quiet -- "${MANIFEST}" && return 0
    git -C "${REPO}" commit -q -m "packaging: ${verb} ${name}" \
        -- "${MANIFEST}" ||
        printf 'donbox pkg: manifest changed, not committed\n' >&2
}

# A row reads "kind name description", so the chooser hands back
# the first two words and nothing has to be carried in a column
# the reader cannot see. Horizontal scrolling is off because it
# slides a long line sideways to show a match, which would leave
# the columns out of step with each other.
choose() {
    local prompt="$1" query="$2"
    fzf --multi --no-hscroll \
        --delimiter='[[:space:]]+' \
        --prompt="${prompt} > " \
        --header="${CHOOSER_HEADER}" \
        --query="${query}" \
        --bind="${MARK_KEYS}" \
        --preview="${SCRIPT} describe {1} {2}" \
        --preview-window="${PREVIEW_WINDOW}" \
        --border --info=inline --height=100%
}

names_of_kind() {
    awk -v kind="$1" '$1 == kind { print $2 }'
}

cmd_list() {
    (($# <= 1)) || usage
    local wanted="${1:-dnf}"
    manifest_kind_valid "${wanted}" || usage
    manifest_list "${wanted}"
}

# Everything on the machine, however it arrived, which is the
# right question for "is this here at all".
installed_now() {
    dnf -q repoquery --installed --qf '%{name}\n' 2>/dev/null |
        sort -u
}

# Only one direction is answerable. The other, what is installed
# that the manifest has never heard of, cannot be had from rpm:
# Fedora's image builder marks its own three hundred packages as
# installed by the user, so "by hand" is indistinguishable from
# "came with the machine". Keeping the manifest true as things
# are installed is what donbox pkg add is for.
cmd_drift() {
    (($# == 0)) || usage
    local -a missing
    mapfile -t missing < <(comm -23 \
        <(manifest_list dnf | sort -u) <(installed_now))
    printf 'in the manifest but not installed:\n'
    printf '  %s\n' "${missing[@]:-none}"
}

cmd_describe() {
    (($# == 2)) || usage
    catalogue_describe "$1" "$2"
}

# One transaction per manager, so a mixed selection asks for a
# password once and the manifest is told once about each.
act_on_chosen() {
    local verb="$1" rows="$2" kind
    local -a names
    for kind in dnf flatpak; do
        mapfile -t names < <(names_of_kind "${kind}" <<<"${rows}")
        ((${#names[@]} > 0)) || continue
        "${verb}_kind" "${kind}" "${names[@]}"
    done
}

install_kind() {
    local kind="$1" name
    shift
    catalogue_install "${kind}" "$@" || {
        printf '\n%s refused that, manifest unchanged\n' "${kind}"
        return 0
    }
    for name in "$@"; do
        manifest_has "${kind}" "${name}" && continue
        manifest_add "${kind}" "${name}"
        record add "${name}"
    done
    printf '\nadded to the manifest: %s\n' "$*"
}

remove_kind() {
    local kind="$1" name
    shift
    catalogue_uninstall "${kind}" "$@" || {
        printf '\n%s refused that, manifest unchanged\n' "${kind}"
        return 0
    }
    for name in "$@"; do
        manifest_drop "${kind}" "${name}"
        record drop "${name}"
    done
    printf '\ndropped from the manifest: %s\n' "$*"
}

require_chooser() {
    command -v fzf >/dev/null 2>&1 ||
        die "fzf is not installed but is required"
}

cmd_search() {
    (($# <= 1)) || usage
    require_chooser
    on_a_terminal || reopen_in_terminal search "$@"

    local rows
    rows=$(catalogue_rows | choose "${SEARCH_PROMPT}" "${1-}")
    [[ -n "${rows}" ]] || exit 0
    act_on_chosen install "${rows}"
    wait_for_key
}

cmd_remove() {
    (($# <= 1)) || usage
    require_chooser
    on_a_terminal || reopen_in_terminal remove "$@"

    local rows
    rows=$(catalogue_manifest_rows |
        choose "${REMOVE_PROMPT}" "${1-}")
    [[ -n "${rows}" ]] || exit 0
    act_on_chosen remove "${rows}"
    wait_for_key
}

cmd_add() {
    (($# >= 2)) || usage
    local kind="$1"
    shift
    manifest_kind_valid "${kind}" || usage
    on_a_terminal || reopen_in_terminal add "${kind}" "$@"
    install_kind "${kind}" "$@"
    wait_for_key
}

declare -rA COMMANDS=(
    [search]=cmd_search
    [add]=cmd_add
    [remove]=cmd_remove
    [list]=cmd_list
    [drift]=cmd_drift
    [describe]=cmd_describe
)

main() {
    manifest_require
    (($# >= 1)) || usage
    local verb="$1"
    shift
    local handler="${COMMANDS[${verb}]:-}"
    [[ -n "${handler}" ]] || usage
    "${handler}" "$@"
}

window_is_ours && trap hold_window_open EXIT

main "$@"
