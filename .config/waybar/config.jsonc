{
  "layer": "top",
  "position": "top",
  "height": 48,
  "spacing": 6,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/notifications",
    "custom/updates",
    "cpu",
    "memory",
    "network",
    "bluetooth",
    "pulseaudio#microphone",
    "pulseaudio",
    "battery"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "<span font_family='JetBrainsMono Nerd Font' size='x-large'>◆</span>",
      "urgent": "<span font_family='JetBrainsMono Nerd Font' size='x-large'>◆</span>",
      "default": "<span font_family='JetBrainsMono Nerd Font' size='small'>◇</span>"
    },
    "markup": "pango",
    "on-click": "activate",
    "sort-by-number": true
  },
  "hyprland/submap": {
    "format": "{}",
    "tooltip": false
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "today": "<b>{}</b>"
      }
    }
  },
  "tray": {
    "icon-size": 20,
    "spacing": 8
  },
  "custom/notifications": {
    "exec": "notification-state",
    "return-type": "json",
    "interval": 2,
    "on-click": "makoctl mode -t do-not-disturb",
    "on-click-right": "makoctl dismiss --all"
  },
  "custom/updates": {
    "exec": "pending-updates",
    "return-type": "json",
    "interval": 3600,
    "on-click": "kitty --class activity sudo dnf upgrade"
  },
  "cpu": {
    "format": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'>󰍛</span>  {usage}%",
    "interval": 5,
    "on-click": "kitty --class activity btop",
    "markup": "pango"
  },
  "memory": {
    "format": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>  {percentage}%",
    "interval": 10,
    "on-click": "kitty --class activity btop",
    "markup": "pango"
  },
  "network": {
    "format-wifi": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>  {signalStrength}%",
    "format-ethernet": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'>󰈀</span>",
    "format-disconnected": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'>󰈁</span>",
    "tooltip-format-wifi": "{essid}  {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    "on-click": "kitty --class activity nmtui",
    "markup": "pango"
  },
  "bluetooth": {
    "format": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>",
    "format-disabled": "",
    "format-connected": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>  {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "kitty --class activity bluetoothctl",
    "markup": "pango"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>",
    "format-icons": {
      "headphone": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>",
      "default": [
        "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>",
        "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "markup": "pango"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>",
    "format-source-muted": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "markup": "pango"
  },
  "battery": {
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "<span font_family='JetBrainsMono Nerd Font' rise='-1000'>󰂄</span>  {capacity}%",
    "format-icons": [
      "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>",
      "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>",
      "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>",
      "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>",
      "<span font_family='JetBrainsMono Nerd Font' rise='-1000'></span>"
    ],
    "tooltip-format": "{timeTo}",
    "markup": "pango"
  }
}
