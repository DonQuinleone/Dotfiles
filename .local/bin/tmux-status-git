#!/usr/bin/env bash
# Prints a status-bar segment naming the branch of the given
# directory, and nothing at all outside a repository, which a
# tmux format conditional cannot do around a #() result.
set -euo pipefail

text=$1 icon=$2 directory=$3

branch=$(git -C "${directory}" branch --show-current 2>/dev/null) ||
    exit 0
[[ -n ${branch} ]] || exit 0

printf '#[fg=%s] #[fg=%s]%s  ' "${icon}" "${text}" "${branch}"
