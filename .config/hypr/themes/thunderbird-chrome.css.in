:root {
    color-scheme: @scheme@ !important;
    accent-color: @accent@ !important;
    scrollbar-color: @borderStrong@ @bgAlt@ !important;

    --layout-background-0: @bg@ !important;
    --layout-background-1: @bgAlt@ !important;
    --layout-background-2: @surface@ !important;
    --layout-background-3: @border@ !important;
    --layout-background-4: @borderStrong@ !important;
    --layout-color-0: @fg@ !important;
    --layout-color-1: @fg@ !important;
    --layout-color-2: @fgDim@ !important;
    --layout-color-3: @fgFaint@ !important;
    --layout-border-0: @border@ !important;
    --layout-border-1: @border@ !important;
    --layout-border-2: @borderStrong@ !important;

    --color-surface-base: @bg@ !important;
    --color-surface-deep: @bg@ !important;
    --color-surface-lower: @bgAlt@ !important;
    --color-surface-raised: @bgAlt@ !important;
    --color-surface-subtle: @surface@ !important;
    --color-surface-border: @border@ !important;
    --color-surface-border-intense: @borderStrong@ !important;
    --color-text-base: @fg@ !important;
    --color-text-secondary: @fgDim@ !important;
    --color-text-muted: @fgFaint@ !important;
    --color-text-brand: @accent@ !important;
    --color-text-highlight: @accent@ !important;
    --color-text-success: @good@ !important;
    --color-text-warning: @warn@ !important;
    --color-text-critical: @bad@ !important;
    --color-primary-soft: @accentDark@ !important;
    --color-primary-default: @accent@ !important;
    --color-primary-hover: @accentSoft@ !important;
    --color-primary-pressed: @accentDark@ !important;

    --selected-item-color: @accent@ !important;
    --selected-item-text-color: @onAccent@ !important;
    --item-focus-selected-border-color: @accent@ !important;
    --focus-outline-color: @accent@ !important;
    --tabline-color: @accent@ !important;
    --new-folder-color: @accent@ !important;
    --autocomplete-popup-url-color: @accent@ !important;
    --link-color: @accent@ !important;
    --link-color-hover: @accentSoft@ !important;
    --link-color-active: @accentDark@ !important;
    --link-color-visited: @accentSoft@ !important;

    --toolbox-background-color: @bg@ !important;
    --toolbox-text-color: @fg@ !important;
    --toolbox-background-color-inactive: @bg@ !important;
    --toolbox-text-color-inactive: @fgDim@ !important;
    --toolbar-background-color: @bgAlt@ !important;
    --toolbar-text-color: @fg@ !important;
    --toolbar-field-background-color: @surface@ !important;
    --toolbar-field-color: @fg@ !important;
    --toolbar-field-border-color: @border@ !important;
    --toolbar-field-focus-border-color: @accent@ !important;
    --toolbar-field-highlight: @accent@ !important;
    --toolbar-field-highlight-color: @onAccent@ !important;
    --toolbarbutton-icon-fill-attention: @accent@ !important;
    --chrome-content-separator-color: @border@ !important;
    --tabs-toolbar-background-color: @bg@ !important;
    --tabs-toolbar-box-shadow: none !important;
    --lwt-tabs-border-color: @border@ !important;

    --spaces-bg-color: @bgAlt@ !important;
    --spaces-bg-image: none !important;
    --spaces-button-text-color: @fgDim@ !important;
    --spaces-button-active-text-color: @onAccent@ !important;
    --spaces-button-active-bg-color: @accent@ !important;

    --sidebar-background-color: @bgAlt@ !important;
    --sidebar-text-color: @fg@ !important;
    --sidebar-border-color: @border@ !important;
    --sidebar-background: @bgAlt@ !important;
    --sidebar-color: @fg@ !important;
    --sidebar-border: @border@ !important;

    --tree-view-bg: @bg@ !important;
    --tree-view-color: @fg@ !important;
    --tree-pane-background: @bg@ !important;
    --tree-view-header-hover-bg: @surface@ !important;
    --tree-view-header-hover-active-bg: @border@ !important;
    --unread-color: @fg@ !important;
    --listbox-selected-bg: @surface@ !important;
    --listbox-selected-color: @onAccent@ !important;
    --listbox-focused-selected-bg: @accent@ !important;
    --listbox-focused-selected-color: @onAccent@ !important;
    --listbox-hover:
        color-mix(in srgb, @accent@ 12%, transparent) !important;
    --row-grouped-header-bg-color: @bgAlt@ !important;
    --row-grouped-header-bg-color-selected: @accent@ !important;

    --tree-card-background: @bgAlt@ !important;
    --tree-card-border: @border@ !important;
    --tree-card-border-focus: @accent@ !important;
    --tree-card-border-hover:
        color-mix(in srgb, @accent@ 70%, transparent) !important;
    --tree-card-border-selected:
        color-mix(in srgb, @accent@ 40%, transparent) !important;
    --tree-card-border-selected-unfocused: @border@ !important;
    --tree-card-background-current:
        color-mix(in srgb, @accent@ 12%, @bgAlt@) !important;
    --tree-card-background-selected:
        color-mix(in srgb, @accent@ 18%, @bgAlt@) !important;
    --tree-card-background-selected-current:
        color-mix(in srgb, @accent@ 24%, @bgAlt@) !important;
    --tree-card-background-current-unfocused: @surface@ !important;
    --tree-card-background-selected-unfocused: @surface@ !important;
    --tree-card-background-selected-current-unfocused:
        @border@ !important;
    --tree-card-background-selected-current-unfocused-hover:
        @border@ !important;

    --list-container-border: transparent !important;
    --list-container-background-selected: @surface@ !important;
    --list-container-border-selected: @border@ !important;
    --list-container-background-selected-current: @border@ !important;
    --list-container-border-selected-current:
        @borderStrong@ !important;
    --list-container-background-hover:
        color-mix(in srgb, @accent@ 12%, transparent) !important;
    --list-container-border-hover:
        color-mix(in srgb, @accent@ 60%, transparent) !important;
    --list-container-background-selected-focused:
        color-mix(in srgb, @accent@ 18%, transparent) !important;
    --list-container-border-selected-focused:
        color-mix(in srgb, @accent@ 40%, transparent) !important;
    --list-container-background-selected-current-focused:
        color-mix(in srgb, @accent@ 30%, transparent) !important;
    --list-container-border-selected-current-focused:
        @accent@ !important;
    --treeitem-background-hover: @bgAlt@ !important;
    --treeitem-background-selected: @surface@ !important;
    --treeitem-background-active: @accent@ !important;
    --treeitem-text-active: @onAccent@ !important;

    --folderpane-unread-count-background: @accent@ !important;
    --folderpane-unread-count-text: @onAccent@ !important;
    --folderpane-unread-new-count-background: @accent@ !important;
    --folderpane-total-count-background: @surface@ !important;
    --folderpane-total-count-text: @fgDim@ !important;

    --button-background-color: @surface@ !important;
    --button-hover-background-color: @border@ !important;
    --button-active-background-color: @borderStrong@ !important;
    --button-border-color: @border@ !important;
    --button-text-color: @fg@ !important;
    --button-hover-text-color: @fg@ !important;
    --button-link-text-color: @accent@ !important;
    --button-link-active-text-color: @accentSoft@ !important;
    --button-primary-background-color: @accent@ !important;
    --button-primary-hover-background-color: @accentSoft@ !important;
    --button-primary-active-background-color: @accentDark@ !important;
    --button-primary-border-color: @accent@ !important;
    --button-primary-text-color: @onAccent@ !important;
    --button-primary-shadow: none !important;
    --button-primary-hover-shadow: none !important;
    --button-background-color-primary: @accent@ !important;
    --button-background-color-primary-hover: @accentSoft@ !important;
    --button-background-color-primary-active: @accentDark@ !important;
    --button-border-color-primary: @accent@ !important;
    --button-border-color-primary-hover: @accentSoft@ !important;
    --button-text-color-primary: @onAccent@ !important;
    --button-text-color-primary-hover: @onAccent@ !important;

    --color-accent-primary: @accent@ !important;
    --color-accent-primary-hover: @accentSoft@ !important;
    --color-accent-primary-active: @accentDark@ !important;
    --color-accent-primary-selected: @accent@ !important;
    --color-accent-primary-selected-unfocused: @surface@ !important;
    --text-color-accent-primary-selected: @onAccent@ !important;
    --in-content-accent-color: @accent@ !important;
    --in-content-focus-outline-color: @accent@ !important;
    --in-content-deemphasized-text: @fgDim@ !important;
    --background-color-canvas: @bg@ !important;
    --background-color-box-info: @bgAlt@ !important;
    --border-color-box-info: @border@ !important;
    --background-color-list-item-hover:
        color-mix(in srgb, @accent@ 20%, transparent) !important;
    --table-row-background-color-alternate: @bgAlt@ !important;
    --text-color: @fg@ !important;
    --border-color: @border@ !important;
    --border-color-deemphasized: @border@ !important;
    --border-color-interactive: @borderStrong@ !important;

    --box-background-color: @bgAlt@ !important;
    --box-text-color: @fg@ !important;
    --box-border-color: @border@ !important;
    --field-background-color: @surface@ !important;
    --field-text-color: @fg@ !important;
    --field-border-color: @border@ !important;
    --field-border-hover-color: @borderStrong@ !important;
    --input-border-color: @border@ !important;
    --search-bar-background: @surface@ !important;
    --search-bar-focus-background: @surface@ !important;
    --search-bar-border-color: @border@ !important;
    --search-bar-color: @fg@ !important;
    --search-field-placeholder: @fgFaint@ !important;
    --highlight-background: @accent@ !important;
    --primary-focus-border: @accent@ !important;
    --richlist-button-background: @bgAlt@ !important;
    --tab-hover-background:
        color-mix(in srgb, @fg@ 10%, transparent) !important;
    --tab-selected-background:
        color-mix(in srgb, @fg@ 18%, transparent) !important;
    --autocomplete-popup-highlight-background: @accent@ !important;
    --autocomplete-popup-highlight-color: @onAccent@ !important;
}

#navigation-toolbox {
    background-color: @bg@ !important;
    color: @fg@ !important;
}

menupopup,
panel {
    color-scheme: @scheme@ !important;
    --panel-background-color: @bgAlt@ !important;
    --panel-text-color: @fg@ !important;
    --panel-border-color: @border@ !important;
}

menupopup > menuitem[_moz-menuactive]:not([disabled]),
menupopup > menu[_moz-menuactive]:not([disabled]) {
    background-color: @accent@ !important;
    color: @onAccent@ !important;
}
