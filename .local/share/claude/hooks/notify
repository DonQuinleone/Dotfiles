#!/usr/bin/env bash

set -euo pipefail

readonly NOTIFICATION_TITLE='Claude Code'
readonly STOP_TITLE='Claude finished'
readonly QUIET_TURN_SECONDS=60
readonly STAMP_DIR="${XDG_RUNTIME_DIR:-/tmp}/claude-turns"
readonly NOTIFIER=(notify-send)

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly root
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/hook-input.sh
source "$root/lib/hook-input.sh"

has_display() {
  [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} ]]
}

send_notification() {
  local -r title=$1 body=$2
  if has_command "${NOTIFIER[0]}"; then
    "${NOTIFIER[@]}" "$title" "$body"
  fi
}

stamp_turn() {
  local -r session=$1
  [[ -n $session ]] || return 0
  mkdir -p "$STAMP_DIR"
  printf '%s\n' "$EPOCHSECONDS" >"$STAMP_DIR/$session"
}

long_turn() {
  local -r session=$1
  local started
  [[ -r $STAMP_DIR/$session ]] || return 1
  started=$(<"$STAMP_DIR/$session")
  (( EPOCHSECONDS - started >= QUIET_TURN_SECONDS ))
}

project_name() {
  local -r directory=$1
  basename -- "${directory:-$PWD}"
}

main() {
  if ! has_display || ! has_command jq; then
    return 0
  fi
  local payload event
  payload=$(cat)
  event=$(hook_field "$payload" '.hook_event_name')
  case $event in
    Notification)
      send_notification "$NOTIFICATION_TITLE" \
        "$(hook_field "$payload" '.message')"
      ;;
    UserPromptSubmit)
      stamp_turn "$(hook_field "$payload" '.session_id')"
      ;;
    Stop)
      long_turn "$(hook_field "$payload" '.session_id')" || return 0
      send_notification "$STOP_TITLE" \
        "$(project_name "$(hook_field "$payload" '.cwd')")"
      ;;
  esac
}

main || true
exit 0
