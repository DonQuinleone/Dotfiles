#!/usr/bin/env bash
set -euo pipefail

readonly SHELL_CONFIG="ember"

case "${1:-}" in
    start | stop) ;;
    *)
        echo "usage: idle-screensaver {start|stop}" >&2
        exit 1
        ;;
esac

# hypridle fires this on every idle edge, including ones where
# the shell has gone away; a missing shell is not an error.
qs -c "${SHELL_CONFIG}" ipc call screensaver "$1" >/dev/null 2>&1 \
    || true
