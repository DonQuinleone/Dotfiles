#!/usr/bin/env bash
set -euo pipefail

readonly queue_max=4
readonly xdg_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly xdg_runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
readonly voice_name="en_GB-jenny_dioco-medium.onnx"
readonly default_voice="$xdg_data_home/piper/voices/$voice_name"
readonly voice_onnx="${HYPR_SPEAK_VOICE:-$default_voice}"
readonly voice_json="$voice_onnx.json"
readonly runtime_dir="$xdg_runtime_dir/hypr-speak"
readonly lock_file="$runtime_dir/queue.lock"
script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly script_path

# A dropped notification is heard as silence, never as a pile of
# stale speech read out long after the event it described, so
# rapid callers are capped at $queue_max pending utterances and
# anything past that is dropped rather than queued indefinitely.
# One flock serialises playback so utterances never overlap.
worker_marker=""
worker_wav=""
# shellcheck disable=SC2329
cleanup_worker() {
    rm -f "$worker_marker" "$worker_wav"
}

run_worker() {
    worker_marker="$1"
    trap cleanup_worker EXIT
    local text
    text="$(<"$worker_marker")"

    worker_wav="$(mktemp "$runtime_dir/utterance-XXXXXX.wav")"

    # shellcheck disable=SC2016
    if ! flock -w 10 "$lock_file" bash -c '
            piper -m "$1" -c "$2" -f "$3" && pw-play "$3"
        ' _ "$voice_onnx" "$voice_json" "$worker_wav" \
        <<<"$text" >/dev/null 2>&1
    then
        logger -t hypr-speak "failed to speak (voice: $voice_onnx)"
        exit 1
    fi
}

if [[ "${1:-}" == "--worker" ]]; then
    run_worker "$2"
    exit 0
fi

if [[ $# -ge 1 ]]; then
    text="$1"
else
    text="$(cat)"
fi

if [[ -z "${text//[[:space:]]/}" ]]; then
    echo "speak: refusing empty input" >&2
    exit 1
fi

if ! command -v piper >/dev/null 2>&1; then
    echo "speak: piper not found on PATH" \
        "(pipx install piper-tts)" >&2
    exit 1
fi

if ! command -v pw-play >/dev/null 2>&1; then
    echo "speak: pw-play not found; is PipeWire installed?" >&2
    exit 1
fi

if [[ ! -f "$voice_onnx" || ! -f "$voice_json" ]]; then
    echo "speak: voice not found at '$voice_onnx'" \
        "(override with HYPR_SPEAK_VOICE)" >&2
    exit 1
fi

mkdir -p -- "$runtime_dir"
chmod 700 -- "$runtime_dir"

# Checking the pending count and creating a marker are two
# steps, so concurrent callers need an admission lock around
# both; otherwise a burst of calls can all read the same low
# count before any of them has created a marker, and the cap
# does nothing.
exec {admit_fd}>"$runtime_dir/admit.lock"
flock "$admit_fd"

shopt -s nullglob
pending=("$runtime_dir"/*.pending)
if (( ${#pending[@]} >= queue_max )); then
    flock -u "$admit_fd"
    logger -t hypr-speak \
        "queue full ($queue_max); dropping: $text"
    exit 0
fi

marker="$(mktemp "$runtime_dir/XXXXXX.pending")"
printf '%s' "$text" >"$marker"
flock -u "$admit_fd"

setsid "$script_path" --worker "$marker" >/dev/null 2>&1 &
disown

exit 0
