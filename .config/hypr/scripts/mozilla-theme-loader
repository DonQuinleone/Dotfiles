#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly SCRIPT_DIR
readonly MODULE_DIR="${SCRIPT_DIR}/theme.d"
TEMPLATE_DIR=$(dirname "${SCRIPT_DIR}")/themes
readonly TEMPLATE_DIR

# shellcheck source=theme.d/common.sh
source "${MODULE_DIR}/common.sh"
# shellcheck source=theme.d/mozilla.sh
source "${MODULE_DIR}/mozilla.sh"

readonly LOADER_FILE_MODE=0644

report() {
    printf '%s\n' "$*"
}

install_loader_files() {
    local directory="$1" source target
    while IFS=$'\t' read -r source target; do
        [[ -f "${source}" ]] ||
            die "missing loader file ${source}"
        sudo install -D -m "${LOADER_FILE_MODE}" \
            "${source}" "${target}"
    done < <(mozilla_loader_files "${directory}")
}

install_app_loader() {
    local app="$1" directory
    directory=$(mozilla_install_dir "${app}")
    if [[ -z "${directory}" ]]; then
        report "${app}: not installed, skipped"
        return
    fi
    if mozilla_loader_installed "${directory}"; then
        report "${app}: loader already current in ${directory}"
        return
    fi
    install_loader_files "${directory}"
    rm -f "${MOZILLA_LOADER_STAMP}-${app}"
    report "${app}: loader installed in ${directory}"
}

main() {
    (($# == 0)) ||
        die "usage: $(basename "$0")"
    require_command sudo
    local app
    while read -r app; do
        install_app_loader "${app}"
    done < <(mozilla_apps | sort)
    report "restart each application to arm the loader"
}

main "$@"
