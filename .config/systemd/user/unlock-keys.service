[Unit]
Description=Unlock the GPG and SSH keys for this session
Documentation=man:gpg-preset-passphrase(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.config/hypr/scripts/unlock-keys apply
ExecStop=%h/.config/hypr/scripts/unlock-keys forget

[Install]
WantedBy=graphical-session.target
