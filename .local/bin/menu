#!/usr/bin/env bash
set -euo pipefail

declare -rA ACTIONS=(
    [Theme]="theme pick"
    [Wallpaper]="wallpaper pick"
    [Clipboard]="clipboard-history"
    [Emoji]="rofimoji"
    [Screenshot]="screenshot copy-region"
    [Record]="record"
    [Night shift]="night-shift toggle"
    [Stay awake]="keep-awake toggle"
    [Keys]="keybind-help"
    [Power]="power-menu"
)

readonly ORDER=(
    "Theme" "Wallpaper" "Clipboard" "Emoji" "Screenshot"
    "Record" "Night shift" "Stay awake" "Keys" "Power"
)

choice=$(printf '%s\n' "${ORDER[@]}" \
    | rofi -dmenu -i -p Menu -no-custom)

[ -n "$choice" ] || exit 0

command=${ACTIONS[$choice]:-}

[ -n "$command" ] || {
    printf 'menu: no action for %s\n' "$choice" >&2
    exit 1
}

exec $command
