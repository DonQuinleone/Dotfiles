#!/usr/bin/env luajit

local source = arg[0] or "hostinfo"
local resolver = io.popen(("readlink -f -- '%s'")
    :format(source:gsub("'", [['\'']])))
local resolved = resolver and resolver:read("*l") or nil
if resolver then resolver:close() end
local base = (resolved or source):match("^(.*)/[^/]+$") or "."
package.path = base .. "/../lib/?.lua;" .. package.path

local net = require("netkit.net")
local collect = require("netkit.hostinfo.collect")
local render = require("netkit.hostinfo.render")

local USAGE_EXIT_CODE = 64

local SECTION_FLAGS = {
    ["--dns"] = "dns",
    ["--net"] = "net",
    ["--tls"] = "tls",
    ["--reg"] = "reg",
}

local USAGE = [[
Usage: hostinfo [--json] [--dns] [--net] [--tls] [--reg]
                <hostname|url|address>

Reports the target's resolution chain, IP addresses, reverse
DNS, ASN and prefix, abuse contact, DNS blacklist listings, TLS
protocol support with certificate and SNI checks, DNSSEC state,
the authoritative DNS zone and domain registration.

Section flags limit the report: --dns (resolution and zone),
--net (addresses, networks, blacklists), --tls, --reg
(registration). No section flag means all of them. --json emits
the report as JSON instead of tables.]]

local function die(message)
    io.stderr:write("hostinfo: " .. message .. "\n")
    os.exit(1)
end

local function usage_error()
    io.stderr:write(USAGE .. "\n")
    os.exit(USAGE_EXIT_CODE)
end

local function parse_arguments()
    local options = { sections = {} }
    local chosen = false
    for _, argument in ipairs(arg) do
        if argument == "-h" or argument == "--help" then
            print(USAGE)
            os.exit(0)
        elseif argument == "--json" then
            options.json = true
        elseif SECTION_FLAGS[argument] then
            options.sections[SECTION_FLAGS[argument]] = true
            chosen = true
        elseif argument:match("^%-") or options.target then
            usage_error()
        else
            options.target = argument
        end
    end
    if not options.target then usage_error() end
    if not chosen then
        for _, section in pairs(SECTION_FLAGS) do
            options.sections[section] = true
        end
    end
    return options
end

local function main()
    io.stdout:setvbuf("line")
    local options = parse_arguments()
    for _, tool in ipairs(net.REQUIRED_TOOLS) do
        if net.run("command -v " .. tool) == "" then
            die(tool .. " not found")
        end
    end
    local target = net.normalise_target(options.target)
    local literal = net.is_ipv4(target) or net.is_ipv6(target)
    if target == ""
        or (not literal and not net.plausible_host(target)) then
        die("could not parse a host from '" ..
            options.target .. "'")
    end
    local report, problem =
        collect.report(target, literal, options.sections)
    if not report then die(problem) end
    if options.json then
        render.json(report)
    else
        render.text(report)
    end
    return 0
end

os.exit(main())
