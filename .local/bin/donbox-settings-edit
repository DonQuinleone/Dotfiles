#!/usr/bin/env bash
# donbox:summary=Open a configuration file, and apply it if it changed
# donbox:args=<file> [--prepare COMMAND] [--reload COMMAND]
# donbox:hidden=true
set -euo pipefail

readonly CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly STATE_HOME="${XDG_STATE_HOME:-${HOME}/.local/state}"
readonly EDITOR_COMMAND=nvim
LAUNCHER="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/donbox-term"
readonly LAUNCHER
readonly WINDOW_ROLE="settings"

file=""
prepare=""
reload=""

die() {
    printf 'donbox settings edit: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'usage: donbox settings edit <file>' >&2
    printf ' [--prepare COMMAND] [--reload COMMAND]\n' >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        die "$1 is not installed but is required"
}

read_arguments() {
    while (($#)); do
        case "$1" in
        --prepare)
            prepare="${2-}"
            shift 2 || usage
            ;;
        --reload)
            reload="${2-}"
            shift 2 || usage
            ;;
        -*) usage ;;
        *)
            [[ -z "${file}" ]] || usage
            file="$1"
            shift
            ;;
        esac
    done
    [[ -n "${file}" ]] || usage
}

# A file the desktop generates on demand rather than tracks, the
# night shift schedule being the one that does this, has nothing
# to open until something writes it.
ensure_file() {
    local path="$1"
    [[ ! -e "${path}" ]] || return 0
    [[ -n "${prepare}" ]] ||
        die "${path} is missing from the configuration"
    mkdir -p "$(dirname "${path}")"
    bash -c "${prepare}" >"${path}" ||
        die "could not write ${path}"
}

modified_at() {
    stat -c %Y "$1"
}

# A file the desktop writes rather than one it is given lives
# under the state directory, so both roots can be named.
resolve() {
    case "$1" in
    state:*) printf '%s/%s' "${STATE_HOME}" "${1#state:}" ;;
    *) printf '%s/%s' "${CONFIG_HOME}" "$1" ;;
    esac
}

main() {
    read_arguments "$@"
    require_command "${EDITOR_COMMAND}"

    local path before
    path=$(resolve "${file}")
    ensure_file "${path}"
    before=$(modified_at "${path}")

    "${LAUNCHER}" --role "${WINDOW_ROLE}" \
        -- "${EDITOR_COMMAND}" "${path}"

    [[ "$(modified_at "${path}")" != "${before}" ]] || return 0
    [[ -n "${reload}" ]] || return 0
    bash -c "${reload}" >/dev/null
}

main "$@"
