#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly SCRIPT_DIR
readonly THEME="${SCRIPT_DIR}/theme"
readonly PICK="${SCRIPT_DIR}/pick"
readonly CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly ACTIVE_JSON="${CONFIG_HOME}/quickshell/themes/current.json"
readonly WALLPAPER_ROOT="${HOME}/Pictures/walls"
readonly WALLPAPER_PROMPT="Wallpaper"

die() {
    printf 'wallpaper-menu: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        die "$1 is not installed but is required"
}

current_wallpaper() {
    [[ -r "${ACTIVE_JSON}" ]] || return 0
    jq -r '.wallpaper // ""' "${ACTIVE_JSON}"
}

wallpapers_in() {
    find "$1" -maxdepth 1 -type f | sort
}

choose_wallpaper() {
    printf '%s\n' "$@" |
        "${PICK}" --grid --prompt "${WALLPAPER_PROMPT}" \
            --current "$(current_wallpaper)"
}

main() {
    (($# == 0)) || die "usage: wallpaper-menu"
    require_command jq
    [[ -x "${PICK}" ]] || die "${PICK} is missing"

    local slug directory chosen
    local -a pictures=()
    slug=$("${THEME}" current)
    directory="${WALLPAPER_ROOT}/${slug}"
    [[ -d "${directory}" ]] ||
        die "no wallpaper directory ${directory}"

    mapfile -t pictures < <(wallpapers_in "${directory}")
    ((${#pictures[@]} > 0)) ||
        die "no wallpapers in ${directory}"

    chosen=$(choose_wallpaper "${pictures[@]}") || return 0
    "${THEME}" wallpaper "${chosen}"
}

main "$@"
