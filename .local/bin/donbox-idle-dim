#!/usr/bin/env bash
# donbox:summary=Dim the screen while idle
# donbox:args=<percent|restore>
# donbox:hidden=true
set -euo pipefail

readonly SHELL_CONFIG="donbox"

usage() {
    echo "usage: donbox idle dim {PERCENT|restore}" >&2
    exit 1
}

# hypridle drives the backlight with no keypress behind it, so
# the shell is asked to hold its HUD down first. A shell that
# has gone away is not an error, and the request lapses by
# itself, so a call that never lands only costs one HUD.
quieten_osd() {
    qs -c "${SHELL_CONFIG}" ipc call osd quietBrightness \
        >/dev/null 2>&1 || true
}

main() {
    [[ $# -eq 1 ]] || usage
    case "$1" in
        restore)
            quieten_osd
            brightnessctl -r >/dev/null
            ;;
        *[!0-9]* | "")
            usage
            ;;
        *)
            quieten_osd
            brightnessctl -s set "$1%" >/dev/null
            ;;
    esac
}

main "$@"
