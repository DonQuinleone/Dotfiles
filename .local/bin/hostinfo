#!/usr/bin/env luajit

local source = arg[0] or "hostinfo"
local resolver = io.popen(("readlink -f -- '%s'")
    :format(source:gsub("'", [['\'']])))
local resolved = resolver and resolver:read("*l") or nil
if resolver then resolver:close() end
local base = (resolved or source):match("^(.*)/[^/]+$") or "."
package.path = base .. "/../lib/?.lua;" .. package.path

local net = require("netkit.net")
local ui = require("netkit.ui")
local cli = require("netkit.cli")
local collect = require("netkit.hostinfo.collect")
local render = require("netkit.hostinfo.render")

local SPEC = {
    name = "hostinfo",
    required = { "dig", "curl", "jq", "openssl", "timeout" },
    sections = {
        ["--dns"] = "dns", ["--net"] = "net",
        ["--tls"] = "tls", ["--reg"] = "reg",
    },
    usage = [[
Usage: hostinfo [--json] [--dns] [--net] [--tls] [--reg]
                <hostname|url|address>

Reports the target's resolution chain, IP addresses, reverse
DNS, ASN and prefix, abuse contact, DNS blacklist listings, TLS
protocol support with certificate and SNI checks, DNSSEC state,
the authoritative DNS zone and domain registration.

Section flags limit the report: --dns (resolution and zone),
--net (addresses, networks, blacklists), --tls, --reg
(registration). No section flag means all of them. --json emits
the report as JSON instead of tables.]],
}

local function main()
    io.stdout:setvbuf("line")
    local options = cli.parse(SPEC)
    cli.require_tools(SPEC)
    local target = net.normalise_target(options.target)
    local literal = net.is_ipv4(target) or net.is_ipv6(target)
    if target == ""
        or (not literal and not net.plausible_host(target)) then
        cli.die("hostinfo", "could not parse a host from '" ..
            options.target .. "'")
    end
    local report, problem = collect.report(target, literal,
        options.sections, ui.progress)
    ui.progress_done()
    if not report then cli.die("hostinfo", problem) end
    if options.json then
        render.json(report)
    else
        render.text(report)
    end
    return 0
end

os.exit(main())
