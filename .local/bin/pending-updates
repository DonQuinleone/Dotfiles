#!/usr/bin/env bash
set -euo pipefail

readonly NOTHING_PENDING=0
readonly UPDATES_PENDING=100

set +e
output=$(dnf -q --refresh check-update 2>/dev/null)
status=$?
set -e

[ "$status" -eq "$NOTHING_PENDING" ] && {
    printf '{"text":"","class":"clear","tooltip":"Up to date"}\n'
    exit 0
}

[ "$status" -ne "$UPDATES_PENDING" ] && {
    printf '{"text":"","class":"unknown","tooltip":"Update check failed"}\n'
    exit 0
}

count=$(printf '%s\n' "$output" | grep -cE '^[[:alnum:]]')

printf '{"text":" %s","class":"pending","tooltip":"%s updates pending"}\n' \
    "$count" "$count"
