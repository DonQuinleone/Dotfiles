{
  "manifest_version": 2,
  "name": "donbox linkout",
  "version": "1.0",
  "description": "Sends a link the pad is not signed in to out to the browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "linkout@donbox.invalid",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "web_accessible_resources": ["handoff.html"]
}
