#!/usr/bin/env bash
# donbox:summary=Let the theme colour Brave without asking for root
# shellcheck source-path=SCRIPTDIR/../share/donbox/lib
set -euo pipefail

BIN_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly BIN_DIR
SHARE_DIR=$(dirname "${BIN_DIR}")/share/donbox
readonly SHARE_DIR
readonly MODULE_DIR="${SHARE_DIR}/lib/theme.d"

# shellcheck source=theme.d/common.sh
source "${MODULE_DIR}/common.sh"
# shellcheck source=theme.d/contrast.sh
source "${MODULE_DIR}/contrast.sh"
# shellcheck source=theme.d/accents.sh
source "${MODULE_DIR}/accents.sh"
# shellcheck source=theme.d/brave.sh
source "${MODULE_DIR}/brave.sh"

readonly DIRECTORY_MODE=0755

report() {
    printf '%s\n' "$*"
}

# Chromium reads policy from a directory only root may write, and
# a theme switch cannot ask for a password. Ownership of this one
# directory moves to the account instead, which is a real
# trade-off: anything running as this user can then set browser
# policy, not merely browser settings.
claim_policy_directory() {
    sudo install -d -m "${DIRECTORY_MODE}" \
        -o "$(id -u)" -g "$(id -g)" "${BRAVE_POLICY_DIR}"
}

main() {
    (($# == 0)) || die "usage: donbox install brave theme"
    # Run as yourself. Only the one directory needs root, and
    # under sudo the theme this reads would be root's.
    ((EUID != 0)) ||
        die "run this as yourself; it asks for root where it needs it"
    command -v "${BRAVE_COMMAND}" >/dev/null 2>&1 ||
        die "${BRAVE_COMMAND} is not installed"
    require_command sudo
    require_command jq

    if [[ -w "${BRAVE_POLICY_DIR}" ]]; then
        report "${BRAVE_POLICY_DIR} is already writable"
    else
        claim_policy_directory
        report "claimed ${BRAVE_POLICY_DIR}"
    fi

    select_theme "$(active_slug)"
    apply_brave
    report "wrote ${BRAVE_POLICY_FILE}"
    report "restart Brave to arm the policy"
}

main "$@"
