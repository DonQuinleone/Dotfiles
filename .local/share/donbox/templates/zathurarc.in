set font "@zathuraFont@"

set default-bg "@bg@"
set default-fg "@fg@"

set statusbar-bg "@surface@"
set statusbar-fg "@fg@"
set inputbar-bg "@surface@"
set inputbar-fg "@fg@"

set notification-bg "@surface@"
set notification-fg "@fg@"
set notification-error-bg "@bad@"
set notification-error-fg "@onBad@"
set notification-warning-bg "@warn@"
set notification-warning-fg "@onWarn@"

set completion-bg "@surface@"
set completion-fg "@fg@"
set completion-group-bg "@bgAlt@"
set completion-group-fg "@fgDim@"
set completion-highlight-bg "@accent@"
set completion-highlight-fg "@onAccent@"

set index-bg "@bg@"
set index-fg "@fg@"
set index-active-bg "@accent@"
set index-active-fg "@onAccent@"

set highlight-color "@accentSoft@"
set highlight-active-color "@accent@"

set recolor-lightcolor "@bg@"
set recolor-darkcolor "@fg@"
set recolor "false"
