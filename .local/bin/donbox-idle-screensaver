#!/usr/bin/env bash
# donbox:summary=Hand the screen to the screensaver
# donbox:args=<start|stop>
# donbox:hidden=true
set -euo pipefail

readonly SHELL_CONFIG="donbox"

case "${1:-}" in
    start | stop) ;;
    *)
        echo "usage: donbox idle screensaver {start|stop}" >&2
        exit 1
        ;;
esac

# hypridle fires this on every idle edge, including ones where
# the shell has gone away; a missing shell is not an error.
qs -c "${SHELL_CONFIG}" ipc call screensaver "$1" >/dev/null 2>&1 \
    || true
