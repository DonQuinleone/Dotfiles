#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "$0")/.." && pwd)
readonly ROOT
readonly SUITE_DIR="${ROOT}/test/qml.d"
readonly RUNNER=qmltestrunner-qt6

command -v "${RUNNER}" >/dev/null 2>&1 || {
    printf '%s is not installed (qt6-qtdeclarative-devel)\n' \
        "${RUNNER}" >&2
    exit 1
}

# The logic under test draws nothing, so it needs no compositor
# and must not open a window on whoever is running the suite.
QT_QPA_PLATFORM=offscreen exec "${RUNNER}" -input "${SUITE_DIR}"
