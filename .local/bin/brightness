#!/usr/bin/env bash
set -euo pipefail

readonly LOG="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-keys.log"
printf '%s %s %s\n' "$(date +%H:%M:%S)" "${0##*/}" "${1:-}" >> "$LOG"

readonly STEP=5
readonly APP=brightness
readonly STATE="${XDG_RUNTIME_DIR:-/tmp}/brightness-osd"

level() {
    brightnessctl -m | awk -F, '{gsub("%","",$4); print $4}'
}

show() {
    local previous=""
    [ -r "$STATE" ] && previous=$(cat "$STATE")
    local id
    if ! id=$(notify-send -p -a "$APP" -t 1500 -u low \
            ${previous:+-r "$previous"} \
            -h "int:value:$(level)" -i display-brightness \
            "Brightness  $(level)%" 2>&1); then
        printf '  notify-send failed: %s\n' "$id" >> "$LOG"
        return 0
    fi
    printf '%s\n' "$id" > "$STATE"
    printf '  notified id=%s\n' "$id" >> "$LOG"
}

case "${1:-show}" in
    up)   brightnessctl -q set "${STEP}%+"; show ;;
    down) brightnessctl -q set "${STEP}%-"; show ;;
    show) show ;;
    *)
        printf 'usage: %s up|down|show\n' "${0##*/}" >&2
        exit 2
        ;;
esac
