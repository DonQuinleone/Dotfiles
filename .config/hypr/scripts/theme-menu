#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly SCRIPT_DIR
readonly THEME="${SCRIPT_DIR}/theme"
readonly PICK="${SCRIPT_DIR}/pick"
readonly CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly THEME_JSON_DIR="${CONFIG_HOME}/quickshell/themes"
readonly ACTIVE_JSON="${THEME_JSON_DIR}/current.json"
readonly WALLPAPER_ROOT="${HOME}/Pictures/walls"
readonly THEME_PROMPT="Theme"
readonly ACCENT_PROMPT="Accent"
readonly WALLPAPER_PROMPT="Wallpaper"
readonly MARKER_WIDTH=2

declare -rA MODES=(
    [theme]=run_theme_flow
    [accent]=run_accent_flow
)

die() {
    printf 'theme-menu: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        die "$1 is not installed but is required"
}

announce() {
    printf '%s\n' "$1" >&2
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send "${ACCENT_PROMPT}" "$1"
}

preview_command() {
    local rendered
    printf -v rendered '%q %s' "${THEME}" "$1"
    printf '%s\n' "${rendered}"
}

theme_items() {
    local line slug name accent
    while IFS= read -r line; do
        read -r slug name <<<"${line:MARKER_WIDTH}"
        [[ -n "${slug}" ]] || continue
        accent=$(jq -r '.palette.accent // ""' \
            "${THEME_JSON_DIR}/${slug}.json")
        printf '%s\t%s\t%s\t%s\n' \
            "${slug}" "${name:-${slug}}" "${accent}" "${slug}"
    done < <("${THEME}" list)
}

accent_items() {
    local line name hex ratio note
    while IFS= read -r line; do
        read -r name hex ratio note <<<"${line:MARKER_WIDTH}"
        [[ -n "${name}" ]] || continue
        printf '%s\t%s\t%s\t%s contrast%s\n' \
            "${name}" "${name}" "${hex}" \
            "${ratio}" "${note:+, ${note}}"
    done
}

marked_name() {
    awk '/^\*/ { print $2 }'
}

wallpaper_items() {
    find "${WALLPAPER_ROOT}/$1" -maxdepth 1 -type f | sort
}

choose_theme() {
    theme_items |
        "${PICK}" --prompt "${THEME_PROMPT}" --current "$1" \
            --preview-cmd "$(preview_command preview)"
}

choose_accent() {
    printf '%s\n' "$1" | accent_items |
        "${PICK}" --prompt "${ACCENT_PROMPT}" --current "$2" \
            --preview-cmd "$(preview_command preview-accent)"
}

choose_wallpaper() {
    local slug="$1" current
    current=$(jq -r '.wallpaper // ""' "${ACTIVE_JSON}")
    wallpaper_items "${slug}" |
        "${PICK}" --grid --prompt "${WALLPAPER_PROMPT}" \
            --current "${current}"
}

run_theme_flow() {
    local active slug wallpaper
    active=$("${THEME}" current)
    if ! slug=$(choose_theme "${active}"); then
        "${THEME}" preview "${active}"
        return 0
    fi
    "${THEME}" set "${slug}"

    [[ -d "${WALLPAPER_ROOT}/${slug}" ]] || return 0
    wallpaper=$(choose_wallpaper "${slug}") || return 0
    "${THEME}" wallpaper "${wallpaper}"
}

run_accent_flow() {
    local listing active chosen refusal
    listing=$("${THEME}" accent)
    active=$(printf '%s\n' "${listing}" | marked_name)
    if ! chosen=$(choose_accent "${listing}" "${active}"); then
        "${THEME}" preview-accent "${active}"
        return 0
    fi
    if refusal=$("${THEME}" accent "${chosen}" 2>&1 >/dev/null); then
        [[ -z "${refusal}" ]] || announce "${refusal}"
        return 0
    fi
    "${THEME}" preview-accent "${active}"
    announce "${refusal}"
}

main() {
    (($# <= 1)) || die "usage: theme-menu [theme|accent]"
    require_command jq
    [[ -x "${PICK}" ]] || die "${PICK} is missing"

    local handler="${MODES[${1:-theme}]:-}"
    [[ -n "${handler}" ]] || die "unknown mode '${1:-}'"
    "${handler}"
}

main "$@"
