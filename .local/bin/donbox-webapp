#!/usr/bin/env bash
# donbox:summary=Keep a web page as an application of its own
# donbox:args=<install|remove|list> [name] [url] [icon]
set -euo pipefail

BIN_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly BIN_DIR
readonly PICK="${BIN_DIR}/donbox-pick"

readonly BROWSER=brave-origin
readonly DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
readonly STATE_HOME="${XDG_STATE_HOME:-${HOME}/.local/state}"
readonly ENTRY_DIR="${DATA_HOME}/applications"
readonly ICON_DIR="${STATE_HOME}/donbox/webapps"
# The marker is what makes removal safe: only entries this wrote
# are ever offered for deletion.
readonly MARKER=X-Donbox-Webapp
readonly ENTRY_MODE=0644
readonly FAVICON_PATH=/favicon.ico
readonly REMOVE_PROMPT="Remove web app"

die() {
    printf 'donbox webapp: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
usage: donbox webapp install [name] [url] [icon]
       donbox webapp remove [name]
       donbox webapp list
EOF
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        die "$1 is not installed but is required"
}

slug_of() {
    printf '%s' "$1" | tr '[:upper:] ' '[:lower:]-' |
        tr -cd 'a-z0-9-'
}

entry_path() {
    printf '%s/donbox-webapp-%s.desktop\n' "${ENTRY_DIR}" "$1"
}

with_scheme() {
    case "$1" in
    *://*) printf '%s\n' "$1" ;;
    *) printf 'https://%s\n' "$1" ;;
    esac
}

origin_of() {
    printf '%s\n' "$1" | cut -d/ -f1-3
}

# The site's own favicon rather than an icon service, so asking
# for it tells nobody but the site itself.
fetch_icon() {
    local url="$1" slug="$2"
    local target="${ICON_DIR}/${slug}.ico"
    mkdir -p "${ICON_DIR}"
    curl -fsSL --max-time 10 -o "${target}" \
        "$(origin_of "${url}")${FAVICON_PATH}" 2>/dev/null ||
        return 1
    [[ -s "${target}" ]] || return 1
    printf '%s\n' "${target}"
}

copy_icon() {
    local source="$1" slug="$2"
    local target="${ICON_DIR}/${slug}.${source##*.}"
    mkdir -p "${ICON_DIR}"
    case "${source}" in
    http://* | https://*)
        curl -fsSL --max-time 10 -o "${target}" "${source}" ||
            die "could not download ${source}"
        ;;
    *)
        [[ -f "${source}" ]] || die "no such icon: ${source}"
        cp "${source}" "${target}"
        ;;
    esac
    printf '%s\n' "${target}"
}

resolve_icon() {
    local url="$1" slug="$2" wanted="${3-}"
    [[ -z "${wanted}" ]] || {
        copy_icon "${wanted}" "${slug}"
        return
    }
    fetch_icon "${url}" "${slug}" || printf '%s\n' "${BROWSER}"
}

write_entry() {
    local name="$1" url="$2" icon="$3" path="$4"
    cat >"${path}" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=${name}
Comment=${name}
Exec=${BROWSER} --app=${url}
Icon=${icon}
Terminal=false
StartupNotify=true
Categories=Network;
${MARKER}=true
EOF
    chmod "${ENTRY_MODE}" "${path}"
}

ask() {
    local answer
    read -r -p "$1" answer
    printf '%s\n' "${answer}"
}

installed_names() {
    local path
    for path in "${ENTRY_DIR}"/donbox-webapp-*.desktop; do
        [[ -f "${path}" ]] || continue
        grep -q "^${MARKER}=true$" "${path}" || continue
        sed -n 's/^Name=//p' "${path}" | head -n 1
    done
}

cmd_list() {
    (($# == 0)) || usage
    installed_names
}

cmd_install() {
    (($# <= 3)) || usage
    require_command curl
    command -v "${BROWSER}" >/dev/null 2>&1 ||
        die "${BROWSER} is not installed"

    local name="${1-}" url="${2-}" icon="${3-}"
    [[ -n "${name}" ]] || name=$(ask "Name: ")
    [[ -n "${url}" ]] || url=$(ask "URL: ")
    [[ -n "${name}" && -n "${url}" ]] ||
        die "a web app needs a name and a URL"

    url=$(with_scheme "${url}")
    local slug path
    slug=$(slug_of "${name}")
    [[ -n "${slug}" ]] || die "'${name}' leaves no usable file name"
    path=$(entry_path "${slug}")

    mkdir -p "${ENTRY_DIR}"
    write_entry "${name}" "${url}" \
        "$(resolve_icon "${url}" "${slug}" "${icon}")" "${path}"
    printf 'installed %s\n' "${path}"
}

cmd_remove() {
    (($# <= 1)) || usage
    local name="${1-}" status=0
    # Cancelling the chooser and having nothing to choose from
    # both leave empty hands, but only one of them is a mistake
    # worth saying out loud.
    [[ -n "${name}" ]] || {
        [[ -n "$(installed_names)" ]] ||
            die "no web apps are installed"
        name=$(installed_names |
            "${PICK}" --prompt "${REMOVE_PROMPT}") || status=$?
        ((status == 0)) || return 0
    }

    local slug path
    slug=$(slug_of "${name}")
    path=$(entry_path "${slug}")
    [[ -f "${path}" ]] || die "no web app called '${name}'"
    grep -q "^${MARKER}=true$" "${path}" ||
        die "${path} was not installed by donbox"

    rm -f "${path}" "${ICON_DIR}/${slug}".*
    printf 'removed %s\n' "${path}"
}

declare -rA COMMANDS=(
    [install]=cmd_install
    [remove]=cmd_remove
    [list]=cmd_list
)

main() {
    (($# >= 1)) || usage
    local handler="${COMMANDS[$1]:-}"
    [[ -n "${handler}" ]] || usage
    shift
    "${handler}" "$@"
}

main "$@"
