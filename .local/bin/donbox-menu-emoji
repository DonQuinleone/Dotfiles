#!/usr/bin/env bash
# donbox:summary=Copy an emoji, chosen by name
set -euo pipefail

BIN_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
readonly BIN_DIR
readonly PICK="${DONBOX_PICK:-${BIN_DIR}/donbox-pick}"

DATA_FILE="${DONBOX_EMOJI_DATA:-/usr/share/unicode/emoji/emoji-test.txt}"
readonly DATA_FILE
readonly MENU_PROMPT="Emoji"
readonly QUALIFIER="fully-qualified"

die() {
    printf 'donbox menu emoji: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        die "$1 is not installed but is required"
}

# Unicode's own list, in the form it publishes it: the glyph and
# the version sit between the comment mark and the name, so the
# name is whatever survives dropping the first two words.
emoji_rows() {
    awk -F' *; *' -v qualifier="${QUALIFIER}" '
        $2 !~ "^" qualifier { next }
        {
            comment = substr($0, index($0, "# ") + 2)
            split(comment, words, " ")
            glyph = words[1]
            name = substr(comment, index(comment, words[3]))
            printf "%s\t%s %s\n", glyph, glyph, name
        }
    ' "${DATA_FILE}"
}

main() {
    (($# == 0)) || die "usage: donbox menu emoji"
    [[ -r "${DATA_FILE}" ]] ||
        die "${DATA_FILE} is missing; unicode-emoji provides it"
    [[ -x "${PICK}" ]] || die "${PICK} is missing"
    require_command wl-copy

    local chosen
    chosen=$(emoji_rows | "${PICK}" --prompt "${MENU_PROMPT}") ||
        exit 0
    [[ -n "${chosen}" ]] || exit 0
    printf '%s' "${chosen}" | wl-copy
}

main "$@"
