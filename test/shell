#!/usr/bin/env bash
set -uo pipefail

SUITE_DIR=$(cd -- "$(dirname -- "$0")/shell.d" && pwd)
readonly SUITE_DIR
readonly LIBRARY=base-test.sh

failed=()

for suite in "${SUITE_DIR}"/*-test.sh; do
    name=$(basename "${suite}")
    [[ "${name}" == "${LIBRARY}" ]] && continue
    printf '# %s\n' "${name}"
    bash "${suite}" || failed+=("${name}")
done

((${#failed[@]} == 0)) || {
    printf '\nfailed: %s\n' "${failed[*]}" >&2
    exit 1
}

printf '\nall suites passed\n'
