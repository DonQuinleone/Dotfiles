#!/usr/bin/env bash
# Render every themed file from one palette and reload what is
# live.
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

BIN=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
readonly BIN
readonly LIB=${BIN}/../share/theme/lib
readonly CARD_TOOL=${BIN}/theme-card

PICKER_LAYOUT='window { width: 1320px; }'
PICKER_LAYOUT+='listview { columns: 4; lines: 3; spacing: 12px; }'
PICKER_LAYOUT+='element { orientation: vertical; padding: 8px; }'
PICKER_LAYOUT+='element-icon { size: 260px; }'
PICKER_LAYOUT+='element-text { horizontal-align: 0.5; }'
readonly PICKER_LAYOUT

# shellcheck source=../share/theme/lib/paths.sh
source "${LIB}/paths.sh"
# shellcheck source=../share/theme/lib/colour.sh
source "${LIB}/colour.sh"
# shellcheck source=../share/theme/lib/palette.sh
source "${LIB}/palette.sh"
# shellcheck source=../share/theme/lib/render.sh
source "${LIB}/render.sh"
# shellcheck source=../share/theme/lib/browsers.sh
source "${LIB}/browsers.sh"
# shellcheck source=../share/theme/lib/icons.sh
source "${LIB}/icons.sh"
# shellcheck source=../share/theme/lib/appearance.sh
source "${LIB}/appearance.sh"
# shellcheck source=../share/theme/lib/session.sh
source "${LIB}/session.sh"

current() {
    [[ -f $CURRENT ]] || { printf 'none\n'; return; }
    printf '%s\n' "$(<"${CURRENT}")"
}

set_theme() {
    local slug=$1 written
    tokens_for "${slug}"
    mkdir -p "${RENDERED}"
    written=$(render_templates)
    link_rendered

    apply_brave
    apply_firefox
    apply_teamspeak
    apply_icons
    announce_appearance
    publish_gtk_theme

    printf '%s\n' "${slug}" >"${CURRENT}"
    follow_wallpaper
    apply_greeter
    reload_live
    printf 'theme: %s (%d files)\n' "${slug}" "${written}"
}

picker_rows() {
    local slug
    while read -r slug; do
        tokens_for "${slug}"
        printf '%s\0icon\x1f%s\n' "${TOKENS[theme_name]}" \
            "$("${CARD_TOOL}" "${slug}")"
    done < <(slugs)
}

selected_row() {
    local wanted=$1 slug index=0
    while read -r slug; do
        [[ $slug == "${wanted}" ]] && {
            printf '%d\n' "${index}"
            return
        }
        index=$(( index + 1 ))
    done < <(slugs)
    printf '0\n'
}

slug_named() {
    local wanted=$1 slug
    while read -r slug; do
        tokens_for "${slug}"
        [[ ${TOKENS[theme_name]} == "${wanted}" ]] || continue
        printf '%s\n' "${slug}"
        return
    done < <(slugs)
}

pick() {
    local chosen slug
    command -v rofi >/dev/null 2>&1 || die "rofi is not installed"
    chosen=$(picker_rows | rofi -dmenu -i -p Theme -show-icons \
        -selected-row "$(selected_row "$(current)")" \
        -theme-str "${PICKER_LAYOUT}") || return 0
    [[ -n $chosen ]] || return 0
    slug=$(slug_named "${chosen}")
    [[ -n $slug ]] || die "no theme named '${chosen}'"
    set_theme "${slug}"
}

main() {
    case ${1:-list} in
        list) slugs ;;
        current) current ;;
        pick) pick ;;
        set)
            [[ $# -ge 2 ]] || die "set needs a theme name"
            set_theme "$2"
            ;;
        *) die "unknown command '$1' (list, current, set, pick)" ;;
    esac
}

main "$@"
